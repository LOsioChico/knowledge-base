---
/**
 * ArchitectureExplorer.astro
 *
 * Stacked horizontal layers representing an architecture pipeline.
 * Click any layer to expand and see its description + sub-items.
 * Layers are numbered, have flow direction indicators, and feature
 * a polished expanded state with glow effects.
 *
 * Props:
 *   layers – ordered from bottom (infrastructure) to top (application)
 *   title  – optional heading
 *   direction – "down" (default, request flows top-to-bottom) or "up"
 */

interface Layer {
  id: string;
  label: string;
  color?: string;
  description: string;
  items?: string[];
  /** Link target for the layer label */
  href?: string;
}

interface Props {
  layers: Layer[];
  title?: string;
  direction?: "down" | "up";
}

const { layers, title, direction = "down" } = Astro.props;
const circled = ["①", "②", "③", "④", "⑤", "⑥", "⑦", "⑧", "⑨", "⑩"];
---

<div class="ae not-content" data-layers={JSON.stringify(layers)}>
  {title && (
    <div class="ae-header">
      <span class="ae-title">{title}</span>
      <span class="ae-direction">{direction === "down" ? "Request ↓" : "Response ↑"}</span>
    </div>
  )}

  <div class="ae-stack">
    {layers.map((layer, idx) => (
      <div
        class="ae-layer"
        data-layer={layer.id}
        style={layer.color ? `--ae-layer-color: ${layer.color}` : ""}
      >
        <div class="ae-layer-bar">
          <div class="ae-layer-left">
            <span class="ae-layer-num">{circled[idx] || idx + 1}</span>
            {layer.href ? (
              <a class="ae-layer-label ae-layer-link" href={layer.href}>{layer.label}</a>
            ) : (
              <span class="ae-layer-label">{layer.label}</span>
            )}
          </div>
          <svg class="ae-layer-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6l4 4 4-4" />
          </svg>
        </div>
        <div class="ae-layer-detail">
          <p class="ae-layer-desc">{layer.description}</p>
          {layer.items && layer.items.length > 0 && (
            <div class="ae-layer-items">
              {layer.items.map((item) => (
                <span class="ae-layer-item">{item}</span>
              ))}
            </div>
          )}
        </div>
        {idx < layers.length - 1 && (
          <div class="ae-flow-arrow">{direction === "down" ? "↓" : "↑"}</div>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .ae {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ae-text:       var(--sl-color-text);
    --ae-text-faint: var(--sl-color-gray-3);
    --ae-text-ghost: var(--sl-color-gray-4);
    --ae-rule:       var(--sl-color-hairline-shade);
    --ae-accent:     var(--sl-color-accent-high);
    --ae-accent-low: var(--sl-color-accent-low);
    --ae-panel:      var(--sl-color-bg-nav);
    margin: 1.5rem 0;
    background: var(--ae-panel);
    border: 1px solid var(--ae-rule);
    border-radius: 10px;
    overflow: hidden;
  }

  .ae-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--ae-rule);
  }

  .ae-title {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--ae-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ae-direction {
    font-size: 11px;
    color: var(--ae-text-ghost);
    font-style: italic;
  }

  /* ═══ LAYER STACK ═══ */
  .ae-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ae-layer {
    --ae-layer-color: var(--ae-accent);
    position: relative;
    border-bottom: 1px solid var(--ae-rule);
    transition: opacity 200ms var(--ease-out);
    cursor: pointer;
  }

  .ae-layer:last-child { border-bottom: none; }

  /* When any layer is expanded, dim the others */
  .ae-stack.has-focus .ae-layer:not(.is-expanded) {
    opacity: 0.4;
  }

  .ae-stack.has-focus .ae-layer:not(.is-expanded):hover {
    opacity: 0.7;
  }

  /* ── Bar (always visible) ── */
  .ae-layer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-left: 3px solid var(--ae-layer-color);
    transition: background 160ms var(--ease-out), border-left-width 200ms var(--ease-out);
  }

  .ae-layer:hover .ae-layer-bar {
    background: rgba(255, 255, 255, 0.02);
  }

  .ae-layer.is-expanded .ae-layer-bar {
    background: rgba(255, 255, 255, 0.03);
    border-left-width: 4px;
    box-shadow: inset 4px 0 12px -4px color-mix(in srgb, var(--ae-layer-color) 20%, transparent);
  }

  .ae-layer-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ae-layer-num {
    font-size: var(--sl-text-sm);
    color: var(--ae-layer-color);
    opacity: 0.6;
    flex-shrink: 0;
    width: 18px;
    text-align: center;
  }

  .ae-layer.is-expanded .ae-layer-num {
    opacity: 1;
  }

  .ae-layer-label {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--ae-text);
    transition: color 160ms var(--ease-out);
  }

  .ae-layer.is-expanded .ae-layer-label {
    color: var(--ae-layer-color);
  }

  a.ae-layer-link {
    text-decoration: none;
    cursor: pointer;
  }

  a.ae-layer-link::after {
    content: " →";
    font-size: 1em;
    opacity: 0.5;
    margin-left: 4px;
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
    display: inline-block;
  }

  a.ae-layer-link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  a.ae-layer-link:hover::after {
    opacity: 1;
    transform: translateX(3px);
  }

  .ae-layer-chevron {
    width: 14px;
    height: 14px;
    color: var(--ae-text-ghost);
    transition: transform 200ms var(--ease-out), color 200ms var(--ease-out);
    flex-shrink: 0;
  }

  .ae-layer.is-expanded .ae-layer-chevron {
    transform: rotate(180deg);
    color: var(--ae-layer-color);
  }

  /* ── Detail panel (collapsed by default) ── */
  .ae-layer-detail {
    max-height: 0;
    overflow: hidden;
    transition: max-height 300ms var(--ease-out);
    padding: 0 20px 0 51px; /* 20px + 3px border + 10px gap + 18px badge */
  }

  .ae-layer.is-expanded .ae-layer-detail {
    max-height: 300px;
    padding-bottom: 14px;
  }

  .ae-layer-desc {
    font-size: var(--sl-text-sm);
    color: var(--ae-text-faint);
    line-height: 1.6;
    margin: 8px 0 0;
  }

  .ae-layer-items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .ae-layer-item {
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-size: 11px;
    color: var(--ae-layer-color);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid color-mix(in srgb, var(--ae-layer-color) 30%, transparent);
    padding: 2px 8px;
    border-radius: 4px;
    transition: background 160ms var(--ease-out);
  }

  .ae-layer.is-expanded .ae-layer-item {
    background: color-mix(in srgb, var(--ae-layer-color) 8%, transparent);
  }

  /* ── Flow arrow between layers ── */
  .ae-flow-arrow {
    position: absolute;
    left: 30px;
    bottom: -8px;
    font-size: 10px;
    color: var(--ae-text-ghost);
    z-index: 1;
    opacity: 0.5;
  }

  /* ═══ REDUCED MOTION & PRINT ═══ */
  @media (prefers-reduced-motion: reduce) {
    .ae-layer, .ae-layer-detail, .ae-layer-chevron, .ae-layer-bar {
      transition-duration: 0.01ms !important;
    }
  }

  @media print {
    .ae-layer-detail { max-height: none !important; padding-bottom: 14px !important; }
    .ae-layer { opacity: 1 !important; }
    .ae-layer-chevron { display: none; }
    .ae-flow-arrow { display: none; }
  }
</style>

<script>
  function initArchExplorer() {
    document.querySelectorAll<HTMLElement>(".ae:not([data-init])").forEach((comp) => {
      comp.setAttribute("data-init", "");

      const stack = comp.querySelector<HTMLElement>(".ae-stack")!;
      const layers = comp.querySelectorAll<HTMLElement>(".ae-layer");

      layers.forEach((layer) => {
        layer.addEventListener("click", () => {
          const wasExpanded = layer.classList.contains("is-expanded");

          /* Close all */
          layers.forEach((l) => l.classList.remove("is-expanded"));

          if (!wasExpanded) {
            /* Expand this one */
            layer.classList.add("is-expanded");
            stack.classList.add("has-focus");

            /* Smooth scroll to center expanded layer */
            setTimeout(() => {
              layer.scrollIntoView({ behavior: "smooth", block: "nearest" });
            }, 100);
          } else {
            stack.classList.remove("has-focus");
          }
        });
      });

      /* Keyboard */
      comp.setAttribute("tabindex", "0");
      comp.addEventListener("keydown", (e) => {
        const expanded = comp.querySelector<HTMLElement>(".ae-layer.is-expanded");
        const layerArr = Array.from(layers);
        const idx = expanded ? layerArr.indexOf(expanded) : -1;

        if (e.key === "ArrowDown") {
          e.preventDefault();
          const next = idx < layerArr.length - 1 ? idx + 1 : 0;
          layerArr.forEach((l) => l.classList.remove("is-expanded"));
          layerArr[next].classList.add("is-expanded");
          stack.classList.add("has-focus");
          layerArr[next].scrollIntoView({ behavior: "smooth", block: "nearest" });
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          const prev = idx > 0 ? idx - 1 : layerArr.length - 1;
          layerArr.forEach((l) => l.classList.remove("is-expanded"));
          layerArr[prev].classList.add("is-expanded");
          stack.classList.add("has-focus");
          layerArr[prev].scrollIntoView({ behavior: "smooth", block: "nearest" });
        } else if (e.key === "Escape") {
          layerArr.forEach((l) => l.classList.remove("is-expanded"));
          stack.classList.remove("has-focus");
        }
      });
    });
  }

  initArchExplorer();
  document.addEventListener("astro:page-load", initArchExplorer);
</script>
