---
/**
 * ArchitectureExplorer.astro
 * ──────────────────────────
 * Premium stacked horizontal layers representing architectural structures.
 * Click any layer to expand and see its description + sub-items.
 * Features ultra-smooth CSS Grid auto-height transitions, customizable flow arrows,
 * glowing numeric badges, and a matching glassmorphic design system.
 *
 * Props:
 *   layers    – ordered list of layers
 *   title     – optional heading
 *   direction – "down" (default, request flows top-to-bottom) or "up"
 */

interface Layer {
  id: string;
  label: string;
  color?: string;
  description: string;
  items?: string[];
  href?: string;
}

interface Props {
  layers: Layer[];
  title?: string;
  direction?: "down" | "up";
  badge?: string;
}

const { layers, title, direction = "down", badge } = Astro.props;
---

<div class="ae not-content" data-layers={JSON.stringify(layers)}>
  {title && (
    <div class="ae-header">
      <span class="ae-title">{title}</span>
      <span class="ae-badge">⬡ {badge || (direction === "down" ? "Request Flow ↓" : "Response Flow ↑")}</span>
    </div>
  )}

  <div class="ae-stack">
    {layers.map((layer, idx) => (
      <div
        class="ae-layer"
        data-layer={layer.id}
        style={layer.color ? `--ae-layer-color: ${layer.color}` : ""}
      >
        <div class="ae-layer-bar">
          <div class="ae-layer-left">
            <span class="ae-layer-num-badge">
              {idx + 1}
            </span>
            {layer.href ? (
              <a class="ae-layer-label ae-layer-link" href={layer.href}>{layer.label}</a>
            ) : (
              <span class="ae-layer-label">{layer.label}</span>
            )}
          </div>
          <svg class="ae-layer-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        
        <div class="ae-layer-detail">
          <div class="ae-layer-detail-inner">
            <p class="ae-layer-desc">{layer.description}</p>
            {layer.items && layer.items.length > 0 && (
              <div class="ae-layer-items">
                {layer.items.map((item) => (
                  <span class="ae-layer-item">{item}</span>
                ))}
              </div>
            )}
          </div>
        </div>

      </div>
    ))}
  </div>
</div>

<style is:global>
  .ae {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ae-text:       var(--sl-color-text);
    --ae-text-faint: var(--sl-color-gray-3);
    --ae-text-ghost: var(--sl-color-gray-4);
    --ae-rule:       var(--sl-color-hairline-shade);
    --ae-accent:     var(--sl-color-accent-high);
    --ae-panel:      rgba(20, 20, 23, 0.4);
    
    margin: 2rem 0;
    background: var(--ae-panel);
    border: 1px solid var(--ae-rule);
    border-radius: 16px;
    overflow: hidden;
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .ae-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--ae-rule);
    background: rgba(10, 10, 12, 0.5);
  }

  .ae-title {
    font-size: var(--sl-text-xs);
    font-weight: 700;
    color: var(--ae-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .ae-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ae-accent);
    background: color-mix(in srgb, var(--ae-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--ae-accent) 25%, transparent);
    padding: 0.25rem 0.65rem;
    border-radius: 99px;
  }

  /* ═══ LAYER STACK ═══ */
  .ae-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ae-layer {
    --ae-layer-color: var(--ae-accent);
    position: relative;
    border-bottom: 1px solid var(--ae-rule);
    transition: opacity 200ms var(--ease-out);
    cursor: pointer;
  }

  .ae-layer:last-child { 
    border-bottom: none; 
  }

  /* When any layer is expanded, dim the others slightly for premium focus */
  .ae-stack.has-focus .ae-layer:not(.is-expanded) {
    opacity: 0.45;
  }

  .ae-stack.has-focus .ae-layer:not(.is-expanded):hover {
    opacity: 0.75;
  }

  /* ── Bar (always visible) ── */
  .ae-layer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-left: 3px solid var(--ae-layer-color);
    transition: background 160ms var(--ease-out), border-left-width 200ms var(--ease-out);
  }

  .ae-layer:hover .ae-layer-bar {
    background: rgba(255, 255, 255, 0.03);
  }

  .ae-layer.is-expanded .ae-layer-bar {
    background: rgba(255, 255, 255, 0.04);
    border-left-width: 5px;
    box-shadow: inset 4px 0 16px -6px color-mix(in srgb, var(--ae-layer-color) 25%, transparent);
  }

  .ae-layer-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Glowing numeric badge */
  .ae-layer-num-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--ae-layer-color);
    background: color-mix(in srgb, var(--ae-layer-color) 10%, rgba(255, 255, 255, 0.02));
    border: 1px solid color-mix(in srgb, var(--ae-layer-color) 30%, rgba(255, 255, 255, 0.05));
    box-shadow: 0 0 8px color-mix(in srgb, var(--ae-layer-color) 12%, transparent);
    transition: background 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    flex-shrink: 0;
  }

  .ae-layer.is-expanded .ae-layer-num-badge {
    background: var(--ae-layer-color);
    color: rgba(10, 10, 12, 0.95);
    border-color: var(--ae-layer-color);
    box-shadow: 0 0 12px color-mix(in srgb, var(--ae-layer-color) 40%, transparent);
    transform: scale(1.05);
  }

  .ae-layer-label {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--ae-text);
    transition: color 160ms var(--ease-out), transform 160ms var(--ease-out);
  }

  .ae-layer.is-expanded .ae-layer-label {
    color: var(--ae-layer-color);
    transform: translateX(2px);
  }

  a.ae-layer-link {
    text-decoration: none;
    cursor: pointer;
  }

  a.ae-layer-link::after {
    content: " →";
    font-size: 1em;
    opacity: 0.5;
    margin-left: 4px;
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
    display: inline-block;
  }

  a.ae-layer-link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  a.ae-layer-link:hover::after {
    opacity: 1;
    transform: translateX(3px);
  }

  .ae-layer-chevron {
    width: 14px;
    height: 14px;
    color: var(--ae-text-ghost);
    transition: transform 220ms var(--ease-out), color 200ms var(--ease-out);
    flex-shrink: 0;
  }

  .ae-layer.is-expanded .ae-layer-chevron {
    transform: rotate(180deg);
    color: var(--ae-layer-color);
  }

  /* ── Detail Panel (Auto-height transition using CSS Grid) ── */
  .ae-layer-detail {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 250ms var(--ease-out), opacity 200ms ease;
    opacity: 0;
    overflow: hidden;
  }

  .ae-layer.is-expanded .ae-layer-detail {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .ae-layer-detail-inner {
    min-height: 0;
    padding: 4px 20px 16px 54px; /* Align description text with label */
  }

  .ae-layer-desc {
    font-size: var(--sl-text-sm);
    color: var(--ae-text-faint);
    line-height: 1.6;
    margin: 0;
  }

  .ae-layer-items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .ae-layer-item {
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-size: 11px;
    color: var(--ae-layer-color);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid color-mix(in srgb, var(--ae-layer-color) 20%, transparent);
    padding: 2px 8px;
    border-radius: 6px;
    transition: background 160ms var(--ease-out);
  }

  .ae-layer.is-expanded .ae-layer-item {
    background: color-mix(in srgb, var(--ae-layer-color) 8%, transparent);
  }

  /* ═══ REDUCED MOTION & PRINT ═══ */
  @media (prefers-reduced-motion: reduce) {
    .ae-layer, .ae-layer-detail, .ae-layer-chevron, .ae-layer-bar {
      transition-duration: 0.01ms !important;
    }
  }

  @media print {
    .ae-layer-detail { grid-template-rows: 1fr !important; opacity: 1 !important; }
    .ae-layer-detail-inner { padding-bottom: 16px !important; }
    .ae-layer { opacity: 1 !important; }
    .ae-layer-chevron { display: none; }
  }
</style>

<script>
  function initArchExplorer() {
    document.querySelectorAll<HTMLElement>(".ae:not([data-init])").forEach((comp) => {
      comp.setAttribute("data-init", "");

      const stack = comp.querySelector<HTMLElement>(".ae-stack")!;
      const layers = comp.querySelectorAll<HTMLElement>(".ae-layer");

      layers.forEach((layer) => {
        layer.addEventListener("click", () => {
          const wasExpanded = layer.classList.contains("is-expanded");

          /* Close all */
          layers.forEach((l) => l.classList.remove("is-expanded"));

          if (!wasExpanded) {
            /* Expand this one */
            layer.classList.add("is-expanded");
            stack.classList.add("has-focus");

            /* Smooth scroll to center expanded layer */
            setTimeout(() => {
              layer.scrollIntoView({ behavior: "smooth", block: "nearest" });
            }, 100);
          } else {
            stack.classList.remove("has-focus");
          }
        });
      });

      /* Keyboard */
      comp.setAttribute("tabindex", "0");
      comp.addEventListener("keydown", (e) => {
        const expanded = comp.querySelector<HTMLElement>(".ae-layer.is-expanded");
        const layerArr = Array.from(layers);
        const idx = expanded ? layerArr.indexOf(expanded) : -1;

        if (e.key === "ArrowDown") {
          e.preventDefault();
          const next = idx < layerArr.length - 1 ? idx + 1 : 0;
          layerArr.forEach((l) => l.classList.remove("is-expanded"));
          layerArr[next].classList.add("is-expanded");
          stack.classList.add("has-focus");
          layerArr[next].scrollIntoView({ behavior: "smooth", block: "nearest" });
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          const prev = idx > 0 ? idx - 1 : layerArr.length - 1;
          layerArr.forEach((l) => l.classList.remove("is-expanded"));
          layerArr[prev].classList.add("is-expanded");
          stack.classList.add("has-focus");
          layerArr[prev].scrollIntoView({ behavior: "smooth", block: "nearest" });
        } else if (e.key === "Escape") {
          layerArr.forEach((l) => l.classList.remove("is-expanded"));
          stack.classList.remove("has-focus");
        }
      });
    });
  }

  initArchExplorer();
  document.addEventListener("astro:page-load", initArchExplorer);
</script>
