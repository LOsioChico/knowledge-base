  }

  .packet-write     { background: #fff; box-shadow: 0 0 8px #fff, 0 0 14px var(--sim-accent); }
  .packet-read      { background: #fff; box-shadow: 0 0 8px #fff, 0 0 14px var(--sim-blue); }
  .packet-replicate { background: #fff; box-shadow: 0 0 8px #fff, 0 0 14px var(--sim-amber); }
  .packet-ack       { background: var(--sim-green); box-shadow: 0 0 8px var(--sim-green); }
  .packet-error     { background: var(--sim-red); box-shadow: 0 0 8px var(--sim-red); }

  /* Exploding burst rings on partition contact */
  .packet-burst {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 2px solid var(--sim-red);
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0.2);
    opacity: 1;
    z-index: 160;
    pointer-events: none;
    animation: burst-disappear 0.4s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
  }

  @keyframes burst-disappear {
    to {
      transform: translate(-50%, -50%) scale(1.6);
      opacity: 0;
      border-color: transparent;
    }
  }

  /* ═══ AP CONFLICT RESOLUTION OVERLAY MODAL ═══ */
  .conflict-panel-overlay {
