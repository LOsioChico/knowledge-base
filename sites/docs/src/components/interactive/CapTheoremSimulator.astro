  .client-readout.val-red    { color: #ff8b8b; }
  .client-readout.val-blue   { color: #8bbbff; }
  .client-readout.val-amber  { color: #ffd58b; }
  .client-readout.val-green  { color: #8bffb8; }
  .client-readout.val-error  { color: var(--sim-red); border-color: rgba(239, 68, 68, 0.3); }

  /* ═══ VISUAL MSG PACKET DESIGN ═══ */
  .msg-packet {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    z-index: 150;
