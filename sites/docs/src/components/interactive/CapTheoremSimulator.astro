---
/**
 * CapTheoremSimulator.astro
 *
 * An elite, highly visual interactive simulator explaining the CAP Theorem.
 * Simulates symmetric key-value databases (London & New York) with key `x`.
 * Features real-time animated message packets, CP/AP modes, and network partitions.
 * Demonstrates CAP trade-offs, linearizable consistency failures, eventual consistency
 * stale reads, and interactive conflict resolution (Last-Write-Wins vs Multi-Value siblings).
 */

interface Props {
  title?: string;
}

const { title = "CAP Theorem Simulator" } = Astro.props;
---

<div class="cap-sim not-content" id="cap-simulator-root">
  {/* HEADER ROW: Title & pill controls */}
  <div class="cap-sim-header">
    <div class="header-main">
      <div class="cap-sim-title-group">
        <div class="cap-sim-title">⚡ {title}</div>
        <div class="tour-status-badge hidden" id="tour-active-badge">Tour Active</div>
      </div>
      
      <div class="cap-sim-actions">
        {/* CP/AP Mode Segmented Pill */}
        <div class="mode-selector" id="mode-selector-pill">
          <button class="mode-btn active" data-mode="CP" id="toggle-cp-btn" title="Consistency + Partition Tolerance (Strong Consistency)">
            🔒 CP Mode
          </button>
          <button class="mode-btn" data-mode="AP" id="toggle-ap-btn" title="Availability + Partition Tolerance (Eventual Consistency)">
            ⚡ AP Mode
          </button>
        </div>

        {/* Tour Menu Trigger */}
        <div class="tour-menu-wrap">
          <button class="tour-menu-btn" id="tour-menu-trigger">
            🎓 Start Tour
          </button>
          <div class="tour-dropdown hidden" id="tour-dropdown-menu">
            <button class="tour-opt" id="tour-ap-btn">⚡ AP Tour (Eventual / Stale Reads)</button>
            <button class="tour-opt" id="tour-cp-btn">🔒 CP Tour (Strict Consensus / Outage)</button>
          </div>
        </div>

        {/* Fullscreen Toggle */}
        <button class="cap-sim-expand-btn" id="cap-sim-expand-btn" title="Expand to fullscreen">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 5V1h4M9 1h4v4M13 9v4H9M5 13H1V9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* INTERACTIVE DIRECT CONTROL VISUALIZER */}
  <div class="cap-sim-container">
    <div class="cap-sim-visualizer">
      <div class="vis-bg-lines"></div>

      <div class="vis-canvas" id="vis-canvas">
        {/* Clickable Connection Link (Direct cut/heal toggle) */}
        <div class="vis-link" id="network-link">
          <div class="vis-link-line"></div>
          <div class="vis-link-particles" id="link-particles">
            <div class="particle"></div>
            <div class="particle delay-1"></div>
            <div class="particle delay-2"></div>
          </div>
          
          <button class="network-trigger-btn" id="network-trigger-btn" title="Click to partition network">
            <span class="trigger-indicator">🟢</span>
            <span class="trigger-label">Healthy</span>
          </button>
        </div>

        {/* London Node A (Cylinder) */}
        <div class="vis-node node-a status-sync" id="node-a">
          <div class="cylinder-top"></div>
          <div class="node-indicator"></div>
          <div class="node-tag">LONDON (Node A)</div>
          <div class="node-icon-db">🗄️</div>
          <div class="node-register-container">
            <div class="node-register-label">REGISTER</div>
            <div class="node-register-val">
              <span class="register-pill val-green" id="val-pill-a">x = "Green"</span>
            </div>
          </div>
        </div>

        {/* Action Controls Node A */}
        <div class="direct-action node-a-action">
          <div class="write-swatches">
            <span class="swatch-label">Write x =</span>
            <button class="swatch-btn swatch-red" data-val="Red" data-node="A" title="Write 'Red' to Node A">🔴</button>
            <button class="swatch-btn swatch-blue" data-val="Blue" data-node="A" title="Write 'Blue' to Node A">🔵</button>
            <button class="swatch-btn swatch-amber" data-val="Amber" data-node="A" title="Write 'Amber' to Node A">🟡</button>
          </div>
          <button class="node-action-btn btn-read" data-node="A" id="btn-read-a">
            🔍 Read Local
          </button>
        </div>

        {/* New York Node B (Cylinder) */}
        <div class="vis-node node-b status-sync" id="node-b">
          <div class="cylinder-top"></div>
          <div class="node-indicator"></div>
          <div class="node-tag">NEW YORK (Node B)</div>
          <div class="node-icon-db">🗄️</div>
          <div class="node-register-container">
            <div class="node-register-label">REGISTER</div>
            <div class="node-register-val">
              <span class="register-pill val-green" id="val-pill-b">x = "Green"</span>
            </div>
          </div>
        </div>

        {/* Action Controls Node B */}
        <div class="direct-action node-b-action">
          <div class="write-swatches">
            <span class="swatch-label">Write x =</span>
            <button class="swatch-btn swatch-red" data-val="Red" data-node="B" title="Write 'Red' to Node B">🔴</button>
            <button class="swatch-btn swatch-blue" data-val="Blue" data-node="B" title="Write 'Blue' to Node B">🔵</button>
            <button class="swatch-btn swatch-amber" data-val="Amber" data-node="B" title="Write 'Amber' to Node B">🟡</button>
          </div>
          <button class="node-action-btn btn-read" data-node="B" id="btn-read-b">
            🔍 Read Local
          </button>
        </div>

        {/* Clients positioned safely at boundaries */}
        <div class="vis-client client-a" id="client-a">
          <div class="client-icon">👤</div>
          <div class="client-label">Client A</div>
          <div class="client-readout hidden" id="readout-a">x = ?</div>
        </div>

        <div class="vis-client client-b" id="client-b">
          <div class="client-icon">👤</div>
          <div class="client-label">Client B</div>
          <div class="client-readout hidden" id="readout-b">x = ?</div>
        </div>

        {/* INTERACTIVE AP CONFLICT RESOLUTION MODAL PANEL */}
        <div class="conflict-panel-overlay hidden" id="conflict-resolution-panel">
          <div class="conflict-panel-card">
            <div class="conflict-panel-header">
              <span class="conflict-warning-icon">⚠️</span>
              <div class="conflict-header-text">
                <div class="conflict-title">Split-Brain Conflict Detected!</div>
                <div class="conflict-subtitle">Replicas diverged during partition. Reconcile states below:</div>
              </div>
            </div>
            
            <div class="conflict-data-preview">
              <div class="preview-item">
                <span class="preview-loc">London (A)</span>
                <span class="preview-badge" id="conflict-badge-a">Red</span>
              </div>
              <div class="preview-arrow">⚡</div>
              <div class="preview-item">
                <span class="preview-loc">New York (B)</span>
                <span class="preview-badge" id="conflict-badge-b">Blue</span>
              </div>
            </div>

            <div class="conflict-options">
              <button class="conflict-opt-btn" id="btn-resolve-lww">
                <div class="opt-title">⏱️ Last-Write-Wins (LWW)</div>
                <div class="opt-desc">Resolves by client timestamp. Newer write wins, discarding the older write entirely. **Result: Data Loss.**</div>
              </button>
              <button class="conflict-opt-btn" id="btn-resolve-multi">
                <div class="opt-title">🧬 Multi-Value (Siblings)</div>
                <div class="opt-desc" id="resolve-multi-desc">Returns both values to the client. User must click on a replica to select the winner manually.</div>
              </button>
            </div>
          </div>
        </div>

        {/* CLICKABLE MULTI-VALUE RESOLUTION HUD */}
        <div class="resolution-hud hidden" id="resolution-hud">
          <div class="hud-inner">
            👉 <strong class="pulse-text">Conflict Resolution Active:</strong> Click directly on London Node A or NY Node B cylinder to select its value as the winner!
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* ACTIVE TOUR INSTRUCTION CARD (Slides up during guided tours) */}
  <div class="tutorial-steps-container hidden" id="tutorial-steps-box">
    <div class="tutorial-step-header">
      <span id="tutorial-tour-name">AP Tour</span>
      <span id="tutorial-step-counter">Step 1 of 6</span>
    </div>
    <div class="tutorial-step-content" id="tutorial-step-text">
      Tour step content...
    </div>
    <div class="tutorial-actions-row">
      <div class="tutorial-progress">
        <div class="tutorial-progress-bar" id="tutorial-progress-bar"></div>
      </div>
      <button class="tutorial-quit-btn" id="tutorial-quit-btn">✕ Quit Tour</button>
    </div>
  </div>

  {/* COMPACT DASHBOARD STATUS BAR */}
  <div class="cap-sim-status-bar">
    <div class="status-indicators">
      <div class="status-indicator" id="status-consistency">
        <span class="status-dot dot-strong"></span>
        <span class="status-label">Consistency: Strong</span>
      </div>
      <div class="status-indicator" id="status-availability">
        <span class="status-dot dot-online"></span>
        <span class="status-label">Availability: Online</span>
      </div>
      <div class="status-indicator" id="status-sync">
        <span class="status-dot dot-normal"></span>
        <span class="status-label">Sync: Healthy</span>
      </div>
    </div>
    <div class="status-message" id="status-msg-text">
      System is initialized. Key x = "Green" is replicated across both replicas.
    </div>
  </div>
</div>

<style is:global>
  /* ═══ GLOBAL UTILITY ═══ */
  .hidden {
    display: none !important;
  }

  .cap-sim {
    --ease-out: cubic-bezier(0.25, 0.8, 0.25, 1);
    --sim-text:       var(--sl-color-text);
    --sim-text-mid:   var(--sl-color-gray-2);
    --sim-text-faint: var(--sl-color-gray-3);
    --sim-text-ghost: var(--sl-color-gray-4);
    --sim-rule:       var(--sl-color-hairline-shade);
    --sim-accent:     var(--sl-color-accent-high);
    --sim-accent-low: var(--sl-color-accent-low);
    --sim-panel:      var(--sl-color-bg-nav);
    
    --sim-red:        #ef4444;
    --sim-red-dim:    rgba(239, 68, 68, 0.15);
    --sim-red-glow:   rgba(239, 68, 68, 0.45);
    
    --sim-green:      #10b981;
    --sim-green-dim:  rgba(16, 185, 129, 0.15);
    --sim-green-glow: rgba(16, 185, 129, 0.45);
    
    --sim-amber:     #f59e0b;
    --sim-amber-dim: rgba(245, 158, 11, 0.15);
    --sim-amber-glow: rgba(245, 158, 11, 0.45);

    --sim-blue:       #3b82f6;
    --sim-blue-dim:   rgba(59, 130, 246, 0.15);
    --sim-blue-glow:  rgba(59, 130, 246, 0.45);
    
    margin: 1.5rem 0;
    background: var(--sim-panel);
    border: 1px solid var(--sim-rule);
    border-radius: 12px;
    overflow: hidden;
    color: var(--sim-text);
    font-family: var(--sl-font-system, sans-serif);
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    position: relative;
  }

  /* ═══ HEADER ROW ═══ */
  .cap-sim-header {
    padding: 12px 16px;
    border-bottom: 1px solid var(--sim-rule);
    background: linear-gradient(180deg, rgba(255,255,255,0.015) 0%, transparent 100%);
  }

  .header-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cap-sim-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cap-sim-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--sim-text);
    letter-spacing: -0.01em;
  }

  .tour-status-badge {
    font-size: 0.58rem;
    font-weight: 800;
    color: #fff;
    background: var(--sim-amber);
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    animation: cap-pulse-soft 2s infinite ease-in-out;
  }

  .cap-sim-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* CP/AP Toggle Switch */
  .mode-selector {
    display: flex;
    background: rgba(0,0,0,0.25);
    border: 1px solid var(--sim-rule);
    padding: 2px;
    border-radius: 6px;
  }

  .mode-btn {
    font-size: 0.72rem;
    font-weight: 600;
    background: transparent;
    border: none;
    padding: 4px 10px;
    border-radius: 4px;
    color: var(--sim-text-mid);
    cursor: pointer;
    transition: all 0.2s var(--ease-out);
  }

  .mode-btn:hover {
    color: var(--sim-text);
  }

  .mode-btn.active {
    background: var(--sim-accent);
    color: #fff;
    box-shadow: 0 1px 4px rgba(0,0,0,0.15);
  }

  /* Tour dropdown */
  .tour-menu-wrap {
    position: relative;
  }

  .tour-menu-btn {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--sim-text);
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--sim-rule);
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s var(--ease-out);
  }

  .tour-menu-btn:hover {
    background: rgba(255,255,255,0.1);
  }

  .tour-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 6px;
    background: rgba(30, 30, 35, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid var(--sim-rule);
    border-radius: 8px;
    padding: 4px;
    width: 230px;
    z-index: 100;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
  }

  .tour-opt {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 8px 12px;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--sim-text-mid);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s var(--ease-out);
  }

  .tour-opt:hover {
    background: rgba(255,255,255,0.08);
    color: var(--sim-text);
  }

  .cap-sim-expand-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--sim-rule);
    color: var(--sim-text-mid);
    padding: 6px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s var(--ease-out);
  }

  .cap-sim-expand-btn:hover {
    background: rgba(255,255,255,0.1);
    color: var(--sim-text);
  }

  /* ═══ INTERACTIVE CONTAINER ═══ */
  .cap-sim-container {
    padding: 16px;
    background: rgba(0,0,0,0.12);
  }

  .cap-sim-visualizer {
    background: rgba(10,10,12,0.6);
    border: 1px solid var(--sim-rule);
    border-radius: 8px;
    height: 320px;
    position: relative;
    overflow: hidden;
  }

  .vis-bg-lines {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
      linear-gradient(rgba(255,255,255,0.003) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .vis-canvas {
    width: 100%;
    height: 100%;
    position: relative;
  }

  /* ═══ DIRECT NETWORK LINK ═══ */
  .vis-link {
    position: absolute;
    top: 50%;
    left: 200px;
    right: 200px;
    height: 2px;
    transform: translateY(-50%);
    z-index: 10;
  }

  .vis-link-line {
    width: 100%;
    height: 100%;
    background: var(--sim-green);
    box-shadow: 0 0 8px var(--sim-green-glow);
    transition: all 0.4s var(--ease-out);
    position: relative;
  }

  .vis-link.partitioned .vis-link-line {
    background: transparent;
    box-shadow: none;
  }

  .vis-link.partitioned .vis-link-line::before,
  .vis-link.partitioned .vis-link-line::after {
    content: '';
    position: absolute;
    top: 0;
    width: calc(50% - 20px);
    height: 100%;
    background: var(--sim-red);
    box-shadow: 0 0 6px var(--sim-red-glow);
  }

  .vis-link.partitioned .vis-link-line::before {
    left: 0;
  }
  .vis-link.partitioned .vis-link-line::after {
    right: 0;
  }

  /* Particle pulses running along connection */
  .vis-link-particles {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .particle {
    position: absolute;
    top: -3px;
    width: 8px;
    height: 8px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 8px #fff, 0 0 15px var(--sim-green);
    animation: particle-run 3s infinite linear;
  }

  .particle.delay-1 { animation-delay: 1s; }
  .particle.delay-2 { animation-delay: 2s; }

  .vis-link.partitioned .vis-link-particles {
    display: none;
  }

  @keyframes particle-run {
    0% { left: 0%; opacity: 0; }
    5% { opacity: 1; }
    95% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  /* Dynamic cut/heal link badge trigger */
  .network-trigger-btn {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: rgba(30, 30, 35, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid var(--sim-rule);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--sim-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    z-index: 100;
    transition: all 0.2s var(--ease-out);
    white-space: nowrap;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  }

  .network-trigger-btn:hover {
    border-color: var(--sim-text-mid);
    background: rgba(45, 45, 50, 0.95);
    transform: translate(-50%, -52%) scale(1.05);
  }

  .vis-link.partitioned .network-trigger-btn {
    border-color: var(--sim-red);
    box-shadow: 0 0 12px var(--sim-red-glow);
  }

  /* ═══ GLASSMORPHIC DATABASE CYLINDERS ═══ */
  .vis-node {
    position: absolute;
    top: 50%;
    width: 100px;
    height: 140px;
    transform: translateY(-50%);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(4px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 15px;
    transition: all 0.4s var(--ease-out);
    box-shadow: inset 0 20px 30px rgba(255,255,255,0.02);
  }

  .vis-node.node-a { left: 100px; }
  .vis-node.node-b { right: 100px; }

  /* 3D Cylinder top cap overlay */
  .cylinder-top {
    position: absolute;
    top: -6px;
    left: -1px;
    right: -1px;
    height: 12px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 50% / 50%;
    box-shadow: inset 0 1px 3px rgba(255,255,255,0.1);
    z-index: 5;
  }

  .node-indicator {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sim-green);
    box-shadow: 0 0 8px var(--sim-green);
    transition: all 0.3s;
  }

  .node-tag {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.52rem;
    font-weight: 800;
    color: var(--sim-text-faint);
    letter-spacing: 0.05em;
    margin-bottom: 2px;
    z-index: 5;
  }

  .node-icon-db {
    font-size: 1.1rem;
    margin-bottom: 6px;
    z-index: 5;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }

  .node-register-container {
    text-align: center;
    width: 100%;
    padding: 0 6px;
    z-index: 5;
    margin-top: auto;
    padding-bottom: 12px;
  }

  .node-register-label {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.45rem;
    font-weight: 800;
    color: var(--sim-text-ghost);
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  /* Dynamic glass register value capsule */
  .register-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 0.65rem;
    font-weight: 700;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.1);
    transition: all 0.4s var(--ease-out);
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }

  .register-pill.val-red   { background: var(--sim-red); border-color: rgba(239, 68, 68, 0.4); box-shadow: 0 0 12px var(--sim-red-glow); }
  .register-pill.val-blue  { background: var(--sim-blue); border-color: rgba(59, 130, 246, 0.4); box-shadow: 0 0 12px var(--sim-blue-glow); }
  .register-pill.val-amber { background: var(--sim-amber); border-color: rgba(245, 158, 11, 0.4); box-shadow: 0 0 12px var(--sim-amber-glow); }
  .register-pill.val-green { background: var(--sim-green); border-color: rgba(16, 185, 129, 0.4); box-shadow: 0 0 12px var(--sim-green-glow); }
  .register-pill.val-none  { background: rgba(255,255,255,0.05); color: var(--sim-text-ghost); border-color: rgba(255,255,255,0.05); box-shadow: none; }

  /* Pulsing Database glow states */
  .vis-node.status-sync {
    border-color: rgba(16, 185, 129, 0.15);
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.05), inset 0 20px 30px rgba(255,255,255,0.01);
  }
  .vis-node.status-sync .node-indicator {
    background: var(--sim-green);
    box-shadow: 0 0 8px var(--sim-green);
  }

  .vis-node.status-diverged {
    border-color: rgba(245, 158, 11, 0.25);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.1), inset 0 20px 30px rgba(245, 158, 11, 0.02);
  }
  .vis-node.status-diverged .node-indicator {
    background: var(--sim-amber);
    box-shadow: 0 0 8px var(--sim-amber);
