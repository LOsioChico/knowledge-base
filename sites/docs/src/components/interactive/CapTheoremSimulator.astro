  .dot-online   { background: var(--sim-green); box-shadow: 0 0 8px var(--sim-green); }
  .dot-normal   { background: var(--sim-green); box-shadow: 0 0 8px var(--sim-green); }
  .dot-eventual { background: var(--sim-amber); box-shadow: 0 0 8px var(--sim-amber); }
  .dot-blocked  { background: var(--sim-red); box-shadow: 0 0 8px var(--sim-red); }
