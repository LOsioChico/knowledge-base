    50% { transform: scale(1.05); box-shadow: 0 0 10px rgba(245, 158, 11, 0.6); }
    100% { transform: scale(1); }
  }
</style>

<script>
  function initCapSimulator() {
    document.querySelectorAll<HTMLElement>(".cap-sim:not([data-init])").forEach((comp) => {
      comp.setAttribute("data-init", "");

      // ═══ STATE VARIABLES ═══
      let currentMode: "CP" | "AP" = "CP";
      let networkState: "healthy" | "partitioned" = "healthy";
      
      // Node local values of register x
      let valA: string = "Green";
      let valB: string = "Green";
      
      // Client readouts
      let clientValA: string | null = null;
      let clientValB: string | null = null;

      // Anti-entropy state
      let conflictResolutionActive = false;
      let multiValueActive = false;

      // Tour / Walkthrough state
      let activeTour: null | "AP" | "CP" = null;
      let tourStep = 0;

      // ═══ DOM ELEMENTS ═══
      const visCanvas = comp.querySelector<HTMLElement>("#vis-canvas")!;
      const nodeA = comp.querySelector<HTMLElement>("#node-a")!;
      const nodeB = comp.querySelector<HTMLElement>("#node-b")!;
      
      const valPillA = comp.querySelector<HTMLElement>("#val-pill-a")!;
      const valPillB = comp.querySelector<HTMLElement>("#val-pill-b")!;

      const clientA = comp.querySelector<HTMLElement>("#client-a")!;
      const clientB = comp.querySelector<HTMLElement>("#client-b")!;
      const readoutA = comp.querySelector<HTMLElement>("#readout-a")!;
      const readoutB = comp.querySelector<HTMLElement>("#readout-b")!;

      const btnReadB = comp.querySelector<HTMLButtonElement>("#btn-read-b")!;
      
      const networkLink = comp.querySelector<HTMLElement>("#network-link")!;
      const networkTriggerBtn = comp.querySelector<HTMLButtonElement>("#network-trigger-btn")!;
      const triggerIndicator = networkTriggerBtn.querySelector<HTMLElement>(".trigger-indicator")!;
      const triggerLabel = networkTriggerBtn.querySelector<HTMLElement>(".trigger-label")!;

      const toggleCpBtn = comp.querySelector<HTMLButtonElement>("#toggle-cp-btn")!;
      const toggleApBtn = comp.querySelector<HTMLButtonElement>("#toggle-ap-btn")!;

      const tourMenuTrigger = comp.querySelector<HTMLButtonElement>("#tour-menu-trigger")!;
      const tourDropdownMenu = comp.querySelector<HTMLElement>("#tour-dropdown-menu")!;
      const tourAPBtn = comp.querySelector<HTMLButtonElement>("#tour-ap-btn")!;
      const tourCPBtn = comp.querySelector<HTMLButtonElement>("#tour-cp-btn")!;

      const tutorialStepsBox = comp.querySelector<HTMLElement>("#tutorial-steps-box")!;
      const tutorialTourNameDisp = comp.querySelector<HTMLElement>("#tutorial-tour-name")!;
      const tutorialStepCounterDisp = comp.querySelector<HTMLElement>("#tutorial-step-counter")!;
      const tutorialStepTextDisp = comp.querySelector<HTMLElement>("#tutorial-step-text")!;
      const tutorialProgressBar = comp.querySelector<HTMLElement>("#tutorial-progress-bar")!;
      const tutorialQuitBtn = comp.querySelector<HTMLButtonElement>("#tutorial-quit-btn")!;
      const tourActiveBadge = comp.querySelector<HTMLElement>("#tour-active-badge")!;

      const expandBtn = comp.querySelector<HTMLButtonElement>("#cap-sim-expand-btn")!;

      const dotConsistency = comp.querySelector<HTMLElement>("#status-consistency .status-dot")!;
      const labelConsistency = comp.querySelector<HTMLElement>("#status-consistency .status-label")!;
      const dotAvailability = comp.querySelector<HTMLElement>("#status-availability .status-dot")!;
      const labelAvailability = comp.querySelector<HTMLElement>("#status-availability .status-label")!;
      const dotSync = comp.querySelector<HTMLElement>("#status-sync .status-dot")!;
      const labelSync = comp.querySelector<HTMLElement>("#status-sync .status-label")!;
      const statusMsgText = comp.querySelector<HTMLElement>("#status-msg-text")!;

      const conflictPanel = comp.querySelector<HTMLElement>("#conflict-resolution-panel")!;
      const conflictBadgeA = comp.querySelector<HTMLElement>("#conflict-badge-a")!;
      const conflictBadgeB = comp.querySelector<HTMLElement>("#conflict-badge-b")!;
      const btnResolveLWW = comp.querySelector<HTMLButtonElement>("#btn-resolve-lww")!;
      const btnResolveMulti = comp.querySelector<HTMLButtonElement>("#btn-resolve-multi")!;
      const resolutionHud = comp.querySelector<HTMLElement>("#resolution-hud")!;
      const resolveMultiDesc = comp.querySelector<HTMLElement>("#resolve-multi-desc")!;

      // Swatch collection
      const swatchBtns = comp.querySelectorAll<HTMLButtonElement>(".swatch-btn");

      // ═══ PACKET ANIMATION ENGINE ═══
      function sendPacket(
        fromEl: HTMLElement,
        toEl: HTMLElement,
        type: "write" | "read" | "replicate" | "ack" | "error",
        colorClass: "Red" | "Blue" | "Amber" | "Green" | "None" = "None",
        onComplete?: (success: boolean) => void
      ) {
        const canvasRect = visCanvas.getBoundingClientRect();
        const fromRect = fromEl.getBoundingClientRect();
        const toRect = toEl.getBoundingClientRect();

        const startX = fromRect.left - canvasRect.left + fromRect.width / 2;
        const startY = fromRect.top - canvasRect.top + fromRect.height / 2;
        const endX = toRect.left - canvasRect.left + toRect.width / 2;
        const endY = toRect.top - canvasRect.top + toRect.height / 2;

        const packet = document.createElement("div");
        packet.className = `msg-packet packet-${type} color-${colorClass.toLowerCase()}`;
        packet.style.left = `${startX}px`;
        packet.style.top = `${startY}px`;
        visCanvas.appendChild(packet);

        requestAnimationFrame(() => {
          // If we replicate and network is partitioned, collide at midpoint
          if (type === "replicate" && networkState === "partitioned") {
            const midX = (startX + endX) / 2;
            const midY = (startY + endY) / 2;

            packet.style.transition = "all 0.35s linear";
            packet.style.left = `${midX}px`;
            packet.style.top = `${midY}px`;

            setTimeout(() => {
              triggerBurst(midX, midY);
              packet.remove();
              if (onComplete) onComplete(false);
            }, 350);
          } else {
            // Smooth custom ease to destination
            packet.style.transition = "all 0.55s cubic-bezier(0.25, 0.8, 0.25, 1)";
            packet.style.left = `${endX}px`;
            packet.style.top = `${endY}px`;

            setTimeout(() => {
              packet.remove();
              if (onComplete) onComplete(true);
            }, 550);
          }
        });
      }

      function triggerBurst(x: number, y: number) {
        const burst = document.createElement("div");
        burst.className = "packet-burst";
        burst.style.left = `${x}px`;
        burst.style.top = `${y}px`;
        visCanvas.appendChild(burst);
        setTimeout(() => burst.remove(), 400);
      }

      // ═══ DYNAMIC WALHTHROUGH STEPS ═══
      const apTourSteps = [
        {
          text: "<strong>Welcome to the AP Tour!</strong> AP systems sacrifice consistency to ensure high availability.<br/><br/>👉 Switch the selector to <strong>🔒 CP Mode</strong> first to prepare the AP test.",
          target: toggleCpBtn
        },
        {
          text: "Let's change our mode. <strong>AP Mode</strong> guarantees that all reachable replicas accept writes local-only under partition.<br/><br/>👉 Click the mode toggle to activate <strong>⚡ AP Mode</strong>.",
          target: toggleApBtn
        },
        {
          text: "Our network is healthy. Let's sever the ocean fiber! Replicas will lose contact.<br/><br/>👉 Click the green <strong>Healthy</strong> link badge directly on the network link to partition the database.",
          target: networkTriggerBtn
        },
        {
          text: "<strong>Severed!</strong> Replicas cannot talk. AP guarantees availability! Let's write on London A.<br/><br/>👉 Click the <strong>🔴 Red swatch</strong> under London Node A to write `x = \"Red\"`.",
          target: comp.querySelector("#btn-write-red-a")
        },
        {
          text: "<strong>Write Accepted locally!</strong> Node A glows Red. It tried to replicate, but the packet exploded at the boundary. In AP, it accepts the write locally anyway. NY is unaware.<br/><br/>👉 Let's write in New York B: click the <strong>🔵 Blue swatch</strong> under NY Node B to write `x = \"Blue\"`.",
          target: comp.querySelector("#btn-write-blue-b")
        },
        {
          text: "<strong>Local Writes diverge!</strong> Node A is `Red`, Node B is `Blue`. Replicas are completely split-brained! Let's heal the ocean fiber.<br/><br/>👉 Click the red <strong>Cut</strong> badge to restore communication and sync states.",
          target: networkTriggerBtn
        },
        {
          text: "<strong>Sync triggered!</strong> Replicas detected conflict. Choose <strong>⏱️ Last-Write-Wins (LWW)</strong> to see how databases overwrite conflict states automatically.",
          target: btnResolveLWW
        },
        {
          text: "🎉 <strong>AP Tour Complete!</strong> The LWW strategy compared timestamps. NY's write won and overwrote London Node A to `Blue`. Notice that London's write `Red` was completely **lost**. You experienced standard AP eventual consistency behavior!",
          target: tutorialQuitBtn
        }
      ];

      const cpTourSteps = [
        {
          text: "<strong>Welcome to the CP Tour!</strong> CP systems prioritize absolute linearizable consistency over availability.<br/><br/>👉 Make sure the consistency selector is in <strong>🔒 CP Mode</strong>.",
          target: toggleCpBtn
        },
        {
          text: "Let's sever our communication link to simulate a network outage.<br/><br/>👉 Click the green <strong>Healthy</strong> badge on the network line to partition London and NY.",
          target: networkTriggerBtn
        },
        {
          text: "<strong>Communication severed!</strong> Let's see what happens to a client write. CP mode requires strict consensus.<br/><br/>👉 Click the <strong>🔴 Red swatch</strong> under London Node A to write `x = \"Red\"`.",
          target: comp.querySelector("#btn-write-red-a")
        },
        {
          text: "<strong>Write BLOCKED!</strong> Node A tried to replicate, but because the packet was blocked, A rejected the client's write to prevent split-brain. The register remains `Green`. Let's test a local read.<br/><br/>👉 Click the <strong>🔍 Read Local</strong> button under NY Node B to fetch its state.",
          target: btnReadB
        },
        {
          text: "<strong>Read REJECTED!</strong> Because NY is isolated, CP blocks reads to prevent serving stale values. Let's restore the network.<br/><br/>👉 Click the red <strong>Cut</strong> badge to heal communication.",
          target: networkTriggerBtn
        },
        {
          text: "🎉 <strong>CP Tour Complete!</strong> With link restored, replicas communicate cleanly. Writes and reads are active again. You witnessed how CP sacrifices availability to guarantee absolute consistency!",
          target: tutorialQuitBtn
        }
      ];

      // Clean, premium status logger text helper
      function setMsg(text: string, type: "info" | "success" | "warning" | "error" = "info") {
        statusMsgText.className = `status-message ${type}`;
        statusMsgText.textContent = text;
      }

      // Update Visuals, Pills and indicator statuses
      function updateUI() {
        // Dynamic capsule updates
        if (multiValueActive) {
          valPillA.textContent = `[${valA}, ${valB}]`;
          valPillA.className = "register-pill val-amber";
          valPillB.textContent = `[${valA}, ${valB}]`;
          valPillB.className = "register-pill val-amber";
        } else {
          valPillA.textContent = `x = "${valA}"`;
          valPillA.className = `register-pill val-${valA.toLowerCase()}`;
          valPillB.textContent = `x = "${valB}"`;
          valPillB.className = `register-pill val-${valB.toLowerCase()}`;
        }

        // Apply visual cylinder status rings
        nodeA.className = "vis-node node-a";
        nodeB.className = "vis-node node-b";

        // Readout overlays
        if (clientValA) {
          readoutA.textContent = clientValA;
          readoutA.className = `client-readout val-${clientValA.startsWith("Error") ? "error" : clientValA.replace(/x = "|"/g, "").toLowerCase()}`;
          readoutA.classList.remove("hidden");
        } else {
          readoutA.classList.add("hidden");
        }

        if (clientValB) {
          readoutB.textContent = clientValB;
          readoutB.className = `client-readout val-${clientValB.startsWith("Error") ? "error" : clientValB.replace(/x = "|"/g, "").toLowerCase()}`;
          readoutB.classList.remove("hidden");
        } else {
          readoutB.classList.add("hidden");
        }

        // Clear diagnostic dots
        dotConsistency.className = "status-dot";
        dotAvailability.className = "status-dot";
        dotSync.className = "status-dot";

        // 1. Link Connection state
        if (networkState === "healthy") {
          networkLink.classList.remove("partitioned");
          triggerIndicator.textContent = "🟢";
          triggerLabel.textContent = "Healthy";
          networkTriggerBtn.title = "Click to partition network";
          
          dotSync.classList.add("dot-normal");
          labelSync.textContent = "Sync: Healthy";
          
          nodeA.classList.add("status-sync");
          nodeB.classList.add("status-sync");
        } else {
          networkLink.classList.add("partitioned");
          triggerIndicator.textContent = "🔴";
          triggerLabel.textContent = "Cut";
          networkTriggerBtn.title = "Click to heal network";
          
          if (valA === valB && !multiValueActive) {
            dotSync.classList.add("dot-normal");
            labelSync.textContent = "Sync: Partitioned";
            nodeA.classList.add("status-sync");
            nodeB.classList.add("status-sync");
          } else {
            dotSync.classList.add("dot-diverged");
            labelSync.textContent = "Sync: Diverged";
            nodeA.classList.add("status-diverged");
            nodeB.classList.add("status-diverged");
          }
        }

        // 2. Availability status
        if (networkState === "partitioned" && currentMode === "CP") {
          dotAvailability.classList.add("dot-blocked");
          labelAvailability.textContent = "Availability: Blocked";
          nodeA.className = "vis-node node-a status-offline";
          nodeB.className = "vis-node node-b status-offline";
        } else {
          dotAvailability.classList.add("dot-online");
          labelAvailability.textContent = "Availability: Online";
        }

        // 3. Consistency state
        if (valA === valB && !multiValueActive) {
          dotConsistency.classList.add("dot-strong");
          labelConsistency.textContent = currentMode === "CP" ? "Consistency: Strong" : "Consistency: Unified";
        } else {
          dotConsistency.classList.add("dot-eventual");
          labelConsistency.textContent = "Consistency: Diverged";
        }

        // Keep guided walkthrough HUD state up-to-date
        updateTourUI();
      }

      // ═══ ANTI-ENTROPY SYNC & CONFLICT OVERLAYS ═══
      function triggerSyncReconciliation() {
        setMsg("🔧 Fiber line restored. Nodes exchanging anti-entropy sync packets...", "warning");
        updateUI();

        // Send replication sync packets both ways
        setTimeout(() => {
          sendPacket(nodeA, nodeB, "replicate", "Amber");
          sendPacket(nodeB, nodeA, "replicate", "Amber");

          setTimeout(() => {
            
            // Check if divergence happened in AP mode
            if (valA !== valB) {
              conflictResolutionActive = true;
              conflictBadgeA.textContent = valA;
              conflictBadgeA.className = `preview-badge val-${valA.toLowerCase()}`;
              conflictBadgeB.textContent = valB;
              conflictBadgeB.className = `preview-badge val-${valB.toLowerCase()}`;

              conflictPanel.classList.remove("hidden");
              resolveMultiDesc.innerHTML = `Returns both conflicting values <strong>["${valA}", "${valB}"]</strong> to the client. User must click on a replica to select the winner manually.`;
              setMsg("⚡ Split-brain conflict detected! Replicas are holding conflicting values.", "error");
              
              if (activeTour && tourStep === 6) {
                updateTourUI();
              }
            } else {
              setMsg("Sync complete. Replicas are completely consistent.", "success");
              updateUI();
            }
          }, 600);
        }, 800);
      }

      // Resolve via Last-Write-Wins (LWW)
      btnResolveLWW.addEventListener("click", () => {
        if (!conflictResolutionActive) return;

        // Simulate timestamp B being newer (withdrawal/right node wins)
        const winner = valB; 
        const loser = valA;
        valA = winner;
        valB = winner;

        conflictPanel.classList.add("hidden");
        conflictResolutionActive = false;

        // Visual LWW propagation packet
        setMsg(`LWW Reconciling... comparing timestamps. NY write "${winner}" wins!`, "warning");
        sendPacket(nodeB, nodeA, "replicate", winner as any);

        setTimeout(() => {
          setMsg(`Reconciliation complete. Values converged to "${winner}". "${loser}" write was lost.`, "success");
          updateUI();
          
          if (activeTour && tourStep === 6) {
            progressTour();
          }
        }, 600);
      });

      // Resolve via Multi-Value (application-level siblings)
      btnResolveMulti.addEventListener("click", () => {
        if (!conflictResolutionActive) return;

        conflictPanel.classList.add("hidden");
        multiValueActive = true;
        resolutionHud.classList.remove("hidden");
        setMsg("Multi-Value sibling registers active. Return values [Red, Blue] to Client. Click cylinder to resolve conflict.", "warning");
        updateUI();
      });

      // Unified direct cylinder click for multi-value resolution
      [nodeA, nodeB].forEach((node, idx) => {
        node.addEventListener("click", () => {
          if (!multiValueActive) return;

          const chosenVal = idx === 0 ? valA : valB;

          multiValueActive = false;
          resolutionHud.classList.add("hidden");

          setMsg(`Application selected "${chosenVal}" as resolution winner. Propagating...`, "warning");
          if (idx === 0) {
            sendPacket(nodeA, nodeB, "replicate", chosenVal as any);
          } else {
            sendPacket(nodeB, nodeA, "replicate", chosenVal as any);
          }

          setTimeout(() => {
            valA = chosenVal;
            valB = chosenVal;
            setMsg(`Conflict resolved. Both replicas updated to unified value "${chosenVal}".`, "success");
            updateUI();
          }, 600);
        });
      });

      // ═══ SYMMETRIC DIRECT WRITES ═══
      swatchBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetNodeChar = btn.dataset.node as "A" | "B";
          const chosenVal = btn.dataset.val!;
          const sourceEl = targetNodeChar === "A" ? clientA : clientB;
          const targetNodeEl = targetNodeChar === "A" ? nodeA : nodeB;
          const oppositeNodeEl = targetNodeChar === "A" ? nodeB : nodeA;

          // Clear previous readouts
          clientValA = null;
          clientValB = null;

          // 1. Client to Replica Write Request
          sendPacket(sourceEl, targetNodeEl, "write", chosenVal as any, () => {
            if (networkState === "healthy") {
              // Write replicates instantly
              sendPacket(targetNodeEl, oppositeNodeEl, "replicate", chosenVal as any, () => {
                sendPacket(oppositeNodeEl, targetNodeEl, "ack", "Green");
                
                setTimeout(() => {
                  valA = chosenVal;
                  valB = chosenVal;
                  sendPacket(targetNodeEl, sourceEl, "ack", "Green");
                  setMsg(`Write succeeded. x = "${chosenVal}" is replicated successfully.`, "success");
                  
                  if (activeTour) progressTour();
                  else updateUI();
                }, 550);
              });
            } else {
                // Partition active
                if (currentMode === "CP") {
                  // CP Mode blocks write due to lack of consensus
                  sendPacket(targetNodeEl, oppositeNodeEl, "replicate", chosenVal as any, () => {
                    // This fails due to partition. Send error back to client
                    sendPacket(targetNodeEl, sourceEl, "error", "Red");
                    setMsg("TX REJECTED: Consensus cut. Write blocked to guarantee consistency.", "error");
                    
                    if (activeTour) progressTour();
                    else updateUI();
                  });
                } else {
                  // AP Mode allows local writes
                  sendPacket(targetNodeEl, oppositeNodeEl, "replicate", chosenVal as any, () => {
                    // Replication failed (exploded), but Node A/B accepts locally anyway
                    if (targetNodeChar === "A") {
                      valA = chosenVal;
                    } else {
                      valB = chosenVal;
                    }
                    sendPacket(targetNodeEl, sourceEl, "ack", "Green");
                    setMsg(`Local write accepted on Node ${targetNodeChar}. Replica lag: opposite node is stale.`, "warning");
                    
                    if (activeTour) progressTour();
                    else updateUI();
                  });
                }
            }
          });
        });
      });

      // ═══ SYMMETRIC LOCAL READS ═══
      comp.querySelectorAll<HTMLButtonElement>(".btn-read").forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetNodeChar = btn.dataset.node as "A" | "B";
          const sourceEl = targetNodeChar === "A" ? clientA : clientB;
          const targetNodeEl = targetNodeChar === "A" ? nodeA : nodeB;

          // Clear previous readouts
          clientValA = null;
          clientValB = null;
          updateUI();

          // 1. Client to Replica Read Query
          sendPacket(sourceEl, targetNodeEl, "read", "Blue", () => {
            if (networkState === "healthy") {
              const currentVal = targetNodeChar === "A" ? valA : valB;
              sendPacket(targetNodeEl, sourceEl, "ack", "Green");
              if (targetNodeChar === "A") {
                clientValA = `x = "${currentVal}"`;
              } else {
                clientValB = `x = "${currentVal}"`;
              }
              setMsg(`Strong Read: Fetched unified value x = "${currentVal}" successfully.`, "success");
              
              if (activeTour) progressTour();
              else updateUI();
            } else {
              // Partition active
              if (currentMode === "CP") {
                // CP Mode blocks reads on isolated nodes to prevent serving stale values
                sendPacket(targetNodeEl, sourceEl, "error", "Red");
                if (targetNodeChar === "A") {
                  clientValA = "Error: Stale Read Blocked";
                } else {
                  clientValB = "Error: Stale Read Blocked";
                }
                setMsg("READ REJECTED: Isolated node blocks query to preserve Consistency.", "error");
                
                if (activeTour) progressTour();
                else updateUI();
              } else {
                // AP Mode allows local reads (could be stale!)
                const currentVal = targetNodeChar === "A" ? valA : valB;
                sendPacket(targetNodeEl, sourceEl, "ack", "Green");
                
                if (targetNodeChar === "A") {
                  clientValA = `x = "${currentVal}"`;
                } else {
                  clientValB = `x = "${currentVal}"`;
                }

                // Warn user if serving a stale/diverged value
                if (valA !== valB) {
                  setMsg(`⚠️ Stale Read: Returned stale local value "${currentVal}". Opposite node holds different state!`, "error");
                } else {
                  setMsg(`Local Read: Fetched isolated value x = "${currentVal}".`, "warning");
                }
                
                if (activeTour) progressTour();
                else updateUI();
              }
            }
          });
        });
      });

      // ═══ WALKTHROUGH CONTROLLER ═══
      function startTour(tour: "AP" | "CP") {
        activeTour = tour;
        tourStep = 0;
        
        // Reset system state cleanly
        valA = "Green";
        valB = "Green";
        clientValA = null;
        clientValB = null;
        conflictResolutionActive = false;
        multiValueActive = false;
        networkState = "healthy";
        currentMode = "AP"; // Start AP tour in AP, and CP in CP!
        if (tour === "CP") currentMode = "CP";

        comp.querySelectorAll("#mode-selector-pill button").forEach((b) => b.classList.remove("active"));
        if (tour === "CP" && toggleCpBtn) toggleCpBtn.classList.add("active");
        if (tour === "AP" && toggleApBtn) toggleApBtn.classList.add("active");

        tutorialStepsBox.classList.remove("hidden");
        tourActiveBadge.classList.remove("hidden");
        tourDropdownMenu.classList.add("hidden");
        conflictPanel.classList.add("hidden");
        resolutionHud.classList.add("hidden");

        setMsg(`🎓 Tour Started: ${tour} Mode Walkthrough.`, "info");
        updateUI();
      }

      function quitTour() {
        if (!activeTour) return;
        setMsg("Walkthrough complete. Returned to Free Play mode.", "success");
        
        activeTour = null;
        tourStep = 0;
        
        tutorialStepsBox.classList.add("hidden");
        tourActiveBadge.classList.add("hidden");
        conflictPanel.classList.add("hidden");
        resolutionHud.classList.add("hidden");
        
        comp.querySelectorAll(".pulse-highlight").forEach((el) => el.classList.remove("pulse-highlight"));
        enableAllInputs();
        updateUI();
      }

      function progressTour() {
        if (!activeTour) return;
        const steps = activeTour === "AP" ? apTourSteps : cpTourSteps;
        
        tourStep++;
        if (tourStep >= steps.length) {
          quitTour();
        } else {
          updateUI();
        }
      }

      function enableAllInputs() {
        comp.querySelectorAll<HTMLButtonElement>("#mode-selector-pill button, #network-trigger-btn, .node-action-btn, .swatch-btn").forEach((btn) => {
          btn.disabled = false;
        });
      }

      function updateTourUI() {
        try {
          comp.querySelectorAll(".pulse-highlight").forEach((el) => el.classList.remove("pulse-highlight"));

          if (!activeTour) {
            enableAllInputs();
            return;
          }

          const steps = activeTour === "AP" ? apTourSteps : cpTourSteps;
          const currentStepData = steps[tourStep];
          if (!currentStepData) return;

          if (tutorialTourNameDisp) tutorialTourNameDisp.textContent = `${activeTour} Tour`;
          if (tutorialStepCounterDisp) tutorialStepCounterDisp.textContent = `Step ${tourStep + 1} of ${steps.length}`;
          if (tutorialStepTextDisp) tutorialStepTextDisp.innerHTML = currentStepData.text || "";
          
          if (tutorialProgressBar) {
            const progressPercentage = ((tourStep + 1) / steps.length) * 100;
            tutorialProgressBar.style.width = `${progressPercentage}%`;
          }

          if (currentStepData.target) {
            currentStepData.target.classList.add("pulse-highlight");
          }

          // Disable all inputs except the active step target
          comp.querySelectorAll<HTMLButtonElement>("#mode-selector-pill button, #network-trigger-btn, .node-action-btn, .swatch-btn, #btn-resolve-lww, #btn-resolve-multi").forEach((btn) => {
            if (currentStepData.target && (btn === currentStepData.target || currentStepData.target.contains(btn))) {
              btn.disabled = false;
            } else {
              btn.disabled = true;
            }
          });
        } catch (err) {
          console.error("Error updating CAP Tour HUD safely:", err);
        }
      }

      // Bind Dropdown Trigger
      tourMenuTrigger.addEventListener("click", (e) => {
        e.stopPropagation();
        tourDropdownMenu.classList.toggle("hidden");
      });

      // Close dropdown when clicking outside
      document.addEventListener("click", () => {
        tourDropdownMenu.classList.add("hidden");
      });

      // Bind Tour Buttons
      tourAPBtn.addEventListener("click", () => startTour("AP"));
      tourCPBtn.addEventListener("click", () => startTour("CP"));
      tutorialQuitBtn.addEventListener("click", quitTour);

      // Direct Link partition Toggle button
      networkTriggerBtn.addEventListener("click", () => {
        if (conflictResolutionActive || multiValueActive) return;

        const oldState = networkState;
        networkState = networkState === "healthy" ? "partitioned" : "healthy";

        if (networkState === "partitioned") {
          setMsg("⚠️ Network partitioned! London (A) and New York (B) are isolated.", "error");
        } else if (networkState === "healthy" && oldState === "partitioned") {
          setMsg("🔧 Network healed! Fiber connection active.", "success");
          
          if (valA !== valB) {
            triggerSyncReconciliation();
            return; // Reconciliation logic handles updating UI
          }
        }
        
        // Progress walkthrough step if network badge was target
        if (activeTour && networkTriggerBtn === (activeTour === "AP" ? apTourSteps[tourStep].target : cpTourSteps[tourStep].target)) {
          progressTour();
        } else {
          updateUI();
        }
      });

      // Toggle CP/AP Consistency Mode (Pill selector)
      comp.querySelectorAll<HTMLButtonElement>("#mode-selector-pill button").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (conflictResolutionActive || multiValueActive) return;

          comp.querySelectorAll("#mode-selector-pill button").forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          currentMode = btn.dataset.mode as "CP" | "AP";
          
          setMsg(`Switched database settings to: ${currentMode === "CP" ? "CP (Strict Consistency)" : "AP (High Availability)"}`, "info");
          
          if (activeTour && btn === (activeTour === "AP" ? apTourSteps[tourStep].target : cpTourSteps[tourStep].target)) {
            progressTour();
          } else {
            updateUI();
          }
        });
      });

      // ═══ FULLSCREEN MODAL STATE CONTROLLER ═══
      let placeholder: Comment | null = null;
      let modal: HTMLElement | null = null;
      let isFullscreen = false;

      function openModal() {
        if (isFullscreen) return;
        isFullscreen = true;

        placeholder = document.createComment("cap-sim-placeholder");
        comp.parentNode!.insertBefore(placeholder, comp);

        modal = document.createElement("div");
        modal.className = "cap-sim-modal-overlay";
        modal.innerHTML = `
          <div class="cap-sim-modal-backdrop"></div>
          <div class="cap-sim-modal-container">
            <button class="cap-sim-modal-close" title="Close (Esc)">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        `;
        const container = modal.querySelector(".cap-sim-modal-container")!;
        container.appendChild(comp);
        document.body.appendChild(modal);
        comp.classList.add("is-fullscreen");

        modal.querySelector(".cap-sim-modal-backdrop")!.addEventListener("click", closeModal);
        modal.querySelector(".cap-sim-modal-close")!.addEventListener("click", closeModal);

        expandBtn.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M5 5L1 1M9 5l4-4M9 9l4 4M5 9L1 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
        `;
        expandBtn.title = "Close (Esc)";
        document.body.style.overflow = "hidden";
        updateUI();
      }

      function closeModal() {
        if (!isFullscreen) return;
        isFullscreen = false;

        comp.classList.remove("is-fullscreen");
        if (placeholder && placeholder.parentNode) {
          placeholder.parentNode.insertBefore(comp, placeholder);
          placeholder.remove();
          placeholder = null;
        }

        if (modal) {
          modal.remove();
          modal = null;
        }

        expandBtn.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 5V1h4M9 1h4v4M13 9v4H9M5 13H1V9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        `;
        expandBtn.title = "Expand to fullscreen";
        document.body.style.overflow = "";
        updateUI();
      }

      expandBtn.addEventListener("click", () => {
        isFullscreen ? closeModal() : openModal();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isFullscreen) closeModal();
      });

      // Initial layout setup
      updateUI();
    });
  }

  // Bind on page load and transition changes
  initCapSimulator();
  document.addEventListener("astro:page-load", initCapSimulator);
</script>
