---
/**
 * PipelineStrip.astro
 * ───────────────────
 * Vertical pipeline with left-bordered stage cards connected by
 * flow arrows. Matches the ArchitectureExplorer / DecisionGuide
 * visual language: bg-nav panel, hairline-shade borders, accent
 * left-border cards on bg-sidebar.
 *
 * All content visible — no hover-to-reveal.
 * Supports zones (grouped panels) with custom colors.
 * Pure CSS, no JS.
 */

interface Stage {
  label: string;
  color?: string;
  href?: string;
  tip?: string;
}

interface Zone {
  start: number;
  end: number;
  label: string;
  tip?: string;
  href?: string;
  color?: string;
  icon?: string;
}

interface Props {
  stages: Stage[];
  title?: string;
  zone?: Zone;
  zones?: Zone[];
}

const { stages, title, zone, zones: zonesProp } = Astro.props;
const zones: Zone[] = zonesProp ?? (zone ? [zone] : []);
const zoneMap = new Map<number, Zone>();
for (const z of zones) {
  for (let i = z.start; i <= z.end; i++) zoneMap.set(i, z);
}

// Build segments for zone grouping
interface Segment {
  kind: 'zone' | 'standalone';
  zone?: Zone;
  items: { stage: Stage; idx: number }[];
}

const segments: Segment[] = [];
let current: Segment | null = null;

stages.forEach((stage, idx) => {
  const z = zoneMap.get(idx);
  if (z) {
    if (current?.kind === 'zone' && current.zone === z) {
      current.items.push({ stage, idx });
    } else {
      current = { kind: 'zone', zone: z, items: [{ stage, idx }] };
      segments.push(current);
    }
  } else {
    if (current?.kind === 'standalone') {
      current.items.push({ stage, idx });
    } else {
      current = { kind: 'standalone', items: [{ stage, idx }] };
      segments.push(current);
    }
  }
});

const defaultZoneColor = '#f87171';
const circled = ['①', '②', '③', '④', '⑤', '⑥', '⑦', '⑧', '⑨', '⑩'];
---

<div class="ps not-content">
  {title && (
    <div class="ps-header">
      <span class="ps-title">{title}</span>
    </div>
  )}

  <div class="ps-stack">
    {segments.map((seg, si) => (
      <>
        {/* Inter-segment flow arrow */}
        {si > 0 && <div class="ps-flow-arrow">↓</div>}

        {seg.kind === 'zone' && seg.zone ? (
          <div class="ps-zone" style={`--zc: ${seg.zone.color ?? defaultZoneColor}`}>
            <div class="ps-zone-header">
              <span class="ps-zone-icon">{seg.zone.icon ?? '⚡'}</span>
              {seg.zone.href ? (
                <a class="ps-zone-label" href={seg.zone.href}>{seg.zone.label}</a>
              ) : (
                <span class="ps-zone-label">{seg.zone.label}</span>
              )}
              {seg.zone.tip && <span class="ps-zone-tip">{seg.zone.tip}</span>}
            </div>
            {seg.items.map(({ stage, idx }) => (
              <div class="ps-card" style={stage.color ? `--ps-c: ${stage.color}` : ''}>
                <div class="ps-card-bar" />
                <div class="ps-card-left">
                  <span class="ps-card-num">{circled[idx] || idx + 1}</span>
                  {stage.href ? (
                    <a class="ps-card-name ps-card-link" href={stage.href}>{stage.label}</a>
                  ) : (
                    <span class="ps-card-name">{stage.label}</span>
                  )}
                </div>
                {stage.tip && <span class="ps-card-desc">{stage.tip}</span>}
              </div>
            ))}
          </div>
        ) : (
          seg.items.map(({ stage, idx }) => (
            <div class="ps-card" style={stage.color ? `--ps-c: ${stage.color}` : ''}>
              <div class="ps-card-bar" />
              <div class="ps-card-left">
                <span class="ps-card-num">{circled[idx] || idx + 1}</span>
                {stage.href ? (
                  <a class="ps-card-name ps-card-link" href={stage.href}>{stage.label}</a>
                ) : (
                  <span class="ps-card-name">{stage.label}</span>
                )}
              </div>
              {stage.tip && <span class="ps-card-desc">{stage.tip}</span>}
            </div>
          ))
        )}
      </>
    ))}
  </div>
</div>

<style>
  .ps {
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    --ps-text:       var(--sl-color-text);
    --ps-text-faint: var(--sl-color-gray-3);
    --ps-text-ghost: var(--sl-color-gray-4);
    --ps-rule:       var(--sl-color-hairline-shade);
    --ps-accent:     var(--sl-color-accent-high);
    --ps-panel:      var(--sl-color-bg-nav);
    --ps-surface:    var(--sl-color-bg-sidebar);
    --ps-c:          var(--ps-accent);
    margin: 1.5rem 0;
    background: var(--ps-panel);
    border: 1px solid var(--ps-rule);
    border-radius: 10px;
    overflow: hidden;
  }

  /* ═══ HEADER ═══ */
  .ps-header {
    display: flex;
    align-items: center;
    padding: 12px 20px;
    border-bottom: 1px solid var(--ps-rule);
  }

  .ps-title {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--ps-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ═══ CARD STACK ═══ */
  .ps-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 6px 0;
  }

  /* ── Card row ── */
  .ps-card {
    --ps-c: var(--ps-accent);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 20px;
    border-left: 3px solid var(--ps-c);
    margin: 0 12px;
    background: var(--ps-surface);
    border-radius: 0;
    border-top: 1px solid var(--ps-rule);
    border-right: 1px solid var(--ps-rule);
    border-bottom: 1px solid var(--ps-rule);
    transition: background 160ms var(--ease), box-shadow 160ms var(--ease);
    position: relative;
  }

  .ps-card + .ps-card {
    margin-top: -1px;
  }

  .ps-card:first-child {
    border-radius: 6px 6px 0 0;
  }

  .ps-card:last-child {
    border-radius: 0 0 6px 6px;
  }

  .ps-card:only-child {
    border-radius: 6px;
  }

  .ps-card:hover {
    background: color-mix(in srgb, var(--ps-c) 4%, var(--ps-surface));
    box-shadow: inset 4px 0 12px -4px color-mix(in srgb, var(--ps-c) 15%, transparent);
  }

  /* ── Number + label row ── */
  .ps-card-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ps-card-num {
    font-size: var(--sl-text-sm);
    color: var(--ps-c);
    opacity: 0.6;
    flex-shrink: 0;
    width: 18px;
    text-align: center;
  }

  .ps-card-name {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--ps-text);
    transition: color 160ms var(--ease);
  }

  .ps-card:hover .ps-card-name {
    color: var(--ps-c);
  }

  a.ps-card-link {
    text-decoration: none;
    cursor: pointer;
  }

  a.ps-card-link::after {
    content: " →";
    font-size: 1em;
    opacity: 0.5;
    margin-left: 4px;
    transition: opacity 160ms var(--ease), transform 160ms var(--ease);
    display: inline-block;
  }

  a.ps-card-link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  a.ps-card-link:hover::after {
    opacity: 1;
    transform: translateX(3px);
  }

  /* ── Description ── */
  .ps-card-desc {
    font-size: var(--sl-text-xs);
    color: var(--ps-text-ghost);
    line-height: 1.5;
    padding-left: 28px; /* align with label text (18px num + 10px gap) */
  }

  /* ── Flow arrow between segments ── */
  .ps-flow-arrow {
    text-align: center;
    font-size: 12px;
    color: var(--ps-text-ghost);
    opacity: 0.5;
    padding: 4px 0;
  }

  /* ═══ ZONE GROUP ═══ */
  .ps-zone {
    --zc: #f87171;
    margin: 0 12px;
    border: 1px dashed color-mix(in srgb, var(--zc) 25%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--zc) 3%, transparent);
    padding: 0;
    overflow: hidden;
  }

  .ps-zone .ps-card {
    margin: 0;
    border-radius: 0;
    border-right: none;
    border-left-width: 3px;
    border-top: 1px solid color-mix(in srgb, var(--ps-c) 12%, var(--ps-rule));
  }

  .ps-zone .ps-card:first-of-type {
    border-top: none;
  }

  .ps-zone-header {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px;
    flex-wrap: wrap;
  }

  .ps-zone-icon { font-size: 11px; }

  .ps-zone-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--zc) 60%, var(--ps-text-faint));
    text-decoration: none;
  }

  a.ps-zone-label:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ps-zone-tip {
    font-size: var(--sl-text-xs);
    color: color-mix(in srgb, var(--zc) 40%, var(--ps-text-ghost));
    line-height: 1.4;
    flex-basis: 100%;
    padding-left: 16px;
  }

  /* ═══ REDUCED MOTION ═══ */
  @media (prefers-reduced-motion: reduce) {
    .ps-card { transition-duration: 0.01ms !important; }
  }

  /* ═══ PRINT ═══ */
  @media print {
    .ps-card { box-shadow: none !important; }
    .ps-zone { border-style: solid; }
  }
</style>
