---
/**
 * VisualFlow.astro
 *
 * Interactive 2D Flowchart Component that displays the entire workflow simultaneously.
 * Nodes are positioned on a logical 2D grid using columns and rows.
 * SVG connection edges and glassmorphic labels are drawn dynamically on the client side,
 * ensuring responsiveness and perfect coordinate alignment across screen resizes.
 *
 * Scoped-CSS Gotcha Solved: Dynamically created elements (SVG paths, arrows, and labels)
 * are styled using Astro's :global() selectors to prevent scoping attributes from wiping them out.
 */

interface Node {
  id: string;
  label: string;
  col: number;
  row: number;
  color?: string;
  description?: string;
  icon?: string;
}

interface Edge {
  from: string;
  to: string;
  label?: string;
  color?: string;
  style?: "dashed" | "solid";
  type?: "straight" | "curved";
}

interface Props {
  nodes: Node[];
  edges: Edge[];
  title?: string;
}

const { nodes, edges, title } = Astro.props;

// Compute unique column and row sizes for CSS Grid
const cols = nodes.map(n => n.col);
const rows = nodes.map(n => n.row);
const maxCol = Math.max(...cols, 0);
const maxRow = Math.max(...rows, 0);
---

<div
  class="vf not-content"
  data-nodes={JSON.stringify(nodes)}
  data-edges={JSON.stringify(edges)}
>
  {title && (
    <div class="vf-header">
      <span class="vf-title">{title}</span>
      <span class="vf-badge">⬡ Interactive Map</span>
    </div>
  )}

  <div class="vf-workspace">
    {/* Grid of Nodes */}
    <div
      class="vf-grid"
      style={`--vf-col-count: ${maxCol + 1}; --vf-row-count: ${maxRow + 1};`}
    >
      {nodes.map((node) => (
        <div
          class="vf-node"
          data-node-id={node.id}
          style={`grid-column: ${node.col + 1}; grid-row: ${node.row + 1}; ${node.color ? `--vf-node-accent: ${node.color}` : ""}`}
        >
          <div class="vf-node-card">
            <div class="vf-node-badge">
              {node.icon === "input" && (
                <svg viewBox="0 0 24 24" class="vf-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="9" y1="9" x2="15" y2="9"></line>
                  <line x1="9" y1="13" x2="15" y2="13"></line>
                  <line x1="9" y1="17" x2="15" y2="17"></line>
                </svg>
              )}
              {node.icon === "loop" && (
                <svg viewBox="0 0 24 24" class="vf-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="17 1 21 5 17 9"></polyline>
                  <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                  <polyline points="7 23 3 19 7 15"></polyline>
                  <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
                </svg>
              )}
              {node.icon === "network" && (
                <svg viewBox="0 0 24 24" class="vf-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 17.58A5 5 0 0 0 18 8h-1.26A8 8 0 1 0 4 16.25"></path>
                  <line x1="12" y1="12" x2="12" y2="22"></line>
                  <polyline points="8 18 12 22 16 18"></polyline>
                </svg>
              )}
              {node.icon === "schema" && (
                <svg viewBox="0 0 24 24" class="vf-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
              )}
              {node.icon === "timer" && (
                <svg viewBox="0 0 24 24" class="vf-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              )}
              {node.icon === "success" && (
                <svg viewBox="0 0 24 24" class="vf-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              )}
              {node.icon === "retry" && (
                <svg viewBox="0 0 24 24" class="vf-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
              )}
              {node.icon === "fail" && (
                <svg viewBox="0 0 24 24" class="vf-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              )}
              {!node.icon && (
                <span class="vf-node-initials">
                  {node.label.replace(/[()\[\]{}]/g, '').split(/\s+/).filter(Boolean).map(w => w[0]).join('').toUpperCase().slice(0, 3)}
                </span>
              )}
            </div>
            <span class="vf-node-label">{node.label}</span>
          </div>
          
          {node.description && (
            <div class="vf-tooltip">
              <span class="vf-tooltip-title">{node.label}</span>
              <p class="vf-tooltip-desc">{node.description}</p>
            </div>
          )}
        </div>
      ))}
    </div>

    {/* SVG Edges and Labels Container */}
    <div class="vf-connections">
      <svg class="vf-svg" preserveAspectRatio="none" />
      <div class="vf-labels" />
    </div>
  </div>
</div>

<style>
  .vf {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --vf-text:       var(--sl-color-text);
    --vf-text-faint: var(--sl-color-gray-3);
    --vf-text-ghost: var(--sl-color-gray-4);
    --vf-rule:       var(--sl-color-hairline-shade);
    --vf-accent:     var(--sl-color-accent-high);
    --vf-accent-low: var(--sl-color-accent-low);
    --vf-panel:      rgba(20, 20, 23, 0.5);
    --vf-node-accent: var(--vf-accent);
    margin: 2rem 0;
    background: var(--vf-panel);
    border: 1px solid var(--vf-rule);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  .vf-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--vf-rule);
    background: rgba(10, 10, 12, 0.4);
  }

  .vf-title {
    font-size: var(--sl-text-xs);
    font-weight: 700;
    color: var(--vf-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .vf-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--vf-accent);
    background: color-mix(in srgb, var(--vf-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--vf-accent) 25%, transparent);
    padding: 0.25rem 0.65rem;
    border-radius: 99px;
  }

  .vf-workspace {
    position: relative;
    padding: 50px 30px;
    min-height: 250px;
    overflow: visible;
  }

  /* 2D Grid Layout */
  .vf-grid {
    display: grid;
    grid-template-columns: repeat(var(--vf-col-count, 3), 1fr);
    grid-template-rows: repeat(var(--vf-row-count, 6), auto);
    row-gap: 55px;
    column-gap: 50px;
    align-items: center;
    justify-items: center;
    position: relative;
    z-index: 2;
  }

  .vf-node {
    position: relative;
    cursor: pointer;
    transition: transform 200ms var(--ease-out), opacity 300ms var(--ease-out);
  }

  /* Horizontal Pill Card Layout */
  .vf-node-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px 8px 10px;
    border-radius: 20px;
    background: rgba(22, 22, 26, 0.85);
    backdrop-filter: blur(10px);
    border: 1.5px solid var(--vf-rule);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: border-color 250ms var(--ease-out),
                background 250ms var(--ease-out),
                box-shadow 250ms var(--ease-out),
                transform 200ms var(--ease-out);
    min-width: 170px;
    max-width: 260px;
  }

  /* Hover Dimming Logic */
  .vf-workspace.has-hover .vf-node:not(.is-active) {
    opacity: 0.25;
  }

  .vf-node-badge {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--vf-node-accent) 12%, rgba(255, 255, 255, 0.04));
    border: 1.5px solid color-mix(in srgb, var(--vf-node-accent) 35%, var(--vf-rule));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: border-color 250ms var(--ease-out),
                background 250ms var(--ease-out),
                box-shadow 250ms var(--ease-out);
  }

  .vf-icon {
    width: 12px;
    height: 12px;
    color: var(--vf-node-accent);
    transition: transform 200ms var(--ease-out);
  }

  .vf-node:hover .vf-icon,
  .vf-node.is-active .vf-icon {
    transform: scale(1.1);
  }

  .vf-node:hover .vf-node-card,
  .vf-node.is-active .vf-node-card {
    border-color: var(--vf-node-accent);
    background: color-mix(in srgb, var(--vf-node-accent) 6%, rgba(22, 22, 26, 0.95));
    box-shadow: 0 0 16px color-mix(in srgb, var(--vf-node-accent) 20%, transparent);
    transform: scale(1.02);
  }

  .vf-node:hover .vf-node-badge,
  .vf-node.is-active .vf-node-badge {
    background: color-mix(in srgb, var(--vf-node-accent) 22%, transparent);
    border-color: var(--vf-node-accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--vf-node-accent) 25%, transparent);
  }

  .vf-node-initials {
    font-size: 0.65rem;
    font-weight: 700;
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    color: var(--vf-text-ghost);
    transition: color 250ms var(--ease-out);
  }

  .vf-node:hover .vf-node-initials,
  .vf-node.is-active .vf-node-initials {
    color: var(--vf-node-accent);
  }

  .vf-node-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--vf-text-faint);
    line-height: 1.35;
    transition: color 250ms var(--ease-out);
    text-align: left;
    white-space: normal;
  }

  .vf-node:hover .vf-node-label,
  .vf-node.is-active .vf-node-label {
    color: var(--vf-text);
  }

  /* Tooltips / Detailed Popovers */
  .vf-tooltip {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    width: 220px;
    background: rgba(15, 15, 18, 0.95);
    backdrop-filter: blur(12px);
    border: 1.5px solid var(--vf-node-accent);
    border-radius: 10px;
    padding: 12px 14px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out);
    z-index: 10;
  }

  .vf-node:hover .vf-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .vf-tooltip-title {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--vf-node-accent);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 4px;
  }

  .vf-tooltip-desc {
    font-size: 0.65rem;
    color: var(--vf-text-faint);
    line-height: 1.45;
    margin: 0;
  }

  /* Connections Container */
  .vf-connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
  }

  .vf-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .vf-labels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }

  /* -------------------------------------------------------------------------- */
  /* GLOBAL STYLES FOR DYNAMIC SVG/HTML PATHS, ARROWS, AND LABELS               */
  /* Bypasses Astro's CSS Scoping mechanism                                      */
  /* -------------------------------------------------------------------------- */

  :global(.vf-path) {
    fill: none !important;
    stroke-width: 1.5;
    transition: opacity 300ms cubic-bezier(0.23, 1, 0.32, 1),
                stroke-width 200ms cubic-bezier(0.23, 1, 0.32, 1),
                filter 250ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global(.vf-workspace.has-hover .vf-path:not(.is-active)) {
    opacity: 0.12 !important;
  }

  @keyframes vf-flow {
    to {
      stroke-dashoffset: -20;
    }
  }

  :global(.vf-path.is-active) {
    stroke-width: 2.5 !important;
    filter: drop-shadow(0 0 4px color-mix(in srgb, currentColor 55%, transparent));
    stroke-dasharray: 6 4;
    animation: vf-flow 1.2s linear infinite;
  }

  :global(.vf-arrow) {
    transition: opacity 300ms cubic-bezier(0.23, 1, 0.32, 1),
                fill 250ms cubic-bezier(0.23, 1, 0.32, 1),
                filter 250ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global(.vf-workspace.has-hover .vf-arrow:not(.is-active)) {
    opacity: 0.12 !important;
  }

  :global(.vf-arrow.is-active) {
    filter: drop-shadow(0 0 3px color-mix(in srgb, currentColor 55%, transparent));
  }

  :global(.vf-edge-label) {
    position: absolute;
    font-size: 0.6rem;
    font-weight: 700;
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    color: var(--vf-text-ghost);
    background: rgba(14, 14, 17, 0.9);
    backdrop-filter: blur(4px);
    border: 1px solid var(--vf-rule);
    padding: 3px 6px;
    border-radius: 5px;
    white-space: nowrap;
    z-index: 3;
    pointer-events: auto;
    transition: opacity 300ms cubic-bezier(0.23, 1, 0.32, 1),
                border-color 250ms cubic-bezier(0.23, 1, 0.32, 1),
                color 250ms cubic-bezier(0.23, 1, 0.32, 1),
                box-shadow 250ms cubic-bezier(0.23, 1, 0.32, 1),
                transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
    cursor: pointer;
  }

  :global(.vf-edge-label:hover),
  :global(.vf-edge-label.is-active) {
    border-color: var(--vf-accent) !important;
    color: var(--vf-text) !important;
    box-shadow: 0 0 10px color-mix(in srgb, var(--vf-accent) 25%, transparent) !important;
    transform: translate(-50%, -50%) scale(1.05) !important;
  }

  :global(.vf-workspace.has-hover .vf-edge-label:not(.is-active)) {
    opacity: 0.18 !important;
  }

  /* Print and Motion styling */
  @media (prefers-reduced-motion: reduce) {
    .vf-node, .vf-node-card, .vf-node-badge, .vf-tooltip {
      transition-duration: 0.01ms !important;
    }
    :global(.vf-path), :global(.vf-arrow), :global(.vf-edge-label) {
      transition-duration: 0.01ms !important;
    }
  }

  @media print {
    .vf-node { opacity: 1 !important; }
    .vf-node-card { border-color: #666 !important; background: #fff !important; }
    :global(.vf-path) { opacity: 0.8 !important; stroke: #333 !important; }
    :global(.vf-edge-label) { opacity: 1 !important; border-color: #666 !important; color: #000 !important; }
    .vf-tooltip { display: none; }
  }
</style>

<script>
  function initVisualFlow() {
    document.querySelectorAll<HTMLElement>(".vf:not([data-init])").forEach((comp) => {
      comp.setAttribute("data-init", "");

      const nodes: { id: string; label: string; col: number; row: number; color?: string }[] = JSON.parse(comp.dataset.nodes || "[]");
      const edges: { from: string; to: string; label?: string; color?: string; style?: "dashed" | "solid"; type?: "straight" | "curved" }[] =
        JSON.parse(comp.dataset.edges || "[]");

      if (nodes.length === 0) return;

      const workspace = comp.querySelector<HTMLElement>(".vf-workspace")!;
      const nodeEls = comp.querySelectorAll<HTMLElement>(".vf-node");
      const svg = comp.querySelector<SVGSVGElement>(".vf-svg")!;
      const labelsContainer = comp.querySelector<HTMLElement>(".vf-labels")!;
      const NS = "http://www.w3.org/2000/svg";

      /* Node Lookup */
      function getNodeCenter(id: string): { x: number; y: number } | null {
        const idx = nodes.findIndex(n => n.id === id);
        if (idx < 0) return null;
        const card = nodeEls[idx]?.querySelector(".vf-node-card");
        if (!card) return null;
        const svgRect = svg.getBoundingClientRect();
        const cardRect = card.getBoundingClientRect();
        return {
          x: cardRect.left + cardRect.width / 2 - svgRect.left,
          y: cardRect.top + cardRect.height / 2 - svgRect.top,
        };
      }

      /* Connect all edges */
      function drawAllConnections() {
        svg.innerHTML = "";
        labelsContainer.innerHTML = "";

        edges.forEach((edge, edgeIdx) => {
          const idx1 = nodes.findIndex(n => n.id === edge.from);
          const idx2 = nodes.findIndex(n => n.id === edge.to);
          if (idx1 < 0 || idx2 < 0) return;

          const from = getNodeCenter(edge.from);
          const to = getNodeCenter(edge.to);
          if (!from || !to) return;

          const dx = to.x - from.x;
          const dy = to.y - from.y;
          const len = Math.sqrt(dx * dx + dy * dy);
          if (len < 1) return;

          const sourceCard = nodeEls[idx1]?.querySelector(".vf-node-card")!;
          const targetCard = nodeEls[idx2]?.querySelector(".vf-node-card")!;
          const sourceRect = sourceCard.getBoundingClientRect();
          const targetRect = targetCard.getBoundingClientRect();

          const ux = dx / len;
          const uy = dy / len;

          // Dynamically compute exact boundary padding based on direction angle
          const sW = sourceRect.width || 170;
          const sH = sourceRect.height || 44;
          const tW = targetRect.width || 170;
          const tH = targetRect.height || 44;

          const pad1 = Math.abs(ux) > Math.abs(uy) ? (sW / 2) : (sH / 2);
          const pad2 = (Math.abs(ux) > Math.abs(uy) ? (tW / 2) : (tH / 2)) + 6;

          const x1 = from.x + ux * pad1;
          const y1 = from.y + uy * pad1;
          const x2 = to.x - ux * pad2;
          const y2 = to.y - uy * pad2;

          const edgeColor = edge.color || "var(--vf-accent)";
          const isDashed = edge.style === "dashed";
          const isCurved = edge.type === "curved";

          // Calculate Path coordinates & Midpoints for labels
          let pathD = "";
          let px = 0;
          let py = 0;
          let ctrlX = 0;
          let ctrlY = 0;

          if (isCurved) {
            const midX = (x1 + x2) / 2;
            const midY = (y1 + y2) / 2;
            const isRightToLeft = x2 < x1;

            if (isRightToLeft) {
              // Loopback arch going outwards to the right
              ctrlX = Math.max(x1, x2) + 90;
              ctrlY = (y1 + y2) / 2;
            } else {
              // Curved flow
              ctrlX = midX + 40;
              ctrlY = midY - 30;
            }

            pathD = `M ${x1},${y1} Q ${ctrlX},${ctrlY} ${x2},${y2}`;
            // Math center for Quadratic Bezier Curve at t = 0.5
            px = 0.25 * x1 + 0.5 * ctrlX + 0.25 * x2;
            py = 0.25 * y1 + 0.5 * ctrlY + 0.25 * y2;
          } else {
            // Straight connector
            pathD = `M ${x1},${y1} L ${x2},${y2}`;
            px = (x1 + x2) / 2;
            py = (y1 + y2) / 2;
          }

          // Renders connection line
          const path = document.createElementNS(NS, "path");
          path.setAttribute("d", pathD);
          path.setAttribute("class", "vf-path");
          path.setAttribute("stroke", edgeColor);
          path.setAttribute("stroke-width", "1.5");
          path.setAttribute("fill", "none"); // Inline fix for default black fill
          if (isDashed) path.setAttribute("stroke-dasharray", "5 3");
          path.setAttribute("data-edge-idx", String(edgeIdx));
          svg.appendChild(path);

          // Renders Arrowhead along tangent
          let tux = ux;
          let tuy = uy;
          if (isCurved) {
            const tdx = x2 - ctrlX;
            const tdy = y2 - ctrlY;
            const tLen = Math.sqrt(tdx * tdx + tdy * tdy) || 1;
            tux = tdx / tLen;
            tuy = tdy / tLen;
          }

          const as = 6.5; // arrow size
          const ax = x2 - tux * as - tuy * (as / 1.7);
          const ay = y2 - tuy * as + tux * (as / 1.7);
          const bx = x2 - tux * as + tuy * (as / 1.7);
          const by = y2 - tuy * as - tux * (as / 1.7);

          const arrow = document.createElementNS(NS, "polygon");
          arrow.setAttribute("points", `${x2},${y2} ${ax},${ay} ${bx},${by}`);
          arrow.setAttribute("class", "vf-arrow");
          arrow.setAttribute("fill", edgeColor);
          arrow.setAttribute("data-edge-idx", String(edgeIdx));
          svg.appendChild(arrow);

          // Render Label absolute positioned over midpoint
          if (edge.label) {
            const labelEl = document.createElement("div");
            labelEl.className = "vf-edge-label";
            labelEl.textContent = edge.label;
            labelEl.style.left = `${px}px`;
            labelEl.style.top = `${py}px`;
            labelEl.style.transform = "translate(-50%, -50%)";
            labelEl.setAttribute("data-edge-idx", String(edgeIdx));
            labelsContainer.appendChild(labelEl);

            // Edge Label Hover binds
            labelEl.addEventListener("mouseenter", () => highlightEdge(edgeIdx));
            labelEl.addEventListener("mouseleave", clearHighlights);
          }
        });
      }

      /* Hover Interaction Helpers */
      function highlightNode(nodeId: string) {
        workspace.classList.add("has-hover");
        
        // Find ONLY outgoing edges from this node
        const activeEdgeIdxs = edges
          .map((e, i) => (e.from === nodeId) ? i : -1)
          .filter(i => i >= 0);
        
        const activeNodes = new Set<string>([nodeId]);
        activeEdgeIdxs.forEach(idx => {
          activeNodes.add(edges[idx].to);
        });

        nodeEls.forEach(el => {
          const nid = el.dataset.nodeId!;
          el.classList.toggle("is-active", activeNodes.has(nid));
        });

        comp.querySelectorAll<SVGElement>(".vf-path, .vf-arrow").forEach(el => {
          const idx = Number(el.getAttribute("data-edge-idx"));
          el.classList.toggle("is-active", activeEdgeIdxs.includes(idx));
        });

        comp.querySelectorAll<HTMLElement>(".vf-edge-label").forEach(el => {
          const idx = Number(el.getAttribute("data-edge-idx"));
          el.classList.toggle("is-active", activeEdgeIdxs.includes(idx));
        });
      }

      function highlightEdge(edgeIdx: number) {
        workspace.classList.add("has-hover");
        const edge = edges[edgeIdx];

        nodeEls.forEach(el => {
          const nid = el.dataset.nodeId!;
          el.classList.toggle("is-active", nid === edge.from || nid === edge.to);
        });

        comp.querySelectorAll<SVGElement>(".vf-path, .vf-arrow").forEach(el => {
          const idx = Number(el.getAttribute("data-edge-idx"));
          el.classList.toggle("is-active", idx === edgeIdx);
        });

        comp.querySelectorAll<HTMLElement>(".vf-edge-label").forEach(el => {
          const idx = Number(el.getAttribute("data-edge-idx"));
          el.classList.toggle("is-active", idx === edgeIdx);
        });
      }

      function clearHighlights() {
        workspace.classList.remove("has-hover");
        nodeEls.forEach(el => el.classList.remove("is-active"));
        comp.querySelectorAll<SVGElement>(".vf-path, .vf-arrow, .vf-edge-label").forEach(el => {
          el.classList.remove("is-active");
        });
      }

      /* Hover Listeners for Nodes */
      nodeEls.forEach((el) => {
        el.addEventListener("mouseenter", () => highlightNode(el.dataset.nodeId!));
        el.addEventListener("mouseleave", clearHighlights);
      });

      // Initial draw
      drawAllConnections();

      // Keep aligned on screen resizes
      let resizeTimer: any;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(drawAllConnections, 60);
      });
    });
  }

  // Bind on load and Astro page transitions
  initVisualFlow();
  document.addEventListener("astro:page-load", initVisualFlow);
</script>
