---
/**
 * ParameterPlayground.astro
 *
 * Interactive parameter explorer. The reader adjusts sliders/inputs
 * and sees computed outputs update live with visual feedback bars.
 *
 * Props:
 *   params   – adjustable input parameters (sliders, numbers, selects)
 *   compute  – JS function body receiving a `params` object, returns output object
 *   outputs  – output display definitions (name, label, format)
 *   title    – optional heading
 */

interface Param {
  name: string;
  label: string;
  type: "range" | "number" | "select";
  min?: number;
  max?: number;
  step?: number;
  default: number | string;
  options?: { label: string; value: string | number }[];
  suffix?: string;
}

interface Output {
  name: string;
  label: string;
  format?: "percent" | "number" | "decimal" | "text";
  good?: "high" | "low";
}

interface Props {
  params: Param[];
  compute: string;
  outputs: Output[];
  title?: string;
}

const { params, compute, outputs, title } = Astro.props;
---

<div
  class="pp not-content"
  data-params={JSON.stringify(params)}
  data-compute={compute}
  data-outputs={JSON.stringify(outputs)}
>
  {title && (
    <div class="pp-header">
      <span class="pp-title">{title}</span>
      <button class="pp-reset" aria-label="Reset to defaults">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M2 8a6 6 0 1 1 1.5 4" />
          <polyline points="1 5 2 8 5 7" />
        </svg>
        Reset
      </button>
    </div>
  )}

  <div class="pp-layout">
    {/* Input controls */}
    <div class="pp-inputs">
      {params.map((p) => (
        <div class="pp-field" data-param={p.name}>
          <div class="pp-field-header">
            <label class="pp-field-label">{p.label}</label>
            <span class="pp-field-value" data-value-for={p.name}>
              {p.default}{p.suffix || ""}
            </span>
          </div>
          {p.type === "range" ? (
            <div class="pp-slider-wrap">
              <input
                type="range"
                class="pp-slider"
                data-input={p.name}
                min={p.min ?? 0}
                max={p.max ?? 100}
                step={p.step ?? 1}
                value={String(p.default)}
              />
              <div class="pp-range-labels">
                <span>{p.min ?? 0}</span>
                <span>{p.max ?? 100}</span>
              </div>
            </div>
          ) : p.type === "select" ? (
            <select class="pp-select" data-input={p.name}>
              {p.options?.map((opt) => (
                <option
                  value={String(opt.value)}
                  selected={opt.value === p.default}
                >
                  {opt.label}
                </option>
              ))}
            </select>
          ) : (
            <input
              type="number"
              class="pp-number"
              data-input={p.name}
              min={p.min}
              max={p.max}
              step={p.step ?? 1}
              value={String(p.default)}
            />
          )}
        </div>
      ))}
    </div>

    {/* Output display */}
    <div class="pp-outputs">
      {outputs.map((o) => (
        <div class="pp-output" data-output={o.name}>
          <div class="pp-output-top">
            <span class="pp-output-label">{o.label}</span>
            <span class="pp-output-value" data-out-value={o.name}>—</span>
          </div>
          {(o.format === "percent" || o.format === "decimal") && (
            <div class="pp-bar-track">
              <div class="pp-bar-fill" data-out-bar={o.name} />
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .pp {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --pp-text:       var(--sl-color-text);
    --pp-text-faint: var(--sl-color-gray-3);
    --pp-text-ghost: var(--sl-color-gray-4);
    --pp-rule:       var(--sl-color-hairline-shade);
    --pp-accent:     var(--sl-color-accent-high);
    --pp-accent-low: var(--sl-color-accent-low);
    --pp-panel:      var(--sl-color-bg-nav);
    --pp-green:      #4ade80;
    --pp-green-dim:  rgba(74, 222, 128, 0.15);
    --pp-red:        #f87171;
    --pp-red-dim:    rgba(248, 113, 113, 0.15);
    margin: 1.5rem 0;
    background: var(--pp-panel);
    border: 1px solid var(--pp-rule);
    border-radius: 10px;
    overflow: hidden;
  }

  .pp-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--pp-rule);
  }

  .pp-title {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--pp-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pp-reset {
    all: unset;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--pp-text-ghost);
    cursor: pointer;
    padding: 3px 8px;
    border-radius: 5px;
    transition: color 160ms var(--ease-out), background 160ms var(--ease-out);
  }

  .pp-reset:hover {
    color: var(--pp-accent);
    background: var(--pp-accent-low);
  }

  .pp-reset svg {
    width: 12px;
    height: 12px;
  }

  .pp-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  @media (max-width: 560px) {
    .pp-layout { grid-template-columns: 1fr; }
  }

  /* ═══ INPUTS ═══ */
  .pp-inputs {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-right: 1px solid var(--pp-rule);
  }

  @media (max-width: 560px) {
    .pp-inputs { border-right: none; border-bottom: 1px solid var(--pp-rule); }
  }

  .pp-field {
    padding: 14px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pp-field + .pp-field {
    border-top: 1px solid var(--pp-rule);
  }

  .pp-field-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .pp-field-label {
    font-size: var(--sl-text-sm);
    color: var(--pp-text-faint);
    font-weight: 500;
  }

  .pp-field-value {
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-size: var(--sl-text-sm);
    color: var(--pp-accent);
    font-weight: 600;
    transition: transform 120ms var(--ease-out);
  }

  .pp-field-value.is-changed {
    transform: scale(1.1);
  }

  /* Slider */
  .pp-slider-wrap {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pp-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: var(--pp-rule);
    outline: none;
    cursor: pointer;
  }

  .pp-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--pp-accent);
    cursor: pointer;
    transition: transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }

  .pp-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
    box-shadow: 0 0 0 4px var(--pp-accent-low);
  }

  .pp-slider::-webkit-slider-thumb:active {
    transform: scale(0.95);
  }

  .pp-slider::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 50%;
    background: var(--pp-accent);
    cursor: pointer;
  }

  .pp-range-labels {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: var(--pp-text-ghost);
    padding: 0 2px;
  }

  /* Number input */
  .pp-number {
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-size: var(--sl-text-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--pp-rule);
    border-radius: 5px;
    color: var(--pp-text);
    padding: 6px 10px;
    width: 100%;
    outline: none;
    transition: border-color 160ms var(--ease-out);
  }

  .pp-number:focus {
    border-color: var(--pp-accent);
  }

  /* Select */
  .pp-select {
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-size: var(--sl-text-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--pp-rule);
    border-radius: 5px;
    color: var(--pp-text);
    padding: 6px 10px;
    width: 100%;
    outline: none;
    cursor: pointer;
    transition: border-color 160ms var(--ease-out);
  }

  .pp-select:focus {
    border-color: var(--pp-accent);
  }

  /* ═══ OUTPUTS ═══ */
  .pp-outputs {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pp-output {
    padding: 14px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pp-output + .pp-output {
    border-top: 1px solid var(--pp-rule);
  }

  .pp-output-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .pp-output-label {
    font-size: var(--sl-text-sm);
    color: var(--pp-text-faint);
  }

  .pp-output-value {
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--pp-text);
    transition: color 200ms var(--ease-out);
  }

  .pp-output-value.is-good { color: var(--pp-green); }
  .pp-output-value.is-bad  { color: var(--pp-red); }

  /* Visual bar */
  .pp-bar-track {
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .pp-bar-fill {
    height: 100%;
    border-radius: 2px;
    width: 0%;
    background: var(--pp-accent);
    transition: width 300ms var(--ease-out), background 300ms var(--ease-out);
  }

  .pp-bar-fill.is-good { background: var(--pp-green); }
  .pp-bar-fill.is-bad  { background: var(--pp-red); }

  /* ═══ REDUCED MOTION & PRINT ═══ */
  @media (prefers-reduced-motion: reduce) {
    .pp-output-value, .pp-bar-fill { transition-duration: 0.01ms !important; }
  }

  @media print {
    .pp-slider { display: none; }
    .pp-reset { display: none; }
    .pp-range-labels { display: none; }
    .pp-bar-track { display: none; }
  }
</style>

<script>
  function initPlayground() {
    document.querySelectorAll<HTMLElement>(".pp:not([data-init])").forEach((comp) => {
      comp.setAttribute("data-init", "");

      const paramDefs: {
        name: string; label: string; type: string;
        min?: number; max?: number; step?: number;
        default: number | string; suffix?: string;
        options?: { label: string; value: string | number }[];
      }[] = JSON.parse(comp.dataset.params || "[]");

      const outputDefs: {
        name: string; label: string;
        format?: string; good?: string;
      }[] = JSON.parse(comp.dataset.outputs || "[]");

      const computeBody = comp.dataset.compute || "return {}";

      /* Build the compute function once */
      let computeFn: (params: Record<string, number | string>) => Record<string, number | string>;
      try {
        computeFn = new Function("params", computeBody) as typeof computeFn;
      } catch {
        console.error("[ParameterPlayground] Invalid compute function:", computeBody);
        return;
      }

      const inputs = comp.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-input]");
      const valueDisplays = comp.querySelectorAll<HTMLElement>("[data-value-for]");
      const outDisplays = comp.querySelectorAll<HTMLElement>("[data-out-value]");
      const barFills = comp.querySelectorAll<HTMLElement>("[data-out-bar]");
      const resetBtn = comp.querySelector<HTMLButtonElement>(".pp-reset");

      function gather(): Record<string, number | string> {
        const vals: Record<string, number | string> = {};
        inputs.forEach((el) => {
          const name = el.dataset.input!;
          const def = paramDefs.find((p) => p.name === name);
          if (def?.type === "select") {
            vals[name] = el.value;
          } else {
            vals[name] = parseFloat(el.value) || 0;
          }
        });
        return vals;
      }

      function update() {
        const vals = gather();

        /* Update value displays with pulse animation */
        valueDisplays.forEach((el) => {
          const name = el.dataset.valueFor!;
          const def = paramDefs.find((p) => p.name === name);
          const newText = String(vals[name]) + (def?.suffix || "");
          if (el.textContent !== newText) {
            el.textContent = newText;
            el.classList.add("is-changed");
            setTimeout(() => el.classList.remove("is-changed"), 150);
          }
        });

        /* Compute outputs */
        let results: Record<string, number | string>;
        try {
          results = computeFn(vals);
        } catch {
          return;
        }

        /* Render outputs */
        outDisplays.forEach((el) => {
          const name = el.dataset.outValue!;
          const def = outputDefs.find((o) => o.name === name);
          const raw = results[name];
          if (raw == null) return;

          let display: string;
          if (def?.format === "percent") {
            display = (typeof raw === "number" ? (raw * 100).toFixed(1) : raw) + "%";
          } else if (def?.format === "decimal") {
            display = typeof raw === "number" ? raw.toFixed(2) : String(raw);
          } else if (def?.format === "number") {
            display = typeof raw === "number" ? raw.toLocaleString() : String(raw);
          } else {
            display = String(raw);
          }

          el.textContent = display;

          /* Color coding */
          el.classList.remove("is-good", "is-bad");
          if (typeof raw === "number" && def?.good) {
            if (def.good === "low" && raw <= 0.15) el.classList.add("is-good");
            else if (def.good === "low" && raw > 0.5) el.classList.add("is-bad");
            else if (def.good === "high" && raw >= 0.8) el.classList.add("is-good");
            else if (def.good === "high" && raw < 0.3) el.classList.add("is-bad");
          }
        });

        /* Update visual bars */
        barFills.forEach((bar) => {
          const name = bar.dataset.outBar!;
          const def = outputDefs.find((o) => o.name === name);
          const raw = results[name];
          if (raw == null || typeof raw !== "number") return;

          let pct: number;
          if (def?.format === "percent") {
            pct = Math.min(100, Math.max(0, raw * 100));
          } else {
            pct = Math.min(100, Math.max(0, raw * 100));
          }
          bar.style.width = `${pct}%`;

          bar.classList.remove("is-good", "is-bad");
          if (def?.good) {
            if (def.good === "low" && raw <= 0.15) bar.classList.add("is-good");
            else if (def.good === "low" && raw > 0.5) bar.classList.add("is-bad");
            else if (def.good === "high" && raw >= 0.8) bar.classList.add("is-good");
            else if (def.good === "high" && raw < 0.3) bar.classList.add("is-bad");
          }
        });
      }

      /* Reset button */
      if (resetBtn) {
        resetBtn.addEventListener("click", () => {
          inputs.forEach((el) => {
            const name = el.dataset.input!;
            const def = paramDefs.find((p) => p.name === name);
            if (def) {
              el.value = String(def.default);
            }
          });
          update();
        });
      }

      /* Bind input events */
      inputs.forEach((el) => {
        el.addEventListener("input", update);
      });

      /* Initial compute */
      update();
    });
  }

  initPlayground();
  document.addEventListener("astro:page-load", initPlayground);
</script>
