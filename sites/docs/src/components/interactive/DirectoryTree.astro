---
/**
 * DirectoryTree.astro
 * ───────────────────
 * Premium interactive file/folder directory explorer with side explainer panel.
 *
 * Core Interactive Features:
 *   - Nested folder structures with collapsible interactive tree nodes.
 *   - Auto-generated from flat path lists inside MDX for ease of authoring.
 *   - Hovering nodes displays detailed architectural context inside a glassmorphic Inspector panel.
 *   - Custom file-type and category SVG icons (TS, JSON, modules, packages).
 *   - Fully responsive: side-by-side on wide screens, stacked on mobile.
 */

import DirectoryNode from './DirectoryNode.astro';

interface NodeInput {
  path: string;
  type?: 'file' | 'folder';
  desc?: string;
  color?: string;
}

interface TreeNode {
  name: string;
  type: 'file' | 'folder';
  desc?: string;
  color?: string;
  children?: TreeNode[];
  fullPath: string;
}

interface Props {
  title?: string;
  nodes: NodeInput[];
}

const { title, nodes } = Astro.props;

// Build hierarchical tree structure from flat path list
const rootNode: TreeNode = { name: '.', type: 'folder', fullPath: '.', children: [] };

for (const input of nodes) {
  // Strip leading/trailing slashes
  const cleanPath = input.path.replace(/^\/+|\/+$/g, '');
  const parts = cleanPath.split('/');
  let current = rootNode;

  parts.forEach((part, partIdx) => {
    const isLast = partIdx === parts.length - 1;
    const nodeType: 'file' | 'folder' = isLast ? (input.type || 'file') : 'folder';

    let existing = current.children?.find(c => c.name === part);
    if (!existing) {
      const fullPath = parts.slice(0, partIdx + 1).join('/');
      existing = {
        name: part,
        type: nodeType,
        fullPath,
        desc: isLast ? input.desc : undefined,
        color: isLast ? input.color : undefined,
        children: nodeType === 'folder' ? [] : undefined
      };
      current.children = current.children || [];
      current.children.push(existing);
    } else if (isLast) {
      if (input.desc) existing.desc = input.desc;
      if (input.color) existing.color = input.color;
    }
    current = existing;
  });
}

// Sort tree: Folders first alphabetically, then files alphabetically
function sortTree(node: TreeNode) {
  if (node.children) {
    node.children.sort((a, b) => {
      if (a.type !== b.type) {
        return a.type === 'folder' ? -1 : 1;
      }
      return a.name.localeCompare(b.name);
    });
    node.children.forEach(sortTree);
  }
}
sortTree(rootNode);
---

<div class="dt not-content" data-root={JSON.stringify(rootNode)}>
  {title && (
    <div class="dt-header">
      <span class="dt-title">{title}</span>
      <span class="dt-badge">⬡ File System Explorer</span>
    </div>
  )}

  <div class="dt-layout">
    {/* Left Column: Interactive Collapsible Tree */}
    <div class="dt-tree-container">
      <div class="dt-tree">
        {rootNode.children && rootNode.children.map((child) => (
          <DirectoryNode node={child} depth={0} />
        ))}
      </div>
    </div>

    {/* Right Column: Glassmorphic Inspector Details Panel */}
    <div class="dt-inspector">
      <div class="dt-inspector-inner">
        <div class="dt-inspect-empty">
          <div class="dt-inspect-empty-icon">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <p>Hover over directories or configuration files to inspect their architectural role in the workspace.</p>
        </div>
        <div class="dt-inspect-content" style="display: none;">
          <div class="dt-inspect-header">
            <span class="dt-inspect-type-badge">file</span>
            <h4 class="dt-inspect-name">name</h4>
          </div>
          <div class="dt-inspect-path-row">
            <span class="dt-inspect-path-label">
              <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right: 4px; display: inline-block; vertical-align: middle; opacity: 0.8;">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
              </svg>
              Location / Path
            </span>
            <span class="dt-inspect-path">path</span>
          </div>
          <p class="dt-inspect-desc">description</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .dt {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --dt-text:       var(--sl-color-text);
    --dt-text-faint: var(--sl-color-gray-3);
    --dt-text-ghost: var(--sl-color-gray-4);
    --dt-rule:       var(--sl-color-hairline-shade);
    --dt-accent:     var(--sl-color-accent-high);
    --dt-panel:      rgba(20, 20, 23, 0.4);
    
    margin: 2rem 0;
    background: var(--dt-panel);
    border: 1px solid var(--dt-rule);
    border-radius: 16px;
    overflow: hidden;
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .dt-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--dt-rule);
    background: rgba(10, 10, 12, 0.5);
  }

  .dt-title {
    font-size: var(--sl-text-xs);
    font-weight: 700;
    color: var(--dt-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .dt-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--dt-accent);
    background: color-mix(in srgb, var(--dt-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--dt-accent) 25%, transparent);
    padding: 0.25rem 0.65rem;
    border-radius: 99px;
  }

  .dt-layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    min-height: 420px;
  }

  @media (max-width: 820px) {
    .dt-layout {
      grid-template-columns: 1fr;
    }
    .dt-inspector {
      border-left: none !important;
      border-top: 1px solid var(--dt-rule);
      min-height: 200px;
    }
  }

  /* ═══ Left Side: Tree Explorer ═══ */
  .dt-tree-container {
    padding: 24px;
    overflow-y: auto;
    max-height: 520px;
  }

  .dt-tree {
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    user-select: none;
  }

  .dt-node {
    margin: 2px 0;
  }

  .dt-node-row {
    display: flex;
    align-items: center;
    padding: 6px 8px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 150ms var(--ease-out), color 150ms var(--ease-out);
    color: var(--dt-text-faint);
    position: relative;
  }

  .dt-node-row:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--dt-text);
  }

  .dt-node.is-active > .dt-node-row {
    background: color-mix(in srgb, var(--dt-accent) 8%, rgba(255, 255, 255, 0.03));
    color: var(--sl-color-accent);
    box-shadow: inset 2px 0 0 var(--dt-accent);
  }

  .dt-folder-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    color: var(--dt-text-ghost);
    transition: transform 180ms var(--ease-out), color 150ms var(--ease-out);
    margin-right: 4px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .dt-folder-arrow:hover {
    color: var(--dt-text);
  }

  .dt-node--collapsible:not(.dt-node--open) > .dt-node-row .dt-folder-arrow {
    transform: rotate(-90deg);
  }

  .dt-folder-spacer {
    width: 20px;
    flex-shrink: 0;
  }

  .dt-node-icon {
    margin-right: 8px;
    flex-shrink: 0;
    transition: transform 150ms var(--ease-out);
  }

  .dt-node-row:hover .dt-node-icon {
    transform: scale(1.05);
  }

  .dt-node-icon--folder {
    color: #f59e0b; /* Amber */
  }

  .dt-node-icon--file {
    color: #60a5fa; /* Blue */
  }

  .dt-node-name {
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Dot indicating that node carries a detailed description */
  .dt-node-dot-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--node-color, var(--dt-accent));
    margin-left: 8px;
    opacity: 0.85;
    box-shadow: 0 0 6px var(--node-color, var(--dt-accent));
    transition: background 150ms ease, box-shadow 150ms ease;
  }

  /* Butttery-smooth grid auto-transition */
  .dt-node-children {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 250ms var(--ease-out), opacity 200ms ease;
    opacity: 0;
    overflow: hidden;
  }

  .dt-node--open > .dt-node-children {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .dt-node-children-inner {
    min-height: 0;
    border-left: 1px dashed rgba(255, 255, 255, 0.08);
    margin-left: 20px;
    padding-left: 4px;
    transition: border-color 200ms ease;
  }

  /* Glow guide lines on hover */
  .dt-node:hover > .dt-node-children > .dt-node-children-inner {
    border-left-color: color-mix(in srgb, var(--dt-accent) 40%, rgba(255, 255, 255, 0.1));
  }

  /* ═══ Right Side: Glassmorphic Inspector ═══ */
  .dt-inspector {
    border-left: 1px solid var(--dt-rule);
    background: rgba(10, 10, 12, 0.3);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: stretch;
  }

  .dt-inspector-inner {
    border: 1px solid rgba(255, 255, 255, 0.04);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    padding: 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  /* Empty state */
  .dt-inspect-empty {
    text-align: center;
    color: var(--dt-text-ghost);
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dt-inspect-empty-icon {
    font-size: 2.2rem;
    margin-bottom: 16px;
    color: var(--dt-accent);
    opacity: 0.55;
    animation: pulse-slow 3s infinite ease-in-out;
  }

  .dt-inspect-empty p {
    font-size: 0.72rem;
    line-height: 1.6;
    margin: 0;
    max-width: 220px;
  }

  /* Active Content State */
  .dt-inspect-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
    animation: fade-in 200ms var(--ease-out);
    height: 100%;
    justify-content: flex-start;
  }

  .dt-inspect-header {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .dt-inspect-type-badge {
    font-size: 0.58rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--dt-text-faint);
  }

  .dt-inspect-type-badge.type-folder {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.08);
    border-color: rgba(245, 158, 11, 0.2);
  }

  .dt-inspect-type-badge.type-file {
    color: #60a5fa;
    background: rgba(96, 165, 250, 0.08);
    border-color: rgba(96, 165, 250, 0.2);
  }

  .dt-inspect-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--dt-text);
    margin: 0;
    word-break: break-all;
  }

  .dt-inspect-path-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.65rem;
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    background: rgba(0, 0, 0, 0.25);
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid var(--dt-rule);
    align-items: flex-start;
  }

  .dt-inspect-path-label {
    color: var(--dt-text-ghost);
    font-weight: 700;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
  }

  .dt-inspect-path {
    color: var(--dt-text-faint);
    overflow-wrap: anywhere;
    word-break: break-word;
    width: 100%;
    line-height: 1.4;
  }

  .dt-inspect-desc {
    font-size: 0.75rem;
    color: var(--dt-text-faint);
    line-height: 1.6;
    margin: 0;
    padding-top: 4px;
  }

  /* Animations */
  @keyframes pulse-slow {
    0%, 100% { opacity: 0.45; transform: scale(1); }
    50% { opacity: 0.75; transform: scale(1.05); }
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Disable transitions during initial state restore */
  .dt-no-transition,
  .dt-no-transition * {
    transition: none !important;
    animation: none !important;
  }

  /* Motion & Print */
  @media (prefers-reduced-motion: reduce) {
    .dt-folder-arrow, .dt-node-children, .dt-inspect-empty-icon {
      transition-duration: 0.01ms !important;
      animation: none !important;
    }
  }
</style>

<script>
  function initDirectoryTree() {
    document.querySelectorAll<HTMLElement>('.dt:not([data-init])').forEach((comp, compIdx) => {
      comp.setAttribute('data-init', '');

      // Temporarily disable transitions during initial state restore to prevent FOUC / expand flashes on page load
      comp.classList.add('dt-no-transition');

      const nodeRows = comp.querySelectorAll<HTMLElement>('.dt-node-row');
      const collapsibleNodes = comp.querySelectorAll<HTMLElement>('.dt-node--collapsible');
      const inspectorEmpty = comp.querySelector<HTMLElement>('.dt-inspect-empty')!;
      const inspectorContent = comp.querySelector<HTMLElement>('.dt-inspect-content')!;
      const nameEl = comp.querySelector<HTMLElement>('.dt-inspect-name')!;
      const pathEl = comp.querySelector<HTMLElement>('.dt-inspect-path')!;
      const descEl = comp.querySelector<HTMLElement>('.dt-inspect-desc')!;
      const typeBadge = comp.querySelector<HTMLElement>('.dt-inspect-type-badge')!;

      // ── Restore Collapsible States from localStorage ──
      collapsibleNodes.forEach((node) => {
        const path = node.dataset.path || '';
        if (path) {
          const storageKey = `dt-state:${window.location.pathname}:${compIdx}:${path}`;
          const savedState = localStorage.getItem(storageKey);
          if (savedState === 'open') {
            node.classList.add('dt-node--open');
          } else if (savedState === 'closed') {
            node.classList.remove('dt-node--open');
          }
        }
      });

      // Force layout reflow to apply restored states instantly, then re-enable transition triggers for user clicks
      void comp.offsetHeight;
      comp.classList.remove('dt-no-transition');

      // ── Tree Expansion / Toggling ──
      collapsibleNodes.forEach((node) => {
        const row = node.querySelector<HTMLElement>(':scope > .dt-node-row');
        const arrow = row?.querySelector<HTMLElement>('.dt-folder-arrow');
        
        if (arrow && row) {
          arrow.addEventListener('click', (e) => {
            e.stopPropagation(); // prevent triggering row selection/inspections
            node.classList.toggle('dt-node--open');
            
            const path = node.dataset.path || '';
            if (path) {
              const storageKey = `dt-state:${window.location.pathname}:${compIdx}:${path}`;
              localStorage.setItem(storageKey, node.classList.contains('dt-node--open') ? 'open' : 'closed');
            }
          });
        }
      });

      // ── Inspector Interaction (Hover and Selection) ──
      nodeRows.forEach((row) => {
        const node = row.parentElement as HTMLElement;
        const name = node.dataset.name || '';
        const path = node.dataset.path || '';
        const desc = node.dataset.desc || '';
        const type = node.dataset.type || '';

        function selectNode() {
          // Highlight active node row
          comp.querySelectorAll('.dt-node').forEach(el => el.classList.remove('is-active'));
          node.classList.add('is-active');

          if (desc) {
            inspectorEmpty.style.display = 'none';
            inspectorContent.style.display = 'flex';
            nameEl.textContent = name;
            pathEl.textContent = path;
            descEl.textContent = desc;
            
            // Set type class on badge
            typeBadge.textContent = type;
            typeBadge.className = 'dt-inspect-type-badge';
            typeBadge.classList.add('type-' + type);
          } else {
            // Default to empty state if no description
            inspectorEmpty.style.display = 'flex';
            inspectorContent.style.display = 'none';
          }
        }

        row.addEventListener('mouseenter', selectNode);
        
        // Handle collapsible click on row itself
        row.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          // Toggle folder if clicking the row or arrow/icon/name (but not clicking dot indicator)
          if (node.classList.contains('dt-node--collapsible') && !target.classList.contains('dt-node-dot-indicator')) {
            node.classList.toggle('dt-node--open');
            
            const path = node.dataset.path || '';
            if (path) {
              const storageKey = `dt-state:${window.location.pathname}:${compIdx}:${path}`;
              localStorage.setItem(storageKey, node.classList.contains('dt-node--open') ? 'open' : 'closed');
            }
          }
          selectNode();
        });
      });
    });
  }

  // Bind on load and Astro page transitions
  initDirectoryTree();
  document.addEventListener('astro:page-load', initDirectoryTree);
</script>
