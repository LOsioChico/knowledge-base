---
/**
 * LearningRoadmap — Interactive visual roadmap for learning pathways.
 *
 * Timeline-style checklist with prerequisite chains, completion tracking,
 * prerequisite unlocking, and group progress.
 */

interface RoadmapNode {
  id: string;
  label: string;
  href: string;
  description?: string;
  category: 'required' | 'optional' | 'comparison' | 'reference';
  group: string;
  prereqs?: string[];
}

interface Props {
  nodes: RoadmapNode[];
  title?: string;
  trackId: string;
}

const { nodes, title, trackId } = Astro.props;

const groups: Map<string, RoadmapNode[]> = new Map();
for (const node of nodes) {
  if (!groups.has(node.group)) groups.set(node.group, []);
  groups.get(node.group)!.push(node);
}

const groupEntries = [...groups.entries()];

// Build direct prereq pairs (id → label) for tooltip
function getDirectPrereqs(node: RoadmapNode): {id: string; label: string}[] {
  if (!node.prereqs?.length) return [];
  return node.prereqs
    .map(pid => {
      const p = nodes.find(n => n.id === pid);
      return p ? { id: p.id, label: p.label } : null;
    })
    .filter((x): x is {id: string; label: string} => x !== null);
}
---

<div class="lr not-content" data-track-id={trackId}>
  <div class="lr__top">
    {title && <h3 class="lr__title">{title}</h3>}
    <div class="lr__meta">
      <span class="lr__counter" data-total={nodes.length}>0 / {nodes.length}</span>
      <button class="lr__reset" title="Reset all progress">Reset</button>
    </div>
  </div>

  <div class="lr__bar"><div class="lr__bar-fill"><span class="lr__bar-pct">0%</span></div></div>

  {groupEntries.map(([groupName, groupNodes], gi) => (
    <div class="lr__group" data-group={groupName}>
      <button class="lr__gh" type="button" aria-expanded="true">
        <div class="lr__gh-left">
          <svg class="lr__gh-chevron" viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
            <path d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
          </svg>
          <span class="lr__gh-label">{groupName}</span>
        </div>
        <span class="lr__gh-progress" data-group-total={groupNodes.length}>0/{groupNodes.length}</span>
      </button>
      
      <div class="lr__rows">
        {groupNodes.map((node) => {
          const directPrereqs = getDirectPrereqs(node);
          return (
            <div
              class={`lr__row lr__row--${node.category}`}
              data-id={node.id}
              data-prereqs={node.prereqs?.join(',') || ''}
            >
              <div class="lr__row-checkbox">
                <button class="lr__cb" aria-label={`Mark ${node.label} complete`} title="Toggle completed">
                  <svg viewBox="0 0 20 20" width="100%" height="100%">
                    {/* Tick (visible when is-done) */}
                    <path class="lr__cb-tick" d="M6 10.5 L9 13.5 L14 7.5" />
                    {/* Lock Icon (visible when is-locked) */}
                    <g class="lr__cb-lock">
                      <path d="M7 9.5 V6.5 A3 3 0 0 1 13 6.5 V9.5" />
                      <rect x="5.5" y="9.5" width="9" height="6.5" rx="1.5" />
                    </g>
                  </svg>
                </button>
              </div>
              
              <div class="lr__row-content">
                <div class="lr__top-line">
                  <a class="lr__link" href={node.href}>{node.label}</a>
                  {node.category !== 'required' && (
                    <span class={`lr__tag lr__tag--${node.category}`}>{node.category}</span>
                  )}
                </div>
                {node.description && <div class="lr__desc">{node.description}</div>}
                {directPrereqs.length > 0 && (
                  <div class="lr__prereqs">
                    {directPrereqs.map((p) => (
                      <button class="lr__prereq-pill" data-target={p.id} type="button" title={`Go to ${p.label}`}>{p.label}</button>
                    ))}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
      
      {gi < groupEntries.length - 1 && (
        <div class="lr__sep" aria-hidden="true"><span></span></div>
      )}
    </div>
  ))}
</div>

<style>
  .lr {
    --c-req: #60a5fa;
    --c-opt: #c084fc;
    --c-cmp: #fbbf24;
    --c-ref: #94a3b8;
    --c-done: #34d399;
    --c-lock: #64748b;
    margin: 2rem 0;
  }

  /* ── Top Header ── */
  .lr__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .lr__title {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0;
    background: linear-gradient(135deg, var(--sl-color-white) 30%, var(--sl-color-gray-2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .lr__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .lr__counter {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--sl-color-gray-2);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    font-variant-numeric: tabular-nums;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }
  .lr__reset {
    all: unset !important;
    box-sizing: border-box !important;
    background: none !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: 6px !important;
    color: var(--sl-color-gray-3) !important;
    font-size: 0.62rem !important;
    font-weight: 700 !important;
    padding: 0.2rem 0.5rem !important;
    cursor: pointer !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    transition: all 0.2s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .lr__reset:hover {
    background: rgba(239, 68, 68, 0.1) !important;
    border-color: rgba(239, 68, 68, 0.3) !important;
    color: #ef4444 !important;
  }

  /* ── Progress Bar ── */
  .lr__bar {
    height: 10px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.03);
    position: relative;
  }
  .lr__bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 5px;
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    background: linear-gradient(90deg, var(--c-done) 0%, #10b981 50%, var(--c-req) 100%);
    box-shadow: 0 0 12px rgba(52, 211, 153, 0.5);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .lr__bar-pct {
    font-size: 0.5rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.9);
    padding-right: 4px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s;
    white-space: nowrap;
  }
  .lr__bar-fill[style*="width: 0%"] .lr__bar-pct,
  .lr__bar-fill:not([style]) .lr__bar-pct { opacity: 0; }

  /* ── Group Headers (collapsible) ── */
  .lr__group {
    position: relative;
    padding-left: 0;
    margin-bottom: 0.5rem;
  }

  .lr__gh {
    all: unset !important;
    box-sizing: border-box !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
    padding: 0.6rem 0.2rem !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
    margin-bottom: 0.6rem !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    border-radius: 4px !important;
  }
  .lr__gh:hover {
    background: rgba(255, 255, 255, 0.02) !important;
  }
  .lr__gh-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lr__gh-chevron {
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    color: var(--sl-color-gray-4);
    flex-shrink: 0;
  }
  .lr__gh[aria-expanded="true"] .lr__gh-chevron {
    transform: rotate(90deg);
  }
  .lr__gh-label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--sl-color-gray-2);
    text-transform: uppercase;
  }
  .lr__gh-progress {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--sl-color-gray-3);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    font-variant-numeric: tabular-nums;
  }

  /* Collapsed rows */
  .lr__rows {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow: hidden;
    padding: 6px 4px;
    margin: -6px -4px;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.25s ease;
  }
  .lr__group.is-collapsed .lr__rows {
    max-height: 0 !important;
    opacity: 0;
    pointer-events: none;
  }
  .lr__group.is-collapsed .lr__gh {
    margin-bottom: 0 !important;
    border-bottom-color: transparent !important;
  }

  .lr__sep {
    display: flex;
    padding: 0.6rem 0;
    margin-left: 10px;
  }
  .lr__sep span {
    width: 2px;
    height: 20px;
    display: block;
    background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.08) 0 3px, transparent 3px 6px);
  }

  /* ── Timeline Rows & Cards ── */
  .lr__row {
    --rc: var(--c-req);
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    position: relative;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lr__row--required  { --rc: var(--c-req); }
  .lr__row--optional  { --rc: var(--c-opt); }
  .lr__row--comparison { --rc: var(--c-cmp); }
  .lr__row--reference { --rc: var(--c-ref); }

  /* ── Timeline Checkbox Column ── */
  .lr__row-checkbox {
    width: 22px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 11px;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    align-self: stretch;
  }
  .lr__row-checkbox::before {
    content: '';
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: 10px;
    width: 2px;
    background: rgba(255, 255, 255, 0.08);
    z-index: 1;
    pointer-events: none;
    transition: background 0.25s ease;
  }
  .lr__row:first-child .lr__row-checkbox::before {
    top: 22px;
  }
  .lr__row:last-child .lr__row-checkbox::before {
    bottom: calc(100% - 22px);
  }

  .lr__cb {
    all: unset !important;
    box-sizing: border-box !important;
    background: rgba(15, 23, 42, 0.95) !important;
    border: 2px solid rgba(255, 255, 255, 0.15) !important;
    border-radius: 50% !important;
    width: 22px !important;
    height: 22px !important;
    padding: 0 !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    z-index: 2 !important;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: 0 0 0 0px transparent !important;
    color: var(--rc) !important;
  }
  .lr__cb:hover {
    border-color: var(--rc) !important;
    box-shadow: 0 0 8px color-mix(in srgb, var(--rc) 40%, transparent) !important;
    transform: scale(1.05) !important;
  }

  /* Tick SVG path */
  .lr__cb-tick {
    fill: none;
    stroke: #ffffff;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transform: scale(0.6);
    transform-origin: center;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Lock SVG group */
  .lr__cb-lock {
    fill: none;
    stroke: var(--c-lock);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transform: scale(0.8);
    transform-origin: center;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .lr__cb-lock rect {
    fill: var(--c-lock);
  }

  /* ── Node Detail Card ── */
  .lr__row-content {
    flex-grow: 1;
    background: rgba(30, 41, 59, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-left: 4px solid var(--rc);
    border-radius: 12px;
    padding: 0.8rem 1.2rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* Card content hover states */
  .lr__row.is-hovered .lr__row-content {
    background: rgba(30, 41, 59, 0.45);
    border-color: rgba(255, 255, 255, 0.1);
    border-left-color: var(--rc);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 0 15px color-mix(in srgb, var(--rc) 15%, transparent);
  }
  .lr__row.is-hovered .lr__row-checkbox::before {
    background: rgba(255, 255, 255, 0.16);
  }

  /* ── Completion State ── */
  .lr__row.is-done .lr__cb {
    background: linear-gradient(135deg, #10b981, #059669) !important;
    border-color: #10b981 !important;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.4) !important;
    color: #ffffff !important;
  }
  .lr__row.is-done .lr__cb-tick {
    opacity: 1;
    transform: scale(1);
  }
  .lr__row.is-done .lr__row-content {
    background: rgba(16, 185, 129, 0.02);
    border-color: rgba(16, 185, 129, 0.08);
    border-left-color: var(--c-done);
  }
  .lr__row.is-done.is-hovered .lr__row-content {
    border-left-color: var(--c-done);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 0 15px rgba(16, 185, 129, 0.15);
  }
  .lr__row.is-done .lr__link {
    text-decoration: line-through;
    text-decoration-color: rgba(16, 185, 129, 0.3);
    color: var(--sl-color-gray-3);
    opacity: 0.7;
  }
  .lr__row.is-done .lr__desc {
    opacity: 0.65;
  }

  /* ── Locked State: compact card ── */
  .lr__row.is-locked .lr__cb {
    background: rgba(100, 116, 139, 0.05) !important;
    border-color: rgba(100, 116, 139, 0.25) !important;
    color: var(--c-lock) !important;
  }
  .lr__row.is-locked .lr__cb-lock {
    opacity: 1;
    transform: scale(1);
  }
  .lr__row.is-locked .lr__cb:hover {
    border-color: var(--c-lock) !important;
    background: rgba(100, 116, 139, 0.1) !important;
    box-shadow: 0 0 8px rgba(100, 116, 139, 0.2) !important;
  }
  .lr__row.is-locked .lr__row-content {
    background: rgba(30, 41, 59, 0.08);
    border-color: rgba(255, 255, 255, 0.03);
    border-left-color: color-mix(in srgb, var(--rc) 20%, transparent);
    opacity: 0.45;
  }
  /* Hover state for locked card — changes only opacity & background, no layout shifting */
  .lr__row.is-locked:hover .lr__row-content {
    opacity: 0.75;
    background: rgba(30, 41, 59, 0.2);
    border-color: rgba(255, 255, 255, 0.06);
    border-left-color: color-mix(in srgb, var(--rc) 40%, transparent);
  }
  .lr__row.is-locked .lr__link {
    color: var(--sl-color-gray-3);
  }


  /* ── "Start here" indicator ── */
  @keyframes lr-start-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--rc) 30%, transparent); }
    50% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--rc) 10%, transparent); }
  }
  .lr__row.is-next .lr__row-content {
    border-color: color-mix(in srgb, var(--rc) 40%, transparent);
    border-left-color: var(--rc);
    background: rgba(30, 41, 59, 0.35);
    animation: lr-start-pulse 2.5s ease-in-out infinite;
  }
  .lr__row.is-next .lr__cb {
    border-color: var(--rc) !important;
    box-shadow: 0 0 6px color-mix(in srgb, var(--rc) 30%, transparent) !important;
  }

  /* ── Unlocked unchecked state (interactive tick preview) ── */
  .lr__row.is-unlocked:not(.is-done) .lr__cb:hover .lr__cb-tick {
    opacity: 0.45;
    transform: scale(0.85);
    stroke: var(--rc);
  }

  /* ── Header details line ── */
  .lr__top-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .lr__link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--sl-color-white);
    text-decoration: none;
    transition: color 0.2s;
    line-height: 1.3;
  }
  .lr__row:hover .lr__link {
    color: var(--rc);
  }
  .lr__row.is-done:hover .lr__link {
    color: var(--c-done);
  }

  .lr__tag {
    font-size: 0.55rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    line-height: 1.5;
    flex-shrink: 0;
  }
  .lr__tag--optional {
    color: var(--c-opt);
    background: rgba(192, 132, 252, 0.1);
    border: 1px solid rgba(192, 132, 252, 0.15);
  }
  .lr__tag--comparison {
    color: var(--c-cmp);
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.15);
  }
  .lr__tag--reference {
    color: var(--c-ref);
    background: rgba(148, 163, 184, 0.1);
    border: 1px solid rgba(148, 163, 184, 0.15);
  }

  .lr__desc {
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    line-height: 1.4;
  }

  /* ── Prerequisites list section ── */
  .lr__prereqs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
    padding-top: 0.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .lr__prereq-pill {
    all: unset !important;
    box-sizing: border-box !important;
    height: 20px !important;
    font-size: 0.6rem !important;
    font-weight: 600 !important;
    font-family: inherit !important;
    padding: 0 0.45rem !important;
    border-radius: 6px !important;
    cursor: pointer !important;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.2rem !important;
    color: var(--sl-color-gray-3) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    background: rgba(255, 255, 255, 0.02) !important;
  }
  .lr__prereq-pill:hover {
    color: #ffffff !important;
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
  }

  /* Completed pill state */
  .lr__prereq-pill.is-pill-done {
    color: var(--c-done) !important;
    border: 1px solid rgba(52, 211, 153, 0.18) !important;
    background: rgba(52, 211, 153, 0.03) !important;
  }
  .lr__prereq-pill.is-pill-done:hover {
    color: #ffffff !important;
    background: var(--c-done) !important;
    border-color: var(--c-done) !important;
    box-shadow: 0 0 10px rgba(52, 211, 153, 0.3) !important;
  }
  .lr__prereq-pill.is-pill-done::before {
    content: '✓';
    font-weight: 800;
  }

  /* Uncompleted pill — needs attention */
  .lr__prereq-pill:not(.is-pill-done) {
    color: var(--sl-color-gray-4) !important;
  }

  /* ── Interactive Focus States (Hover Focus Effect) ── */
  .lr__row.is-prereq-hl .lr__row-content {
    border-color: var(--rc);
    background: rgba(30, 41, 59, 0.35);
    box-shadow: 0 4px 15px -2px rgba(0, 0, 0, 0.25), 0 0 12px color-mix(in srgb, var(--rc) 10%, transparent);
  }
  .lr__row.is-dim {
    opacity: 0.3;
  }

  /* ── Animations ── */
  @keyframes lr-shake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-4px); }
    40%, 80% { transform: translateX(4px); }
  }
  .lr__row-content.is-shake {
    animation: lr-shake 0.38s cubic-bezier(.36,.07,.19,.97) both;
  }

  @keyframes lr-flash {
    0%, 100% { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); border-color: rgba(255, 255, 255, 0.05); }
    50% {
      border-color: var(--rc);
      box-shadow: 0 0 20px color-mix(in srgb, var(--rc) 45%, transparent);
      background: rgba(30, 41, 59, 0.5);
    }
  }
  .lr__row.is-flash .lr__row-content {
    animation: lr-flash 0.6s ease 2;
  }

  @keyframes lr-pill-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); box-shadow: 0 0 10px var(--c-lock); border-color: var(--c-lock); }
  }
  .lr__prereq-pill.is-prereq-flash {
    animation: lr-pill-pulse 0.4s ease 2;
  }

  /* Responsive styling */
  @media (max-width: 600px) {
    .lr__row {
      gap: 0.6rem;
    }
    .lr__row-content {
      padding: 0.6rem 0.8rem;
    }
    .lr__tag {
      display: none;
    }
    /* Keep locked cards always compact on mobile (no hover expand) */
    .lr__row.is-locked:hover .lr__desc,
    .lr__row.is-locked:hover .lr__prereqs {
      max-height: 0;
      opacity: 0;
    }
  }
</style>

<script>
  function initRoadmaps() {
    document.querySelectorAll<HTMLElement>('.lr').forEach((rm) => {
      const trackId = rm.dataset.trackId || 'default';
      const key = `kb-roadmap-${trackId}`;
      const rows = rm.querySelectorAll<HTMLElement>('.lr__row');
      const total = rows.length;

      // Get all transitive prereqs
      const allPrereqs = (id: string, v = new Set<string>()): Set<string> => {
        const el = rm.querySelector<HTMLElement>(`[data-id="${id}"]`);
        if (!el) return v;
        for (const p of (el.dataset.prereqs || '').split(',').filter(Boolean)) {
          if (!v.has(p)) { v.add(p); allPrereqs(p, v); }
        }
        return v;
      };

      // Get all transitive dependents
      const allDependents = (id: string, v = new Set<string>()): Set<string> => {
        rows.forEach(r => {
          const rid = r.dataset.id || '';
          const pids = (r.dataset.prereqs || '').split(',').filter(Boolean);
          if (pids.includes(id) && !v.has(rid)) {
            v.add(rid);
            allDependents(rid, v);
          }
        });
        return v;
      };

      const save = (s: Set<string>) => localStorage.setItem(key, JSON.stringify([...s]));

      const load = (): Set<string> => {
        try {
          const r = localStorage.getItem(key);
          const done = new Set<string>(r ? (JSON.parse(r) as string[]) : []);
          
          let changed = false;
          done.forEach(id => {
            const prereqs = allPrereqs(id);
            for (const pid of prereqs) {
              if (!done.has(pid)) {
                done.add(pid);
                changed = true;
              }
            }
          });
          
          if (changed) {
            save(done);
          }
          return done;
        }
        catch { return new Set<string>(); }
      };

      const render = (done: Set<string>) => {
        const n = done.size;
        const pct = total ? Math.round((n / total) * 100) : 0;
        const fill = rm.querySelector<HTMLElement>('.lr__bar-fill');
        const ctr = rm.querySelector<HTMLElement>('.lr__counter');
        const pctEl = rm.querySelector<HTMLElement>('.lr__bar-pct');
        if (fill) fill.style.width = `${total ? (n / total) * 100 : 0}%`;
        if (ctr) ctr.textContent = `${n} / ${total}`;
        if (pctEl) {
          pctEl.textContent = `${pct}%`;
          pctEl.style.opacity = pct > 0 ? '1' : '0';
        }

        // Per-group progress
        rm.querySelectorAll<HTMLElement>('.lr__group').forEach(grp => {
          const groupRows = grp.querySelectorAll<HTMLElement>('.lr__row');
          let groupDone = 0;
          groupRows.forEach(r => { if (done.has(r.dataset.id || '')) groupDone++; });
          const progEl = grp.querySelector<HTMLElement>('.lr__gh-progress');
          if (progEl) progEl.textContent = `${groupDone}/${progEl.dataset.groupTotal || groupRows.length}`;
        });

        // Track if we've found the "next" node
        let foundNext = false;

        // Update row states
        rows.forEach(r => {
          const id = r.dataset.id || '';
          const isDone = done.has(id);
          r.classList.toggle('is-done', isDone);
          r.classList.remove('is-next');

          const prereqs = (r.dataset.prereqs || '').split(',').filter(Boolean);
          if (prereqs.length > 0) {
            const allPrereqsDone = prereqs.every(pid => done.has(pid));
            r.classList.toggle('is-unlocked', allPrereqsDone || isDone);
            r.classList.toggle('is-locked', !allPrereqsDone && !isDone);

            // Mark first unlocked-but-not-done as "next"
            if (!foundNext && allPrereqsDone && !isDone) {
              r.classList.add('is-next');
              foundNext = true;
            }
          } else {
            r.classList.remove('is-locked');
            r.classList.add('is-unlocked');
            // No-prereq node can be "next" if not done
            if (!foundNext && !isDone) {
              r.classList.add('is-next');
              foundNext = true;
            }
          }
        });

        // Update prereq pills done state
        rm.querySelectorAll<HTMLButtonElement>('.lr__prereq-pill').forEach(pill => {
          const targetId = pill.dataset.target || '';
          pill.classList.toggle('is-pill-done', done.has(targetId));
        });

        // Auto-collapse groups that are fully locked
        rm.querySelectorAll<HTMLElement>('.lr__group').forEach(grp => {
          const groupRows = grp.querySelectorAll<HTMLElement>('.lr__row');
          const ghBtn = grp.querySelector<HTMLButtonElement>('.lr__gh');
          let hasUnlockedOrDone = false;
          groupRows.forEach(r => {
            if (r.classList.contains('is-unlocked') || r.classList.contains('is-done')) {
              hasUnlockedOrDone = true;
            }
          });
          // Only auto-collapse if ALL items in group are locked
          if (!hasUnlockedOrDone && groupRows.length > 0) {
            grp.classList.add('is-collapsed');
            if (ghBtn) ghBtn.setAttribute('aria-expanded', 'false');
          } else {
            grp.classList.remove('is-collapsed');
            if (ghBtn) ghBtn.setAttribute('aria-expanded', 'true');
          }
        });

        // Set max-height for expanded rows containers
        rm.querySelectorAll<HTMLElement>('.lr__group:not(.is-collapsed) .lr__rows').forEach(rowsEl => {
          rowsEl.style.maxHeight = rowsEl.scrollHeight + 'px';
        });
      };

      // Group header click → toggle collapse
      rm.querySelectorAll<HTMLButtonElement>('.lr__gh').forEach(ghBtn => {
        ghBtn.addEventListener('click', () => {
          const grp = ghBtn.closest<HTMLElement>('.lr__group');
          if (!grp) return;
          const isCollapsed = grp.classList.contains('is-collapsed');
          grp.classList.toggle('is-collapsed', !isCollapsed);
          ghBtn.setAttribute('aria-expanded', isCollapsed ? 'true' : 'false');
          if (isCollapsed) {
            const rowsEl = grp.querySelector<HTMLElement>('.lr__rows');
            if (rowsEl) rowsEl.style.maxHeight = rowsEl.scrollHeight + 'px';
          }
        });
      });

      // Checkbox click
      rm.querySelectorAll<HTMLButtonElement>('.lr__cb').forEach(btn => {
        btn.addEventListener('click', e => {
          e.preventDefault(); e.stopPropagation();
          const row = btn.closest<HTMLElement>('.lr__row');
          if (!row) return;
          const id = row.dataset.id || '';
          const done = load();

          const isCurrentlyDone = done.has(id);
          const newlyCompleted = new Set<string>();

          if (!isCurrentlyDone) {
            newlyCompleted.add(id);
            done.add(id);
            const prereqs = allPrereqs(id);
            for (const pid of prereqs) {
              if (!done.has(pid)) {
                newlyCompleted.add(pid);
                done.add(pid);
              }
            }

            save(done);
            render(done);

            newlyCompleted.forEach(nodeId => {
              const el = rm.querySelector<HTMLElement>(`[data-id="${nodeId}"]`);
              if (el) {
                el.classList.remove('is-flash');
                void el.offsetWidth;
                el.classList.add('is-flash');
                el.addEventListener('animationend', () => el.classList.remove('is-flash'), { once: true });
              }
            });
          } else {
            const dependents = allDependents(id);
            done.delete(id);
            for (const depId of dependents) {
              done.delete(depId);
            }

            save(done);
            render(done);
          }
        });
      });

      // Hover highlighting (focus effect)
      rows.forEach(row => {
        row.addEventListener('mouseenter', () => {
          const id = row.dataset.id || '';
          const pids = allPrereqs(id);
          rows.forEach(r => {
            const rid = r.dataset.id || '';
            if (rid === id) {
              r.classList.add('is-hovered');
              r.classList.remove('is-dim');
            } else if (pids.has(rid)) {
              r.classList.add('is-prereq-hl');
              r.classList.remove('is-dim');
            } else {
              r.classList.add('is-dim');
              r.classList.remove('is-prereq-hl', 'is-hovered');
            }
          });
        });
        row.addEventListener('mouseleave', () => {
          rows.forEach(r => r.classList.remove('is-prereq-hl', 'is-hovered', 'is-dim'));
        });
      });

      // Prereq pill click → scroll + flash
      rm.querySelectorAll<HTMLButtonElement>('.lr__prereq-pill').forEach(btn => {
        btn.addEventListener('click', e => {
          e.preventDefault(); e.stopPropagation();
          const tid = btn.dataset.target;
          if (!tid) return;
          const target = rm.querySelector<HTMLElement>(`[data-id="${tid}"]`);
          if (!target) return;

          // Expand the target's group if collapsed
          const targetGroup = target.closest<HTMLElement>('.lr__group');
          if (targetGroup?.classList.contains('is-collapsed')) {
            targetGroup.classList.remove('is-collapsed');
            const ghBtn = targetGroup.querySelector<HTMLButtonElement>('.lr__gh');
            if (ghBtn) ghBtn.setAttribute('aria-expanded', 'true');
            const rowsEl = targetGroup.querySelector<HTMLElement>('.lr__rows');
            if (rowsEl) rowsEl.style.maxHeight = rowsEl.scrollHeight + 'px';
          }

          rows.forEach(r => r.classList.remove('is-prereq-hl', 'is-hovered', 'is-dim'));
          // Small delay to let expand animation finish
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            target.classList.remove('is-flash');
            void target.offsetWidth;
            target.classList.add('is-flash');
            target.addEventListener('animationend', () => target.classList.remove('is-flash'), { once: true });
          }, 50);
        });
      });

      // Reset
      rm.querySelector('.lr__reset')?.addEventListener('click', () => {
        localStorage.removeItem(key); render(new Set());
      });

      render(load());
    });
  }

  initRoadmaps();
  document.addEventListener('astro:after-swap', initRoadmaps);
</script>
