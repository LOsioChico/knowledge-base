</style>

<script>
  function initPolicyEvaluator() {
    document.querySelectorAll<HTMLElement>('.pe:not([data-init])').forEach((comp) => {
      comp.setAttribute('data-init', '');

      // Concept Tour Guide Elements
      const tourPrev = comp.querySelector<HTMLButtonElement>('#pe-tour-prev')!;
      const tourNext = comp.querySelector<HTMLButtonElement>('#pe-tour-next')!;
      const tourStepIndicator = comp.querySelector<HTMLElement>('#pe-tour-step')!;
      const tourDesc = comp.querySelector<HTMLElement>('#pe-tour-desc')!;

      // Controls
      const modeButtons = comp.querySelectorAll<HTMLButtonElement>('#pe-mode-toggle button');
      const dropdowns = comp.querySelectorAll<HTMLElement>('.pe-dropdown');
      
      // Visual Gates
      const gateScp = comp.querySelector<HTMLElement>('#gate-scp')!;
      const gateDeny = comp.querySelector<HTMLElement>('#gate-deny')!;
      const gateAuth = comp.querySelector<HTMLElement>('#gate-auth')!;
      const gateBoundary = comp.querySelector<HTMLElement>('#gate-boundary')!;

      // Visual Gate Status Elements
      const statusScp = comp.querySelector<HTMLElement>('#status-scp')!;
      const statusDeny = comp.querySelector<HTMLElement>('#status-deny')!;
      const statusAuth = comp.querySelector<HTMLElement>('#status-auth')!;
      const statusBoundary = comp.querySelector<HTMLElement>('#status-boundary')!;

      // Visual Gate Description Elements
      const descScp = comp.querySelector<HTMLElement>('#desc-scp')!;
      const descDeny = comp.querySelector<HTMLElement>('#desc-deny')!;
      const descAuth = comp.querySelector<HTMLElement>('#desc-auth')!;
      const descBoundary = comp.querySelector<HTMLElement>('#desc-boundary')!;

      // Dynamic pipeline track and branch components
      const trackLine = comp.querySelector<HTMLElement>('#pe-track-line')!;
      const branchContainer = comp.querySelector<HTMLElement>('#pe-branch-container')!;
      const branchIdentity = comp.querySelector<HTMLElement>('#pe-branch-identity')!;
      const branchResource = comp.querySelector<HTMLElement>('#pe-branch-resource')!;
      const badgeIdentity = comp.querySelector<HTMLElement>('#pe-badge-identity')!;
      const badgeResource = comp.querySelector<HTMLElement>('#pe-badge-resource')!;
      const branchOp = comp.querySelector<HTMLElement>('#pe-branch-op')!;

      // Result Box
      const resultBanner = comp.querySelector<HTMLElement>('#pe-result-banner')!;
      const verdictTitle = comp.querySelector<HTMLElement>('#pe-verdict-title')!;
      const verdictReason = comp.querySelector<HTMLElement>('#pe-verdict-reason')!;
      const badgeAuthMode = comp.querySelector<HTMLElement>('#badge-auth-mode')!;
      const titleAuth = comp.querySelector<HTMLElement>('#title-auth')!;

      // Current State
      let activeMode: 'same' | 'cross' = 'same';
      const layerStates: Record<string, 'allow' | 'deny' | 'none'> = {
        scp: 'allow',
        identity: 'allow',
        resource: 'none',
        boundary: 'allow'
      };

      // Helper to check dropdown click outside
      function closeAllDropdowns() {
        dropdowns.forEach(dd => dd.setAttribute('aria-expanded', 'false'));
      }

      function setControlValue(dd: HTMLElement, val: string) {
        const valueEl = dd.querySelector<HTMLElement>('.pe-dropdown-value');
        if (valueEl) {
          const option = dd.querySelector<HTMLElement>(`.pe-dropdown-option[data-value="${val}"]`);
          if (option) {
            valueEl.textContent = option.textContent || '';
          }
        }
        dd.querySelectorAll<HTMLElement>('.pe-dropdown-option').forEach((o) => {
          const isActive = o.dataset.value === val;
          o.classList.toggle('pe-dropdown-option--active', isActive);
          o.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      }

      /* ── Setup Presets ── */
      const presetButtons = comp.querySelectorAll<HTMLButtonElement>('.pe-preset-btn');
      
      const PRESETS: Record<string, { mode: 'same' | 'cross'; scp: 'allow'|'deny'|'none'; identity: 'allow'|'deny'|'none'; resource: 'allow'|'deny'|'none'; boundary: 'allow'|'deny'|'none' }> = {
        'same-identity': { mode: 'same', scp: 'allow', identity: 'allow', resource: 'none', boundary: 'allow' },
        'explicit-deny': { mode: 'same', scp: 'allow', identity: 'allow', resource: 'deny', boundary: 'allow' },
        'cross-missing': { mode: 'cross', scp: 'allow', identity: 'allow', resource: 'none', boundary: 'allow' },
        'cross-success': { mode: 'cross', scp: 'allow', identity: 'allow', resource: 'allow', boundary: 'allow' },
        'boundary-blocked': { mode: 'same', scp: 'allow', identity: 'allow', resource: 'none', boundary: 'none' },
        'scp-blocked': { mode: 'same', scp: 'deny', identity: 'allow', resource: 'none', boundary: 'allow' }
      };

      let activeTab: 'scp' | 'identity' | 'resource' | 'boundary' = 'scp';
      
      const jsonTabs = comp.querySelectorAll<HTMLButtonElement>('.pe-json-tab');
      const jsonCode = comp.querySelector<HTMLElement>('#pe-json-code code')!;

      // Dynamic JSON Template Generators
      function generateJson(layer: 'scp' | 'identity' | 'resource' | 'boundary', state: 'allow' | 'deny' | 'none') {
        if (layer === 'scp') {
          if (state === 'allow') {
            return `{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAllActions",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    }
  ]
}`;
          } else if (state === 'deny') {
            return `{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyS3ReadInThisAccount",
      "Effect": "Deny",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::company-records/*"
    }
  ]
}`;
          } else {
            return `{
  "Version": "2012-10-17",
  "Statement": []
}`;
          }
        } else if (layer === 'identity') {
          if (state === 'allow') {
            return `{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowIdentityS3Read",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::company-records/*"
    }
  ]
}`;
          } else if (state === 'deny') {
            return `{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyIdentityS3Read",
      "Effect": "Deny",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::company-records/*"
    }
  ]
}`;
          } else {
            return `{
  "Version": "2012-10-17",
  "Statement": []
}`;
          }
        } else if (layer === 'resource') {
          if (state === 'allow') {
            return `{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBucketCrossAccountRead",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111122223333:role/AppRole"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::company-records/*"
    }
  ]
}`;
          } else if (state === 'deny') {
            return `{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyBucketAllRead",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::company-records/*"
    }
  ]
}`;
          } else {
            return `/* No S3 bucket policy is attached */
{}`;
          }
        } else if (layer === 'boundary') {
          if (state === 'allow') {
            return `{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAllActionsCeiling",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    }
  ]
}`;
          } else if (state === 'none') {
            return `{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RestrictToNonReadS3",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": "*"
    }
  ]
}`;
          } else {
            return `{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExplicitDenyCeiling",
      "Effect": "Deny",
      "Action": "s3:GetObject",
      "Resource": "*"
    }
  ]
}`;
          }
        }
        return '{}';
      }

      function syntaxHighlightJson(jsonStr: string) {
        let escaped = jsonStr
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
        
        return escaped.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*")(\s*:)?|(-?\d+(?:\.\d*)?(?:[eE][+-]?\d+)?|true|false|null)/g, (match, stringVal, _escInner, isKey) => {
          if (stringVal) {
            if (isKey) {
              return `<span class="j-key">${stringVal}</span>${isKey}`;
            } else {
              if (stringVal === '"Allow"') {
                return '<span class="j-kw-allow">"Allow"</span>';
              } else if (stringVal === '"Deny"') {
                return '<span class="j-kw-deny">"Deny"</span>';
              }
              return `<span class="j-str">${stringVal}</span>`;
            }
          }
          return match;
        });
      }

      function renderActiveJson() {
        const rawVal = layerStates[activeTab];
        const json = generateJson(activeTab, rawVal);
        jsonCode.innerHTML = syntaxHighlightJson(json);
      }

      // Tab selector listeners
      jsonTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          jsonTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          activeTab = tab.dataset.tab as 'scp' | 'identity' | 'resource' | 'boundary';
          renderActiveJson();
        });
      });

      // Guided Concept Tour Definitions
      const TOUR_STEPS = [
        {
          title: "1 of 5: Default Deny",
          desc: "AWS blocks everything by default. Without an explicit Allow statement in any of your policies, the request is implicitly denied at Gate 3.",
          state: { mode: 'same', scp: 'allow', identity: 'none', resource: 'none', boundary: 'allow' }
        },
        {
          title: "2 of 5: Explicit Deny Wins",
          desc: "An Explicit Deny statement ALWAYS wins over any Allows. Here, although Identity allows GetObject, S3 bucket resource policy explicitly denies it, halting evaluation immediately at Gate 2.",
          state: { mode: 'same', scp: 'allow', identity: 'allow', resource: 'deny', boundary: 'allow' }
        },
        {
          title: "3 of 5: Same-Account Union",
          desc: "For requests inside the same AWS account, identity policies and resource policies form a Union. You only need an Allow from EITHER side to pass Gate 3 successfully!",
          state: { mode: 'same', scp: 'allow', identity: 'allow', resource: 'none', boundary: 'allow' }
        },
        {
          title: "4 of 5: Cross-Account Intersection",
          desc: "Across accounts, both accounts must agree. The source account must allow the role to act, AND the target bucket policy must trust/allow the caller. It is an Intersection!",
          state: { mode: 'cross', scp: 'allow', identity: 'allow', resource: 'none', boundary: 'allow' }
        },
        {
          title: "5 of 5: Permissions Boundary Ceiling",
          desc: "A Permissions Boundary limits the maximum access a principal can have. Since GetObject is not allowed in the boundary, the request is blocked at Gate 4, even though Identity policy allowed it.",
          state: { mode: 'same', scp: 'allow', identity: 'allow', resource: 'none', boundary: 'none' }
        }
      ];

      let currentStep = 0;

      function renderTourStep(stepIndex: number) {
        currentStep = stepIndex;
        const step = TOUR_STEPS[currentStep];

        // Update Nav Buttons
        tourPrev.disabled = currentStep === 0;
        tourNext.textContent = currentStep === TOUR_STEPS.length - 1 ? "Restart ↺" : "Next Step →";

        // Update Text
        tourStepIndicator.textContent = `Step ${step.title}`;
        tourDesc.textContent = step.desc;

        // Apply Configuration
        activeMode = step.state.mode as 'same' | 'cross';
        
        // Update Account Mode toggle buttons visually
        modeButtons.forEach(b => {
          const isActive = b.dataset.mode === activeMode;
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-checked', isActive ? 'true' : 'false');
        });

        // Update dropdown layer states
        Object.entries(step.state).forEach(([layer, val]) => {
          if (layer !== 'mode') {
            layerStates[layer] = val as 'allow' | 'deny' | 'none';
            const dd = comp.querySelector<HTMLElement>(`.pe-dropdown[data-layer="${layer}"]`)!;
            setControlValue(dd, val);
          }
        });

        // Run evaluation
        evaluatePolicy();
      }

      tourPrev.addEventListener('click', () => {
        if (currentStep > 0) {
          renderTourStep(currentStep - 1);
        }
      });

      tourNext.addEventListener('click', () => {
        if (currentStep < TOUR_STEPS.length - 1) {
          renderTourStep(currentStep + 1);
        } else {
          renderTourStep(0); // Restart
        }
      });

      // Pause tour indicator if user manual clicks presets or dials
      function pauseTour() {
        tourStepIndicator.textContent = "Sandbox Play Mode 🎮";
        tourDesc.textContent = "You are actively playing with the manual dials. Click 'Restart Tour 🎓' or use the Prev/Next buttons to resume the guided concept tour!";
        tourPrev.disabled = true;
        tourNext.textContent = "Restart Tour 🎓";
        currentStep = TOUR_STEPS.length;
      }

      // Preset button listener setup
      presetButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          presetButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          pauseTour();

          const preset = PRESETS[btn.dataset.preset!];
          if (preset) {
            // Update Active Mode toggle
            modeButtons.forEach(b => {
              const isActive = b.dataset.mode === preset.mode;
              b.classList.toggle('active', isActive);
              b.setAttribute('aria-checked', isActive ? 'true' : 'false');
            });
            activeMode = preset.mode;

            // Update dropdown values
            dropdowns.forEach(dd => {
              const layerName = dd.dataset.layer!;
              const targetVal = preset[layerName as 'scp' | 'identity' | 'resource' | 'boundary'];
              layerStates[layerName] = targetVal;
              setControlValue(dd, targetVal);
            });

            evaluatePolicy();
          }
        });
      });

      // Deactivate presets if user manually alters any individual drop-down or toggle button
      function deactivatePresets() {
        presetButtons.forEach(b => b.classList.remove('active'));
        pauseTour();
      }

      modeButtons.forEach(b => b.addEventListener('click', deactivatePresets));
      dropdowns.forEach(dd => dd.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.pe-dropdown-option')) {
          deactivatePresets();
        }
      }));

      /* ── Setup Mode Toggle ── */
      modeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          modeButtons.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-checked', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-checked', 'true');
          activeMode = btn.dataset.mode as 'same' | 'cross';
          
          evaluatePolicy();
        });
      });

      /* ── Setup Select Dropdowns ── */
      dropdowns.forEach((dd) => {
        const valueEl = dd.querySelector<HTMLElement>('.pe-dropdown-value')!;
        const optionEls = dd.querySelectorAll<HTMLElement>('.pe-dropdown-option');
        const layerName = dd.dataset.layer!;

        dd.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const option = target.closest<HTMLElement>('.pe-dropdown-option');
          if (option) {
            const val = option.dataset.value as 'allow' | 'deny' | 'none';
            valueEl.textContent = option.textContent || '';
            optionEls.forEach((o) => {
              o.classList.toggle('pe-dropdown-option--active', o === option);
              o.setAttribute('aria-selected', o === option ? 'true' : 'false');
            });
            dd.setAttribute('aria-expanded', 'false');
            
            layerStates[layerName] = val;
            evaluatePolicy();
          } else {
            const open = dd.getAttribute('aria-expanded') === 'true';
            closeAllDropdowns();
            dd.setAttribute('aria-expanded', open ? 'false' : 'true');
          }
        });

        dd.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') dd.setAttribute('aria-expanded', 'false');
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const open = dd.getAttribute('aria-expanded') === 'true';
            closeAllDropdowns();
            dd.setAttribute('aria-expanded', open ? 'false' : 'true');
          }
        });
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!e.target || !(e.target as HTMLElement).closest('.pe-dropdown')) {
          closeAllDropdowns();
        }
      });

      /* ── Reset Visual Gate State ── */
      function setGateState(gateCard: HTMLElement, statusEl: HTMLElement, state: 'pass' | 'blocked' | 'skipped', statusText: string) {
        gateCard.classList.remove('gate-pass', 'gate-blocked', 'gate-skipped');
        statusEl.classList.remove('status-pass', 'status-blocked', 'status-skipped');

        if (state === 'pass') {
          gateCard.classList.add('gate-pass');
          statusEl.textContent = statusText || 'Pass';
        } else if (state === 'blocked') {
          gateCard.classList.add('gate-blocked');
          statusEl.textContent = statusText || 'Blocked';
        } else if (state === 'skipped') {
          gateCard.classList.add('gate-skipped');
          statusEl.textContent = statusText || 'Skipped';
        }
      }

      /* ── Primary Evaluation Engine ── */
      function evaluatePolicy() {
        const scp = layerStates.scp;
        const identity = layerStates.identity;
        const resource = layerStates.resource;
        const boundary = layerStates.boundary;

        let failedGateId: 'scp' | 'deny' | 'auth' | 'boundary' | null = null;

        // Reset gates default
        setGateState(gateScp, statusScp, 'pass', 'Pass');
        setGateState(gateDeny, statusDeny, 'pass', 'Pass');
        setGateState(gateAuth, statusAuth, 'pass', 'Pass');
        setGateState(gateBoundary, statusBoundary, 'pass', 'Pass');

        descScp.textContent = "Validating Org boundaries. Allows general AWS resource actions by default.";
        descDeny.textContent = "Scanning all active policies. If any policy statement explicitly denies, authorization is terminated immediately.";
        descBoundary.textContent = "Evaluating permissions boundaries on the IAM principal. Limits the maximum available access.";

        if (activeMode === 'same') {
          badgeAuthMode.textContent = "Same-Account Union";
          titleAuth.textContent = "Core Access Grants";
          descAuth.textContent = "Same-account operations are a union: either identity policy OR S3 bucket policy must allow access.";
          branchOp.textContent = 'OR';
          branchOp.className = 'pe-branch-operator op-or';
        } else {
          badgeAuthMode.textContent = "Cross-Account Intersection";
          titleAuth.textContent = "Core Access Grants";
          descAuth.textContent = "Cross-account access requires an explicit Allow on BOTH the caller side (Identity) and target side (Resource policy).";
          branchOp.textContent = 'AND';
          branchOp.className = 'pe-branch-operator op-and';
        }

        // Render active tab JSON policy code
        renderActiveJson();

        // ════ GATE 1: SCP Ingestion Check ════
        if (scp === 'deny') {
          setGateState(gateScp, statusScp, 'blocked', 'Blocked');
          setGateState(gateDeny, statusDeny, 'skipped', 'Skipped');
          setGateState(gateAuth, statusAuth, 'skipped', 'Skipped');
          setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');
          
          descScp.textContent = "Organizations SCP explicitly denied the action. Organizations guardrails override all account permissions.";
          setVerdict(false, "Explicit Deny in SCP", "Service Control Policy (SCP) explicitly denied the action. Organizations guardrails override all accounts permissions.");
          failedGateId = 'scp';
          updatePipelineLayout(failedGateId);
          return;
        } else if (scp === 'none') {
          setGateState(gateScp, statusScp, 'blocked', 'Blocked');
          setGateState(gateDeny, statusDeny, 'skipped', 'Skipped');
          setGateState(gateAuth, statusAuth, 'skipped', 'Skipped');
          setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');

          descScp.textContent = "Organizations SCP does not contain a matching Allow statement (default FullAWSAccess was modified). Denied by default Org ceiling.";
          setVerdict(false, "Implicit Deny in SCP", "Organizations SCP does not contain a matching Allow statement (default FullAWSAccess was modified). Denied by default Org ceiling.");
          failedGateId = 'scp';
          updatePipelineLayout(failedGateId);
          return;
        }

        // ════ GATE 2: Explicit Deny Scan ════
        const hasExplicitDeny = (identity === 'deny' || resource === 'deny' || boundary === 'deny');
        if (hasExplicitDeny) {
          setGateState(gateDeny, statusDeny, 'blocked', 'Blocked');
          setGateState(gateAuth, statusAuth, 'skipped', 'Skipped');
          setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');

          let source = "";
          if (identity === 'deny') source = "Identity Policy";
          else if (resource === 'deny') source = "Resource Policy";
          else if (boundary === 'deny') source = "Permissions Boundary";

          descDeny.textContent = `Scanned policies. Found an explicit Deny statement inside the ${source}. Evaluation halts immediately.`;
          setVerdict(false, `Explicit Deny in ${source}`, `One matching Deny statement overrides any number of matching Allow statements. Denied by ${source}.`);
          failedGateId = 'deny';
          updatePipelineLayout(failedGateId);
          return;
        }

        // ════ GATE 3: Core Authorization Grants ════
        let hasAllow = false;
        if (activeMode === 'same') {
          // Same-Account Mode: Union
          hasAllow = (identity === 'allow' || resource === 'allow');
          if (!hasAllow) {
            setGateState(gateAuth, statusAuth, 'blocked', 'No Allow');
            setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');

            descAuth.textContent = "Same-account Union: Checked both Identity policy and Resource policy. Neither contains an Allow statement.";
            setVerdict(false, "Implicit Deny", "No matching Allow statement was found in either the Identity-based policy or the Resource-based policy. Default is deny.");
            failedGateId = 'auth';
            updatePipelineLayout(failedGateId);
            return;
          } else {
            const byIdentity = identity === 'allow';
            const byResource = resource === 'allow';
            if (byIdentity && byResource) {
              descAuth.textContent = "Access allowed by both Identity policy and Resource bucket policy (Union succeeded).";
            } else if (byIdentity) {
              descAuth.textContent = "Access allowed by Identity policy (Resource policy was not configured). Same-account union succeeded.";
            } else {
              descAuth.textContent = "Access allowed by Resource policy (Identity policy was not configured). Same-account union succeeded.";
            }
          }
        } else {
          // Cross-Account Mode: Intersection (Except KMS, but generally requires both)
          const identityAllows = (identity === 'allow');
          const resourceAllows = (resource === 'allow');
          
          if (!identityAllows || !resourceAllows) {
            setGateState(gateAuth, statusAuth, 'blocked', 'Blocked');
            setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');

            if (!identityAllows && !resourceAllows) {
              descAuth.textContent = "Cross-account Intersection: Neither the source account (Identity) nor target account (Resource) allowed the request.";
              setVerdict(false, "Implicit Deny", "Denied. Cross-account access requires an explicit Allow statement on BOTH sides, but neither policy granted it.");
            } else if (!identityAllows) {
              descAuth.textContent = "Cross-account Intersection: S3 Bucket policy trusts the caller, but the source account (Identity policy) did not grant Allow permissions.";
              setVerdict(false, "Missing Identity Allow", "Denied. The target resource policy allows the action, but the caller's source account has not allowed the principal to perform it.");
            } else {
              descAuth.textContent = "Cross-account Intersection: Source account allowed the caller, but the target resource-based policy does not trust or allow the caller.";
              setVerdict(false, "Missing Resource Trust", "Denied. The caller has identity permissions, but the target resource-based policy (e.g. S3 bucket) does not trust/allow the principal.");
            }
            failedGateId = 'auth';
            updatePipelineLayout(failedGateId);
            return;
          } else {
            descAuth.textContent = "Access successfully allowed on both sides: Identity policy allows, and Resource-based policy trusts caller (Intersection succeeded).";
          }
        }

        // ════ GATE 4: Permissions Boundary Check ════
        const allowedOnlyByResource = (activeMode === 'same' && resource === 'allow' && identity !== 'allow');

        if (allowedOnlyByResource) {
          setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');
          descBoundary.textContent = "Permissions boundary skipped. Same-account access was granted directly by the resource policy (bypasses boundary ceilings).";
        } else {
          if (boundary === 'none') {
            setGateState(gateBoundary, statusBoundary, 'blocked', 'Blocked');
            descBoundary.textContent = "Permissions boundary is active but does not contain a matching Allow statement. The maximum permissions ceiling is empty.";
            setVerdict(false, "Blocked by Boundary", "Permissions Boundary ceiling restricts the identity allow. Since the boundary did not allow the action, the intersection is empty.");
            failedGateId = 'boundary';
            updatePipelineLayout(failedGateId);
            return;
          } else {
            descBoundary.textContent = "Permissions boundary allows the action. The identity policy allow successfully passes the ceiling intersection.";
          }
        }

        // ════ FINAL VERDICT: ALLOW ════
        setVerdict(true, "ALLOWED", "No explicit deny was matched, and at least one policy layers granted permissions successfully!");
        updatePipelineLayout(null);
      }

      /* ── Update Visual sub-branches and dynamic track line height ── */
      function updatePipelineLayout(failedGateId: 'scp' | 'deny' | 'auth' | 'boundary' | null) {
        // 1. Render Branch Visual under Gate 3
        const isAuthSkipped = gateAuth.classList.contains('gate-skipped');
        if (isAuthSkipped) {
          branchContainer.style.display = 'none';
        } else {
          branchContainer.style.display = 'block';

          // Update Identity Node
          const identity = layerStates.identity;
          branchIdentity.className = 'pe-branch-item';
          if (identity === 'allow') {
            branchIdentity.classList.add('active-allow');
            badgeIdentity.textContent = 'Allow';
          } else if (identity === 'deny') {
            branchIdentity.classList.add('active-deny');
            badgeIdentity.textContent = 'Deny';
          } else {
            badgeIdentity.textContent = 'None';
          }

          // Update Resource Node
          const resource = layerStates.resource;
          branchResource.className = 'pe-branch-item';
          if (resource === 'allow') {
            branchResource.classList.add('active-allow');
            badgeResource.textContent = 'Allow';
          } else if (resource === 'deny') {
            branchResource.classList.add('active-deny');
            badgeResource.textContent = 'Deny';
          } else {
            badgeResource.textContent = 'None';
          }
        }

        // 2. Measure & stretch dynamic track line
        requestAnimationFrame(() => {
          const containerRect = comp.querySelector<HTMLElement>('.pe-pipeline-container')!.getBoundingClientRect();
          
          if (failedGateId) {
            trackLine.classList.add('track-failed');
            const activeStepEl = comp.querySelector<HTMLElement>(`#gate-${failedGateId}`)!;
            const circleEl = activeStepEl.querySelector('.pe-step-circle')!;
            const activeNodeRect = circleEl.getBoundingClientRect();
            const trackTop = activeNodeRect.top - containerRect.top + 12; // center of 24px circle
            trackLine.style.height = `${trackTop}px`;
          } else {
            trackLine.classList.remove('track-failed');
            const lastStepEl = comp.querySelector<HTMLElement>('#gate-boundary')!;
            const circleEl = lastStepEl.querySelector('.pe-step-circle')!;
            const lastNodeRect = circleEl.getBoundingClientRect();
            const trackTop = lastNodeRect.top - containerRect.top + 12;
            trackLine.style.height = `${trackTop}px`;
          }
        });
      }

      function setVerdict(allowed: boolean, titleText: string, reasonText: string) {
        resultBanner.classList.remove('verdict-allowed', 'verdict-denied');
        if (allowed) {
          resultBanner.classList.add('verdict-allowed');
          verdictTitle.textContent = titleText;
          resultBanner.querySelector('.pe-result-icon')!.textContent = "🛡️";
        } else {
          resultBanner.classList.add('verdict-denied');
          verdictTitle.textContent = titleText;
          resultBanner.querySelector('.pe-result-icon')!.textContent = "💥";
        }
        verdictReason.textContent = reasonText;
      }

      // Start automatically at Step 1 of the guided concept tour!
      renderTourStep(0);
    });
  }

  // Bind on load and Astro transitions
  initPolicyEvaluator();
  document.addEventListener('astro:page-load', initPolicyEvaluator);
</script>
