---
/**
 * PolicyEvaluator.astro
 * ────────────────────
 * A premium interactive AWS IAM Policy Evaluation Logic simulator.
 * Allows users to toggle policy layers (SCP, Identity, Resource, Permissions Boundary)
 * and mode (Same-Account vs. Cross-Account) to visually trace authorization decisions.
 */

interface Props {
  title?: string;
}

const { title = "IAM Policy Evaluation Engine" } = Astro.props;
---

<div class="pe not-content" id="pe-root">
  <div class="pe-header">
    <div class="pe-header-title">
      <span class="pe-header-dot" />
      <span class="pe-title">{title}</span>
    </div>
    <span class="pe-badge">⬢ IAM Gatekeeper</span>
  </div>

  <div class="pe-layout">
    {/* 1. Left Panel - Configuration Controls */}
    <div class="pe-controls">
      <h4 class="pe-section-title">Evaluation Context</h4>
      
      {/* Account Mode Selector */}
      <div class="pe-control-field">
        <label class="pe-control-label">Account Boundary</label>
        <div class="pe-toggle-group" id="pe-mode-toggle" role="radiogroup" aria-label="Account Boundary">
          <button class="pe-toggle-btn active" data-mode="same" type="button" role="radio" aria-checked="true">
            Same-Account
          </button>
          <button class="pe-toggle-btn" data-mode="cross" type="button" role="radio" aria-checked="false">
            Cross-Account
          </button>
        </div>
        <p class="pe-field-help">Same-account is union (Identity OR Resource); Cross-account requires BOTH sides to Allow.</p>
      </div>

      <div class="pe-divider" />
      <h4 class="pe-section-title">Policy Layers Configuration</h4>

      {/* SCP Dropdown */}
      <div class="pe-control-field">
        <label class="pe-control-label">Service Control Policy (SCP)</label>
        <div class="pe-dropdown" data-layer="scp" tabindex="0" role="combobox" aria-label="SCP Configuration" aria-expanded="false">
          <span class="pe-dropdown-value">Allow (Default FullAccess)</span>
          <svg class="pe-dropdown-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" />
          </svg>
          <div class="pe-dropdown-menu" role="listbox">
            <div class="pe-dropdown-option pe-dropdown-option--active" data-value="allow" role="option" aria-selected="true">Allow (Default FullAccess)</div>
            <div class="pe-dropdown-option" data-value="deny" role="option" aria-selected="false">Explicit Deny</div>
            <div class="pe-dropdown-option" data-value="none" role="option" aria-selected="false">None (Implicit Deny)</div>
          </div>
        </div>
      </div>

      {/* Identity Policy */}
      <div class="pe-control-field">
        <label class="pe-control-label">Identity-Based Policy</label>
        <div class="pe-dropdown" data-layer="identity" tabindex="0" role="combobox" aria-label="Identity Policy Configuration" aria-expanded="false">
          <span class="pe-dropdown-value">Allow</span>
          <svg class="pe-dropdown-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" />
          </svg>
          <div class="pe-dropdown-menu" role="listbox">
            <div class="pe-dropdown-option pe-dropdown-option--active" data-value="allow" role="option" aria-selected="true">Allow</div>
            <div class="pe-dropdown-option" data-value="deny" role="option" aria-selected="false">Explicit Deny</div>
            <div class="pe-dropdown-option" data-value="none" role="option" aria-selected="false">None (Implicit Deny)</div>
          </div>
        </div>
      </div>

      {/* Resource Policy */}
      <div class="pe-control-field">
        <label class="pe-control-label">Resource-Based Policy (e.g. Bucket)</label>
        <div class="pe-dropdown" data-layer="resource" tabindex="0" role="combobox" aria-label="Resource Policy Configuration" aria-expanded="false">
          <span class="pe-dropdown-value">None (Not Set)</span>
          <svg class="pe-dropdown-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" />
          </svg>
          <div class="pe-dropdown-menu" role="listbox">
            <div class="pe-dropdown-option" data-value="allow" role="option" aria-selected="false">Allow</div>
            <div class="pe-dropdown-option" data-value="deny" role="option" aria-selected="false">Explicit Deny</div>
            <div class="pe-dropdown-option pe-dropdown-option--active" data-value="none" role="option" aria-selected="true">None (Not Set)</div>
          </div>
        </div>
      </div>

      {/* Permissions Boundary */}
      <div class="pe-control-field">
        <label class="pe-control-label">Permissions Boundary</label>
        <div class="pe-dropdown" data-layer="boundary" tabindex="0" role="combobox" aria-label="Permissions Boundary Configuration" aria-expanded="false">
          <span class="pe-dropdown-value">Allow (Default)</span>
          <svg class="pe-dropdown-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" />
          </svg>
          <div class="pe-dropdown-menu" role="listbox">
            <div class="pe-dropdown-option pe-dropdown-option--active" data-value="allow" role="option" aria-selected="true">Allow (Default)</div>
            <div class="pe-dropdown-option" data-value="deny" role="option" aria-selected="false">Explicit Deny</div>
            <div class="pe-dropdown-option" data-value="none" role="option" aria-selected="false">None (Implicit Deny)</div>
          </div>
        </div>
      </div>
    </div>

    {/* 2. Right Panel - Evaluation Gate Tracker */}
    <div class="pe-visualizer">
      <h4 class="pe-section-title">Authorization Gate Pipeline</h4>
      
      <div class="pe-gates">
        {/* Gate 1: Organizations SCP */}
        <div class="pe-gate-card" id="gate-scp" data-gate-name="SCP Ingestion">
          <div class="pe-gate-status-line"></div>
          <div class="pe-gate-header">
            <span class="pe-gate-num">1</span>
            <div class="pe-gate-title-block">
              <span class="pe-gate-badge">AWS Organizations</span>
              <h5 class="pe-gate-title">Service Control Policy (SCP)</h5>
            </div>
            <span class="pe-gate-status" id="status-scp">Pass</span>
          </div>
          <p class="pe-gate-description" id="desc-scp">Validating Org boundaries. Allows general AWS resource actions by default.</p>
        </div>

        {/* Gate 2: Explicit Deny Scan */}
        <div class="pe-gate-card" id="gate-deny" data-gate-name="Explicit Deny Scan">
          <div class="pe-gate-status-line"></div>
          <div class="pe-gate-header">
            <span class="pe-gate-num">2</span>
            <div class="pe-gate-title-block">
              <span class="pe-gate-badge">Pre-Flight Guard</span>
              <h5 class="pe-gate-title">Explicit Deny Check</h5>
            </div>
            <span class="pe-gate-status" id="status-deny">Pass</span>
          </div>
          <p class="pe-gate-description" id="desc-deny">Scanning all active policies. If any policy statement explicitly denies, authorization is terminated immediately.</p>
        </div>

        {/* Gate 3: Core Authorization Access */}
        <div class="pe-gate-card" id="gate-auth" data-gate-name="Access Grants Evaluation">
          <div class="pe-gate-status-line"></div>
          <div class="pe-gate-header">
            <span class="pe-gate-num">3</span>
            <div class="pe-gate-title-block">
              <span class="pe-gate-badge" id="badge-auth-mode">Same-Account Union</span>
              <h5 class="pe-gate-title" id="title-auth">Identity & Resource Union</h5>
            </div>
            <span class="pe-gate-status" id="status-auth">Pass</span>
          </div>
          <p class="pe-gate-description" id="desc-auth">Same-account operations are a union : either identity policy OR S3 bucket policy must allow access.</p>
        </div>

        {/* Gate 4: Permissions Boundary Ceiling */}
        <div class="pe-gate-card" id="gate-boundary" data-gate-name="Permissions Ceiling Check">
          <div class="pe-gate-status-line"></div>
          <div class="pe-gate-header">
            <span class="pe-gate-num">4</span>
            <div class="pe-gate-title-block">
              <span class="pe-gate-badge">Identity Ceiling</span>
              <h5 class="pe-gate-title">Permissions Boundary</h5>
            </div>
            <span class="pe-gate-status" id="status-boundary">Pass</span>
          </div>
          <p class="pe-gate-description" id="desc-boundary">Evaluating permissions boundaries on the IAM principal. Limits the maximum available access.</p>
        </div>
      </div>

      {/* 3. Final Authorization Decision Banner */}
      <div class="pe-result-container">
        <div class="pe-result-banner" id="pe-result-banner">
          <div class="pe-result-header">
            <span class="pe-result-icon">🛡️</span>
            <div class="pe-result-title-block">
              <span class="pe-result-badge">Final Evaluator Verdict</span>
              <h3 class="pe-result-title" id="pe-verdict-title">ALLOWED</h3>
            </div>
          </div>
          <p class="pe-result-reason" id="pe-verdict-reason">
            No explicit deny was matched, and at least one policy layers granted permissions successfully!
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pe {
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    --pe-text:       var(--sl-color-text);
    --pe-text-faint: var(--sl-color-gray-3);
    --pe-text-ghost: var(--sl-color-gray-4);
    --pe-rule:       var(--sl-color-hairline-shade);
    --pe-accent:     var(--sl-color-accent-high);
    --pe-panel:      rgba(20, 20, 23, 0.5);
    
    margin: 2rem 0;
    background: var(--pe-panel);
    border: 1px solid var(--pe-rule);
    border-radius: 16px;
    overflow: hidden;
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 8px 32px rgba(0, 0, 0, 0.25);
  }

  .pe-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--pe-rule);
    background: rgba(10, 10, 12, 0.45);
  }

  .pe-header-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pe-header-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pe-accent);
    box-shadow: 0 0 8px var(--pe-accent);
  }

  .pe-title {
    font-size: var(--sl-text-xs);
    font-weight: 700;
    color: var(--pe-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pe-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pe-accent);
    background: color-mix(in srgb, var(--pe-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--pe-accent) 25%, transparent);
    padding: 0.25rem 0.65rem;
    border-radius: 99px;
  }

  .pe-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 24px;
  }

  @media (min-width: 768px) {
    .pe-layout {
      grid-template-columns: 0.95fr 1.05fr;
      align-items: start;
    }
  }

  /* ═══ Left Panel (Controls) ═══ */
  .pe-controls {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid var(--pe-rule);
    border-radius: 12px;
    padding: 20px;
  }

  .pe-section-title {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--pe-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 4px 0;
  }

  .pe-divider {
    height: 1px;
    background: var(--pe-rule);
    margin: 4px 0;
  }

  .pe-control-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pe-control-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--pe-text-ghost);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pe-field-help {
    font-size: 0.58rem;
    color: var(--pe-text-ghost);
    line-height: 1.45;
    margin: 0;
  }

  /* Toggle Group Buttons */
  .pe-toggle-group {
    display: flex;
    border: 1px solid var(--pe-rule);
    border-radius: 6px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.25);
    padding: 2px;
  }

  .pe-toggle-btn {
    flex: 1;
    background: transparent;
    border: none;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--pe-text-ghost);
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 180ms var(--ease);
    text-align: center;
  }

  .pe-toggle-btn.active {
    background: rgba(255, 255, 255, 0.06);
    color: var(--pe-text);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 2px 4px rgba(0, 0, 0, 0.15);
  }

  /* Custom Select Dropdowns */
  .pe-dropdown {
    position: relative;
    user-select: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 28px 4px 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--pe-rule);
    border-radius: 6px;
    color: var(--pe-text);
    font-size: 0.72rem;
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    outline: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .pe-dropdown:focus,
  .pe-dropdown[aria-expanded="true"] {
    border-color: var(--pe-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--pe-accent) 20%, transparent);
  }

  .pe-dropdown-value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pe-dropdown-arrow {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 10px;
    height: 10px;
    color: var(--pe-text-ghost);
    pointer-events: none;
    transition: transform 200ms ease;
  }

  .pe-dropdown[aria-expanded="true"] .pe-dropdown-arrow {
    transform: translateY(-50%) rotate(180deg);
  }

  .pe-dropdown-menu {
    display: none;
    position: absolute;
    left: -1px;
    right: -1px;
    top: calc(100% + 4px);
    background: #141417;
    border: 1px solid var(--pe-rule);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    z-index: 100;
    max-height: 200px;
    overflow-y: auto;
    padding: 4px;
  }

  .pe-dropdown[aria-expanded="true"] .pe-dropdown-menu {
    display: block;
  }

  .pe-dropdown-option {
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.68rem;
    color: var(--pe-text);
    transition: background 120ms ease;
    white-space: nowrap;
  }

  .pe-dropdown-option:hover {
    background: color-mix(in srgb, var(--pe-accent) 15%, transparent);
  }

  .pe-dropdown-option--active {
    color: var(--pe-accent);
    font-weight: 700;
    background: color-mix(in srgb, var(--pe-accent) 8%, transparent);
  }

  /* ═══ Right Panel (Visualizer) ═══ */
  .pe-visualizer {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .pe-gates {
    display: flex;
    flex-direction: column;
    gap: 2px;
    position: relative;
    width: 100%;
  }

  /* Gate Card Primitive */
  .pe-gate-card {
    --gate-color: var(--pe-accent);
    background: rgba(22, 22, 26, 0.75);
    border: 1px solid var(--pe-rule);
    border-left: 3px solid var(--gate-color);
    border-radius: 8px;
    padding: 10px 14px;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 250ms var(--ease);
    overflow: hidden;
  }

  .pe-gate-status-line {
    position: absolute;
    bottom: -18px;
    left: 14px;
    width: 1.5px;
    height: 18px;
    background: rgba(255, 255, 255, 0.05);
    z-index: 10;
    transition: background 250ms ease;
  }

  .pe-gate-card:last-child .pe-gate-status-line {
    display: none;
  }

  .pe-gate-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 4px;
  }

  .pe-gate-num {
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--gate-color);
    background: color-mix(in srgb, var(--gate-color) 12%, transparent);
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .pe-gate-title-block {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .pe-gate-badge {
    font-size: 0.52rem;
    font-weight: 700;
    color: var(--pe-text-ghost);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.1;
  }

  .pe-gate-title {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--pe-text);
    margin: 0;
    line-height: 1.35;
  }

  .pe-gate-status {
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--pe-text-ghost);
    transition: all 250ms ease;
  }

  .pe-gate-description {
    font-size: 0.65rem;
    color: var(--pe-text-faint);
    line-height: 1.45;
    margin: 0;
    padding-left: 28px; /* Align with title */
  }

  /* ═══ Gate card state classes ═══ */
  .pe-gate-card.gate-pass {
    background: color-mix(in srgb, #10b981 1.5%, rgba(22, 22, 26, 0.95));
    border-color: rgba(16, 185, 129, 0.2);
    border-left-color: #10b981;
  }
  .pe-gate-card.gate-pass .pe-gate-status {
    color: #34d399;
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.25);
  }
  .pe-gate-card.gate-pass .pe-gate-num {
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
  }
  .pe-gate-card.gate-pass .pe-gate-status-line {
    background: #10b981;
  }

  .pe-gate-card.gate-blocked {
    background: color-mix(in srgb, #ef4444 2.5%, rgba(22, 22, 26, 0.98));
    border-color: rgba(239, 68, 68, 0.35);
    border-left-color: #ef4444;
    transform: scale(1.005);
    box-shadow: 0 4px 16px rgba(239, 68, 68, 0.1), 0 0 10px rgba(239, 68, 68, 0.05);
  }
  .pe-gate-card.gate-blocked .pe-gate-status {
    color: #f87171;
    background: rgba(239, 68, 68, 0.08);
    border-color: rgba(239, 68, 68, 0.25);
    animation: pe-btn-glow 0.8s infinite alternate;
  }
  .pe-gate-card.gate-blocked .pe-gate-num {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.12);
  }
  .pe-gate-card.gate-blocked .pe-gate-status-line {
    background: rgba(239, 68, 68, 0.15);
  }

  .pe-gate-card.gate-skipped {
    opacity: 0.45;
    background: rgba(22, 22, 26, 0.35);
    border-color: var(--pe-rule);
    border-left-color: var(--pe-text-ghost);
  }
  .pe-gate-card.gate-skipped .pe-gate-status {
    color: var(--pe-text-ghost);
  }
  .pe-gate-card.gate-skipped .pe-gate-num {
    color: var(--pe-text-ghost);
    background: rgba(255, 255, 255, 0.04);
  }

  @keyframes pe-btn-glow {
    from { box-shadow: 0 0 4px rgba(239, 68, 68, 0.1); }
    to { box-shadow: 0 0 10px rgba(239, 68, 68, 0.3); }
  }

  /* ═══ Verdict Result Banner ═══ */
  .pe-result-container {
    margin-top: 6px;
    width: 100%;
  }

  .pe-result-banner {
    padding: 16px 20px;
    border-radius: 12px;
    border: 1px solid var(--pe-rule);
    background: rgba(10, 10, 12, 0.85);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: all 250ms var(--ease);
  }

  .pe-result-banner.verdict-allowed {
    border-color: rgba(16, 185, 129, 0.3);
    background: linear-gradient(to right, rgba(16, 185, 129, 0.04), rgba(0,0,0,0) 80%), rgba(10, 10, 12, 0.95);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), 0 0 12px rgba(16, 185, 129, 0.05);
  }

  .pe-result-banner.verdict-denied {
    border-color: rgba(239, 68, 68, 0.3);
    background: linear-gradient(to right, rgba(239, 68, 68, 0.04), rgba(0,0,0,0) 80%), rgba(10, 10, 12, 0.95);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), 0 0 12px rgba(239, 68, 68, 0.05);
  }

  .pe-result-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .pe-result-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .pe-result-title-block {
    display: flex;
    flex-direction: column;
  }

  .pe-result-badge {
    font-size: 0.52rem;
    font-weight: 700;
    color: var(--pe-text-ghost);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pe-result-title {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: 0.04em;
    transition: color 250ms ease;
  }

  .pe-result-banner.verdict-allowed .pe-result-title {
    color: #34d399;
    text-shadow: 0 0 12px rgba(52, 211, 153, 0.25);
  }

  .pe-result-banner.verdict-denied .pe-result-title {
    color: #f87171;
    text-shadow: 0 0 12px rgba(248, 113, 113, 0.25);
  }

  .pe-result-reason {
    font-size: 0.72rem;
    color: var(--pe-text-faint);
    line-height: 1.5;
    margin: 0;
  }
</style>

<script>
  function initPolicyEvaluator() {
    document.querySelectorAll<HTMLElement>('.pe:not([data-init])').forEach((comp) => {
      comp.setAttribute('data-init', '');

      // Controls
      const modeButtons = comp.querySelectorAll<HTMLButtonElement>('#pe-mode-toggle button');
      const dropdowns = comp.querySelectorAll<HTMLElement>('.pe-dropdown');
      
      // Visual Gates
      const gateScp = comp.querySelector<HTMLElement>('#gate-scp')!;
      const gateDeny = comp.querySelector<HTMLElement>('#gate-deny')!;
      const gateAuth = comp.querySelector<HTMLElement>('#gate-auth')!;
      const gateBoundary = comp.querySelector<HTMLElement>('#gate-boundary')!;

      // Visual Gate Status Elements
      const statusScp = comp.querySelector<HTMLElement>('#status-scp')!;
      const statusDeny = comp.querySelector<HTMLElement>('#status-deny')!;
      const statusAuth = comp.querySelector<HTMLElement>('#status-auth')!;
      const statusBoundary = comp.querySelector<HTMLElement>('#status-boundary')!;

      // Visual Gate Descriptions
      const descScp = comp.querySelector<HTMLElement>('#desc-scp')!;
      const descDeny = comp.querySelector<HTMLElement>('#desc-deny')!;
      const descAuth = comp.querySelector<HTMLElement>('#desc-auth')!;
      const descBoundary = comp.querySelector<HTMLElement>('#desc-boundary')!;

      // Result Box
      const resultBanner = comp.querySelector<HTMLElement>('#pe-result-banner')!;
      const verdictTitle = comp.querySelector<HTMLElement>('#pe-verdict-title')!;
      const verdictReason = comp.querySelector<HTMLElement>('#pe-verdict-reason')!;
      const badgeAuthMode = comp.querySelector<HTMLElement>('#badge-auth-mode')!;
      const titleAuth = comp.querySelector<HTMLElement>('#title-auth')!;

      // Current State
      let activeMode: 'same' | 'cross' = 'same';
      const layerStates: Record<string, 'allow' | 'deny' | 'none'> = {
        scp: 'allow',
        identity: 'allow',
        resource: 'none',
        boundary: 'allow'
      };

      // Helper to check dropdown click outside
      function closeAllDropdowns() {
        dropdowns.forEach(dd => dd.setAttribute('aria-expanded', 'false'));
      }

      /* ── Setup Mode Toggle ── */
      modeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          modeButtons.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-checked', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-checked', 'true');
          activeMode = btn.dataset.mode as 'same' | 'cross';
          
          evaluatePolicy();
        });
      });

      /* ── Setup Select Dropdowns ── */
      dropdowns.forEach((dd) => {
        const valueEl = dd.querySelector<HTMLElement>('.pe-dropdown-value')!;
        const optionEls = dd.querySelectorAll<HTMLElement>('.pe-dropdown-option');
        const layerName = dd.dataset.layer!;

        dd.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const option = target.closest<HTMLElement>('.pe-dropdown-option');
          if (option) {
            const val = option.dataset.value as 'allow' | 'deny' | 'none';
            valueEl.textContent = option.textContent || '';
            optionEls.forEach((o) => {
              o.classList.toggle('pe-dropdown-option--active', o === option);
              o.setAttribute('aria-selected', o === option ? 'true' : 'false');
            });
            dd.setAttribute('aria-expanded', 'false');
            
            layerStates[layerName] = val;
            evaluatePolicy();
          } else {
            const open = dd.getAttribute('aria-expanded') === 'true';
            closeAllDropdowns();
            dd.setAttribute('aria-expanded', open ? 'false' : 'true');
          }
        });

        dd.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') dd.setAttribute('aria-expanded', 'false');
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const open = dd.getAttribute('aria-expanded') === 'true';
            closeAllDropdowns();
            dd.setAttribute('aria-expanded', open ? 'false' : 'true');
          }
        });
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!e.target || !(e.target as HTMLElement).closest('.pe-dropdown')) {
          closeAllDropdowns();
        }
      });

      /* ── Reset Visual Gate State ── */
      function setGateState(gateCard: HTMLElement, statusEl: HTMLElement, state: 'pass' | 'blocked' | 'skipped', statusText: string) {
        gateCard.classList.remove('gate-pass', 'gate-blocked', 'gate-skipped');
        statusEl.classList.remove('status-pass', 'status-blocked', 'status-skipped');

        if (state === 'pass') {
          gateCard.classList.add('gate-pass');
          statusEl.textContent = statusText || 'Pass';
        } else if (state === 'blocked') {
          gateCard.classList.add('gate-blocked');
          statusEl.textContent = statusText || 'Blocked';
        } else if (state === 'skipped') {
          gateCard.classList.add('gate-skipped');
          statusEl.textContent = statusText || 'Skipped';
        }
      }

      /* ── Primary Evaluation Engine ── */
      function evaluatePolicy() {
        const scp = layerStates.scp;
        const identity = layerStates.identity;
        const resource = layerStates.resource;
        const boundary = layerStates.boundary;

        // Reset gates default
        setGateState(gateScp, statusScp, 'pass', 'Pass');
        setGateState(gateDeny, statusDeny, 'pass', 'Pass');
        setGateState(gateAuth, statusAuth, 'pass', 'Pass');
        setGateState(gateBoundary, statusBoundary, 'pass', 'Pass');

        descScp.textContent = "Validating Org boundaries. Allows general AWS resource actions by default.";
        descDeny.textContent = "Scanning all active policies. If any policy statement explicitly denies, authorization is terminated immediately.";
        descBoundary.textContent = "Evaluating permissions boundaries on the IAM principal. Limits the maximum available access.";

        if (activeMode === 'same') {
          badgeAuthMode.textContent = "Same-Account Union";
          titleAuth.textContent = "Identity & Resource Union";
          descAuth.textContent = "Same-account operations are a union : either identity policy OR S3 bucket policy must allow access.";
        } else {
          badgeAuthMode.textContent = "Cross-Account Intersection";
          titleAuth.textContent = "Identity & Resource Intersection";
          descAuth.textContent = "Cross-account access requires an explicit Allow on BOTH the caller side (Identity) and target side (Resource policy).";
        }

        // ════ GATE 1: SCP Ingestion Check ════
        if (scp === 'deny') {
          setGateState(gateScp, statusScp, 'blocked', 'Blocked');
          setGateState(gateDeny, statusDeny, 'skipped', 'Skipped');
          setGateState(gateAuth, statusAuth, 'skipped', 'Skipped');
          setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');
          
          setVerdict(false, "Explicit Deny in SCP", "Service Control Policy (SCP) explicitly denied the action. Organizations guardrails override all accounts permissions.");
          return;
        } else if (scp === 'none') {
          setGateState(gateScp, statusScp, 'blocked', 'Blocked');
          setGateState(gateDeny, statusDeny, 'skipped', 'Skipped');
          setGateState(gateAuth, statusAuth, 'skipped', 'Skipped');
          setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');

          setVerdict(false, "Implicit Deny in SCP", "Organizations SCP does not contain a matching Allow statement (default FullAWSAccess was modified). Denied by default Org ceiling.");
          return;
        }

        // ════ GATE 2: Explicit Deny Scan ════
        const hasExplicitDeny = (identity === 'deny' || resource === 'deny' || boundary === 'deny');
        if (hasExplicitDeny) {
          setGateState(gateDeny, statusDeny, 'blocked', 'Blocked');
          setGateState(gateAuth, statusAuth, 'skipped', 'Skipped');
          setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');

          let source = "";
          if (identity === 'deny') source = "Identity Policy";
          else if (resource === 'deny') source = "Resource Policy";
          else if (boundary === 'deny') source = "Permissions Boundary";

          descDeny.textContent = `Scanned policies. Found an explicit Deny statement inside the ${source}. Evaluation halts immediately.`;
          setVerdict(false, `Explicit Deny in ${source}`, `One matching Deny statement overrides any number of matching Allow statements. Denied by ${source}.`);
          return;
        }

        // ════ GATE 3: Core Authorization Grants ════
        let hasAllow = false;
        if (activeMode === 'same') {
          // Same-Account Mode: Union
          hasAllow = (identity === 'allow' || resource === 'allow');
          if (!hasAllow) {
            setGateState(gateAuth, statusAuth, 'blocked', 'No Allow');
            setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');

            descAuth.textContent = "Same-account Union: Checked both Identity policy and Resource policy. Neither contains an Allow statement.";
            setVerdict(false, "Implicit Deny", "No matching Allow statement was found in either the Identity-based policy or the Resource-based policy. Default is deny.");
            return;
          } else {
            const byIdentity = identity === 'allow';
            const byResource = resource === 'allow';
            if (byIdentity && byResource) {
              descAuth.textContent = "Access allowed by both Identity policy and Resource bucket policy (Union matched on both).";
            } else if (byIdentity) {
              descAuth.textContent = "Access allowed by Identity policy (Resource policy was not configured). Same-account union succeeded.";
            } else {
              descAuth.textContent = "Access allowed by Resource policy (Identity policy was not configured). Same-account union succeeded.";
            }
          }
        } else {
          // Cross-Account Mode: Intersection (Except KMS, but generally requires both)
          const identityAllows = (identity === 'allow');
          const resourceAllows = (resource === 'allow');
          
          if (!identityAllows || !resourceAllows) {
            setGateState(gateAuth, statusAuth, 'blocked', 'Blocked');
            setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');

            if (!identityAllows && !resourceAllows) {
              descAuth.textContent = "Cross-account Intersection: Neither the source account (Identity) nor target account (Resource) allowed the request.";
              setVerdict(false, "Implicit Deny", "Denied. Cross-account access requires an explicit Allow statement on BOTH sides, but neither policy granted it.");
            } else if (!identityAllows) {
              descAuth.textContent = "Cross-account Intersection: S3 Bucket policy trusts the caller, but the source account (Identity policy) did not grant Allow permissions.";
              setVerdict(false, "Missing Identity Allow", "Denied. The target resource policy allows the action, but the caller's source account has not allowed the principal to perform it.");
            } else {
              descAuth.textContent = "Cross-account Intersection: Source account allowed the caller, but the target resource-based policy does not trust or allow the caller.";
              setVerdict(false, "Missing Resource Trust", "Denied. The caller has identity permissions, but the target resource-based policy (e.g. S3 bucket) does not trust/allow the principal.");
            }
            return;
          } else {
            descAuth.textContent = "Access successfully allowed on both sides: Identity policy allows, and Resource-based policy trusts caller (Intersection matched).";
          }
        }

        // ════ GATE 4: Permissions Boundary Check ════
        // Note: Permissions boundary only limits the identity-based policy. 
        // If same-account and allowed solely by resource-based policy, boundary does not restrict it.
        // Let's model general principal restriction.
        const allowedOnlyByResource = (activeMode === 'same' && resource === 'allow' && identity !== 'allow');

        if (allowedOnlyByResource) {
          setGateState(gateBoundary, statusBoundary, 'skipped', 'Skipped');
          descBoundary.textContent = "Permissions boundary skipped. Same-account access was granted directly by the resource policy (bypasses boundary ceilings).";
        } else {
          if (boundary === 'none') {
            setGateState(gateBoundary, statusBoundary, 'blocked', 'Blocked');
            descBoundary.textContent = "Permissions boundary is active but does not contain a matching Allow statement. The maximum permissions ceiling is empty.";
            setVerdict(false, "Blocked by Boundary", "Permissions Boundary ceiling restricts the identity allow. Since the boundary did not allow the action, the intersection is empty.");
            return;
          } else {
            descBoundary.textContent = "Permissions boundary allows the action. The identity policy allow successfully passes the ceiling intersection.";
          }
        }

        // ════ FINAL VERDICT: ALLOW ════
        setVerdict(true, "ALLOWED", "No explicit deny was matched, and at least one policy layers granted permissions successfully!");
      }

      function setVerdict(allowed: boolean, titleText: string, reasonText: string) {
        resultBanner.classList.remove('verdict-allowed', 'verdict-denied');
        if (allowed) {
          resultBanner.classList.add('verdict-allowed');
          verdictTitle.textContent = titleText;
          resultBanner.querySelector('.pe-result-icon')!.textContent = "🛡️";
        } else {
          resultBanner.classList.add('verdict-denied');
          verdictTitle.textContent = titleText;
          resultBanner.querySelector('.pe-result-icon')!.textContent = "💥";
        }
        verdictReason.textContent = reasonText;
      }

      // First run
      evaluatePolicy();
    });
  }

  // Bind on load and Astro transitions
  initPolicyEvaluator();
  document.addEventListener('astro:page-load', initPolicyEvaluator);
</script>
