---
/**
 * PolicyEvaluator.astro
 * ────────────────────
 * A premium interactive AWS IAM Policy Evaluation Logic simulator.
 * Allows users to toggle policy layers (SCP, Identity, Resource, Permissions Boundary)
 * and mode (Same-Account vs. Cross-Account) to visually trace authorization decisions.
 * Stacked in a space-efficient, single-column vertical layout with educational descriptions
 * and a brand-new Guided Concept Tour mode to make AWS evaluation instantly graspable.
 */

interface Props {
  title?: string;
}

const { title = "IAM Policy Evaluation Engine" } = Astro.props;
---

<div class="pe not-content" id="pe-root">
  <div class="pe-header">
    <div class="pe-header-title">
      <span class="pe-header-dot" />
      <span class="pe-title">{title}</span>
    </div>
    <span class="pe-badge">⬢ IAM Gatekeeper</span>
  </div>

  <div class="pe-layout">
    {/* 0. Guided Interactive Concept Tour */}
    <div class="pe-tour" id="pe-tour-container">
      <div class="pe-tour-header">
        <div class="pe-tour-title-block">
          <span class="pe-tour-icon">🎓</span>
          <span class="pe-tour-step-indicator" id="pe-tour-step">Step 1 of 5: Default Deny</span>
        </div>
        <div class="pe-tour-nav">
          <button class="pe-tour-nav-btn" id="pe-tour-prev" type="button" disabled>← Prev</button>
          <button class="pe-tour-nav-btn pe-tour-nav-btn--next" id="pe-tour-next" type="button">Next Step →</button>
        </div>
      </div>
      <p class="pe-tour-text" id="pe-tour-desc">
        AWS blocks everything by default. Without an explicit Allow statement in any of your policies, the request is implicitly denied at Gate 3.
      </p>
    </div>

    {/* 1. Configuration Controls Dashboard */}
    <div class="pe-controls">
      {/* Common Scenarios Presets (Now in its own spacious full-width row!) */}
      <div class="pe-control-field">
        <label class="pe-control-label">Common Scenarios Presets</label>
        <div class="pe-presets-grid">
          <button class="pe-preset-btn active" data-preset="same-identity" type="button" aria-label="Load Same-Account Identity Allow scenario">Same-Account Identity Allow</button>
          <button class="pe-preset-btn" data-preset="explicit-deny" type="button" aria-label="Load Explicit Deny Wins scenario">Explicit Deny Wins</button>
          <button class="pe-preset-btn" data-preset="cross-missing" type="button" aria-label="Load Cross-Account Missing Trust scenario">Cross-Account Missing Trust</button>
          <button class="pe-preset-btn" data-preset="cross-success" type="button" aria-label="Load Cross-Account Handshake scenario">Cross-Account Handshake</button>
          <button class="pe-preset-btn" data-preset="boundary-blocked" type="button" aria-label="Load Boundary Ceiling Blocked scenario">Boundary Ceiling Blocked</button>
          <button class="pe-preset-btn" data-preset="scp-blocked" type="button" aria-label="Load Organizations SCP Blocked scenario">Organizations SCP Blocked</button>
        </div>
      </div>

      <div class="pe-divider" />

      {/* Account Boundary Selection */}
      <div class="pe-control-field">
        <label class="pe-control-label">Account Boundary</label>
        <div class="pe-toggle-group" id="pe-mode-toggle" role="radiogroup" aria-label="Account Boundary">
          <button class="pe-toggle-btn active" data-mode="same" type="button" role="radio" aria-checked="true">
            Same-Account
          </button>
          <button class="pe-toggle-btn" data-mode="cross" type="button" role="radio" aria-checked="false">
            Cross-Account
          </button>
        </div>
        <p class="pe-field-help">Same-account is union (Identity OR Resource); Cross-account requires BOTH sides to Allow.</p>
      </div>

      <div class="pe-divider" />
      <h4 class="pe-section-title">Policy Layers Configuration</h4>

      <div class="pe-layers-grid">
        {/* SCP Dropdown */}
        <div class="pe-control-field">
          <label class="pe-control-label">Service Control Policy (SCP)</label>
          <div class="pe-dropdown" data-layer="scp" tabindex="0" role="combobox" aria-label="SCP Configuration" aria-expanded="false">
            <span class="pe-dropdown-value">Allow (Default FullAccess)</span>
            <svg class="pe-dropdown-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 4.5L6 7.5L9 4.5" />
            </svg>
            <div class="pe-dropdown-menu" role="listbox">
              <div class="pe-dropdown-option pe-dropdown-option--active" data-value="allow" role="option" aria-selected="true">Allow (Default FullAccess)</div>
              <div class="pe-dropdown-option" data-value="deny" role="option" aria-selected="false">Explicit Deny</div>
              <div class="pe-dropdown-option" data-value="none" role="option" aria-selected="false">None (Implicit Deny)</div>
            </div>
          </div>
        </div>

        {/* Identity Policy */}
        <div class="pe-control-field">
          <label class="pe-control-label">Identity-Based Policy</label>
          <div class="pe-dropdown" data-layer="identity" tabindex="0" role="combobox" aria-label="Identity Policy Configuration" aria-expanded="false">
            <span class="pe-dropdown-value">Allow</span>
            <svg class="pe-dropdown-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 4.5L6 7.5L9 4.5" />
            </svg>
            <div class="pe-dropdown-menu" role="listbox">
              <div class="pe-dropdown-option pe-dropdown-option--active" data-value="allow" role="option" aria-selected="true">Allow</div>
              <div class="pe-dropdown-option" data-value="deny" role="option" aria-selected="false">Explicit Deny</div>
              <div class="pe-dropdown-option" data-value="none" role="option" aria-selected="false">None (Implicit Deny)</div>
            </div>
          </div>
        </div>

        {/* Resource Policy */}
        <div class="pe-control-field">
          <label class="pe-control-label">Resource-Based Policy</label>
          <div class="pe-dropdown" data-layer="resource" tabindex="0" role="combobox" aria-label="Resource Policy Configuration" aria-expanded="false">
            <span class="pe-dropdown-value">None (Not Set)</span>
            <svg class="pe-dropdown-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 4.5L6 7.5L9 4.5" />
            </svg>
            <div class="pe-dropdown-menu" role="listbox">
              <div class="pe-dropdown-option" data-value="allow" role="option" aria-selected="false">Allow</div>
              <div class="pe-dropdown-option" data-value="deny" role="option" aria-selected="false">Explicit Deny</div>
              <div class="pe-dropdown-option pe-dropdown-option--active" data-value="none" role="option" aria-selected="true">None (Not Set)</div>
            </div>
          </div>
        </div>

        {/* Permissions Boundary */}
        <div class="pe-control-field">
          <label class="pe-control-label">Permissions Boundary</label>
          <div class="pe-dropdown" data-layer="boundary" tabindex="0" role="combobox" aria-label="Permissions Boundary Configuration" aria-expanded="false">
            <span class="pe-dropdown-value">Allow (Default)</span>
            <svg class="pe-dropdown-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 4.5L6 7.5L9 4.5" />
            </svg>
            <div class="pe-dropdown-menu" role="listbox">
              <div class="pe-dropdown-option pe-dropdown-option--active" data-value="allow" role="option" aria-selected="true">Allow (Default)</div>
              <div class="pe-dropdown-option" data-value="deny" role="option" aria-selected="false">Explicit Deny</div>
              <div class="pe-dropdown-option" data-value="none" role="option" aria-selected="false">None (Implicit Deny)</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* 2. Visualizer Panel (Stacked Below Controls) */}
    <div class="pe-visualizer">
      <h4 class="pe-section-title">Visual Authorization Journey</h4>
      
      <div class="pe-pipeline-container">
        {/* Dynamic glowing vertical track */}
        <div class="pe-track-bg"></div>
        <div class="pe-track-active" id="pe-track-line"></div>

        {/* Step 1: Organizations SCP */}
        <div class="pe-pipeline-step" id="gate-scp" data-gate-name="SCP Ingestion">
          <div class="pe-step-node">
            <span class="pe-step-circle">1</span>
          </div>
          <div class="pe-step-content">
            <div class="pe-step-header">
              <span class="pe-gate-badge">AWS Organizations</span>
              <h5 class="pe-step-title">Organization Guardrail (SCP)</h5>
              <span class="pe-gate-status" id="status-scp">Pass</span>
            </div>
            <p class="pe-step-description" id="desc-scp">Validating Org boundaries. Allows general AWS resource actions by default.</p>
          </div>
        </div>

        {/* Step 2: Explicit Deny Scan */}
        <div class="pe-pipeline-step" id="gate-deny" data-gate-name="Explicit Deny Scan">
          <div class="pe-step-node">
            <span class="pe-step-circle">2</span>
          </div>
          <div class="pe-step-content">
            <div class="pe-step-header">
              <span class="pe-gate-badge">Pre-Flight Guard</span>
              <h5 class="pe-step-title">Explicit Deny Check</h5>
              <span class="pe-gate-status" id="status-deny">Pass</span>
            </div>
            <p class="pe-step-description" id="desc-deny">Scanning all active policies. If any policy statement explicitly denies, authorization is terminated immediately.</p>
          </div>
        </div>

        {/* Step 3: Core Authorization Access */}
        <div class="pe-pipeline-step" id="gate-auth" data-gate-name="Access Grants Evaluation">
          <div class="pe-step-node">
            <span class="pe-step-circle">3</span>
          </div>
          <div class="pe-step-content">
            <div class="pe-step-header">
              <span class="pe-gate-badge" id="badge-auth-mode">Same-Account Union</span>
              <h5 class="pe-step-title" id="title-auth">Core Access Grants</h5>
              <span class="pe-gate-status" id="status-auth">Pass</span>
            </div>
            <p class="pe-step-description" id="desc-auth">Same-account operations are a union: either identity policy OR S3 bucket policy must allow access.</p>
            
            {/* Visual Union / Intersection Sub-Branch */}
            <div class="pe-branch-visual" id="pe-branch-container">
              <div class="pe-branch-nodes">
                <div class="pe-branch-item" id="pe-branch-identity">
                  <div class="pe-branch-dot" id="pe-dot-identity"></div>
                  <div class="pe-branch-label-wrapper">
                    <span class="pe-branch-label">Identity Policy</span>
                    <span class="pe-branch-state-badge" id="pe-badge-identity">Allow</span>
                  </div>
                </div>
                <div class="pe-branch-operator-container">
                  <span class="pe-branch-operator op-or" id="pe-branch-op">OR</span>
                </div>
                <div class="pe-branch-item" id="pe-branch-resource">
                  <div class="pe-branch-dot" id="pe-dot-resource"></div>
                  <div class="pe-branch-label-wrapper">
                    <span class="pe-branch-label">Resource Policy</span>
                    <span class="pe-branch-state-badge" id="pe-badge-resource">None</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Step 4: Permissions Boundary Ceiling */}
        <div class="pe-pipeline-step" id="gate-boundary" data-gate-name="Permissions Ceiling Check">
          <div class="pe-step-node">
            <span class="pe-step-circle">4</span>
          </div>
          <div class="pe-step-content">
            <div class="pe-step-header">
              <span class="pe-gate-badge">Identity Ceiling</span>
              <h5 class="pe-step-title">Permissions Boundary</h5>
              <span class="pe-gate-status" id="status-boundary">Pass</span>
            </div>
            <p class="pe-step-description" id="desc-boundary">Evaluating permissions boundaries on the IAM principal. Limits the maximum available access.</p>
          </div>
        </div>
      </div>

      {/* 3. Final Authorization Decision Banner */}
      <div class="pe-result-container">
        <div class="pe-result-banner" id="pe-result-banner">
          <div class="pe-result-header">
            <span class="pe-result-icon">🛡️</span>
            <div class="pe-result-title-block">
              <span class="pe-result-badge">Final Evaluator Verdict</span>
              <h3 class="pe-result-title" id="pe-verdict-title">ALLOWED</h3>
            </div>
          </div>
          <p class="pe-result-reason" id="pe-verdict-reason">
            No explicit deny was matched, and at least one policy layers granted permissions successfully!
          </p>
        </div>
      </div>

      {/* 4. Live JSON Policy Inspector */}
      <div class="pe-json-container">
        <div class="pe-json-header">
          <span class="pe-json-title">Inspect IAM Policy Code</span>
          <div class="pe-json-tabs" role="tablist" aria-label="JSON Policies">
            <button class="pe-json-tab active" data-tab="scp" role="tab" aria-selected="true">SCP</button>
            <button class="pe-json-tab" data-tab="identity" role="tab" aria-selected="false">Identity</button>
            <button class="pe-json-tab" data-tab="resource" role="tab" aria-selected="false">Resource</button>
            <button class="pe-json-tab" data-tab="boundary" role="tab" aria-selected="false">Boundary</button>
          </div>
        </div>
        <div class="pe-json-body">
          <pre class="pe-json-code" id="pe-json-code"><code>...</code></pre>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pe {
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    --pe-text:       var(--sl-color-text);
    --pe-text-faint: var(--sl-color-gray-2);
    --pe-text-ghost: var(--sl-color-gray-3);
    --pe-rule:       var(--sl-color-hairline-shade);
    --pe-accent:     var(--sl-color-accent-high);
    --pe-panel:      rgba(20, 20, 23, 0.5);
    
    margin: 2rem 0;
    background: var(--pe-panel);
    border: 1px solid var(--pe-rule);
    border-radius: 16px;
    overflow: hidden;
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 8px 32px rgba(0, 0, 0, 0.25);
  }

  .pe-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--pe-rule);
    background: rgba(10, 10, 12, 0.45);
  }

  .pe-header-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pe-header-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pe-accent);
    box-shadow: 0 0 8px var(--pe-accent);
  }

  .pe-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--pe-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pe-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pe-accent);
    background: color-mix(in srgb, var(--pe-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--pe-accent) 25%, transparent);
    padding: 0.25rem 0.65rem;
    border-radius: 99px;
  }

  /* Single Column Flow */
  .pe-layout {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
  }

  /* ═══ Guided Concept Tour Box ═══ */
  .pe-tour {
    background: linear-gradient(135deg, rgba(96, 165, 250, 0.08), rgba(167, 139, 250, 0.04));
    border: 1px solid color-mix(in srgb, var(--pe-accent) 25%, var(--pe-rule));
    border-radius: 12px;
    padding: 14px 18px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15), inset 0 1px 0 0 rgba(255, 255, 255, 0.05);
    transition: all 300ms var(--ease);
  }

  .pe-tour-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
    padding-bottom: 8px;
  }

  .pe-tour-title-block {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pe-tour-icon {
    font-size: 1.2rem;
    line-height: 1;
  }

  .pe-tour-step-indicator {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--pe-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pe-tour-nav {
    display: flex;
    gap: 6px;
  }

  .pe-tour-nav-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--pe-rule);
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--pe-text-faint);
    padding: 4px 8px;
    cursor: pointer;
    transition: all 120ms var(--ease);
  }

  .pe-tour-nav-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.08);
    color: var(--pe-text);
    border-color: var(--pe-accent);
  }

  .pe-tour-nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .pe-tour-nav-btn--next {
    background: color-mix(in srgb, var(--pe-accent) 15%, transparent);
    border-color: var(--pe-accent);
    color: var(--pe-text);
  }

  .pe-tour-nav-btn--next:hover:not(:disabled) {
    background: color-mix(in srgb, var(--pe-accent) 25%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--pe-accent) 20%, transparent);
  }

  .pe-tour-text {
    font-size: 0.86rem;
    color: var(--pe-text-faint);
    line-height: 1.55;
    margin: 0;
  }

  /* ═══ Controls Dashboard ═══ */
  .pe-controls {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid var(--pe-rule);
    border-radius: 12px;
    padding: 16px;
  }

  .pe-presets-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .pe-preset-btn {
    flex: 1 1 calc(50% - 6px);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--pe-rule);
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--pe-text-faint);
    padding: 6px 10px;
    cursor: pointer;
    transition: all 150ms var(--ease);
    text-align: left;
    white-space: normal;
    line-height: 1.25;
  }

  @media (min-width: 768px) {
    .pe-preset-btn {
      flex: 1 1 calc(33.333% - 6px);
    }
  }

  .pe-preset-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--pe-text);
    border-color: color-mix(in srgb, var(--pe-accent) 40%, var(--pe-rule));
  }

  .pe-preset-btn.active {
    background: color-mix(in srgb, var(--pe-accent) 10%, transparent);
    border-color: var(--pe-accent);
    color: var(--pe-text);
    box-shadow: 0 0 8px color-mix(in srgb, var(--pe-accent) 15%, transparent);
  }

  .pe-control-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pe-control-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--pe-text-ghost);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pe-field-help {
    font-size: 0.7rem;
    color: var(--pe-text-ghost);
    line-height: 1.4;
    margin: 0;
  }

  /* Toggle Group Buttons */
  .pe-toggle-group {
    display: flex;
    border: 1px solid var(--pe-rule);
    border-radius: 6px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.25);
    padding: 2px;
  }

  .pe-toggle-btn {
    flex: 1;
    background: transparent;
    border: none;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--pe-text-ghost);
    padding: 6px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 180ms var(--ease);
    text-align: center;
  }

  .pe-toggle-btn.active {
    background: rgba(255, 255, 255, 0.06);
    color: var(--pe-text);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 2px 4px rgba(0, 0, 0, 0.15);
  }

  /* Premium 2-Column Dropdowns to prevent label wrapping/squishing */
  .pe-layers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 600px) {
    .pe-layers-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Custom Select Dropdowns */
  .pe-dropdown {
    position: relative;
    user-select: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    min-height: 38px;
    padding: 6px 32px 6px 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--pe-rule);
    border-radius: 6px;
    color: var(--pe-text);
    font-size: 0.82rem;
    font-family: inherit;
    font-weight: 500;
    outline: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .pe-dropdown:focus,
  .pe-dropdown[aria-expanded="true"] {
    border-color: var(--pe-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--pe-accent) 20%, transparent);
  }

  .pe-dropdown-value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pe-dropdown-arrow {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    color: var(--pe-text-ghost);
    pointer-events: none;
    transition: transform 200ms ease;
  }

  .pe-dropdown[aria-expanded="true"] .pe-dropdown-arrow {
    transform: translateY(-50%) rotate(180deg);
  }

  .pe-dropdown-menu {
    display: none;
    position: absolute;
    left: -1px;
    right: -1px;
    top: calc(100% + 4px);
    background: #141417;
    border: 1px solid var(--pe-rule);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    z-index: 100;
    max-height: 200px;
    overflow-y: auto;
    padding: 6px;
  }

  .pe-dropdown[aria-expanded="true"] .pe-dropdown-menu {
    display: block;
  }

  .pe-dropdown-option {
    padding: 6px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.8rem;
    color: var(--pe-text);
    transition: background 120ms ease;
    white-space: nowrap;
  }

  .pe-dropdown-option:hover {
    background: color-mix(in srgb, var(--pe-accent) 15%, transparent);
  }

  .pe-dropdown-option--active {
    color: var(--pe-accent);
    font-weight: 700;
    background: color-mix(in srgb, var(--pe-accent) 8%, transparent);
  }

