---
/**
 * StateMachineDiagram.astro
 *
 * Interactive state machine diagram. States are clickable pill-shaped nodes
 * arranged horizontally, connected by curved SVG arrows. Clicking a state
 * highlights it and shows its TypeScript type shape and description.
 * The initial state is pre-selected on load to invite exploration.
 *
 * Props:
 *   states      – state nodes with id, label, optional typeShape/description
 *   transitions – edges between states
 *   title       – optional heading
 */

interface State {
  id: string;
  label: string;
  description?: string;
  typeShape?: string;
  color?: string;
  initial?: boolean;
}

interface Transition {
  from: string;
  to: string;
  label?: string;
}

interface Props {
  states: State[];
  transitions: Transition[];
  title?: string;
}

const { states, transitions, title } = Astro.props;
---

<div
  class="sm"
  data-sm-states={JSON.stringify(states)}
  data-sm-transitions={JSON.stringify(transitions)}
>
  <div class="sm-header">
    {title && <div class="sm-title">⚡ {title}</div>}
    <span class="sm-intro">Click any state to explore its type shape and transitions.</span>
  </div>

  <div class="sm-canvas-wrap">
    <svg class="sm-svg" aria-label="State machine diagram"></svg>
  </div>

  <div class="sm-info" style="display:none">
    <div class="sm-info-header">
      <div class="sm-info-dot"></div>
      <div class="sm-info-label"></div>
      <button class="sm-info-close" type="button" aria-label="Close">✕</button>
    </div>
    <div class="sm-info-desc"></div>
    <pre class="sm-info-code"><code></code></pre>
  </div>
</div>

<style>
  .sm {
    --sm-bg: var(--sl-color-gray-6, #1e1e2e);
    --sm-border: var(--sl-color-gray-5, #313244);
    --sm-text: var(--sl-color-gray-1, #cdd6f4);
    --sm-text-dim: var(--sl-color-gray-3, #6c7086);
    --sm-accent: var(--sl-color-accent, #89b4fa);
    --sm-surface: var(--sl-color-gray-6, #1e1e2e);
    --sm-node-bg: var(--sl-color-gray-5, #313244);
    border: 1px solid var(--sm-border);
    border-radius: 12px;
    background: var(--sm-bg);
    padding: 0;
    margin: 1.5rem 0;
    overflow: hidden;
  }

  .sm-header {
    padding: 1rem 1.25rem 0.5rem;
    border-bottom: 1px solid var(--sm-border);
  }

  .sm-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--sm-text);
    margin-bottom: 0.25rem;
  }

  .sm-intro {
    font-size: 0.8rem;
    color: var(--sm-text-dim);
  }

  .sm-canvas-wrap {
    padding: 1.5rem 1rem;
    overflow-x: auto;
    display: flex;
    justify-content: center;
  }

  .sm-svg {
    display: block;
    max-width: 100%;
  }

  /* Info panel */
  .sm-info {
    margin: 0 1rem 1rem;
    border: 1px solid var(--sm-border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--sm-surface) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
    animation: sm-slide-in 0.25s ease-out;
  }

  @keyframes sm-slide-in {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .sm-info-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sm-border);
  }

  .sm-info-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .sm-info-label {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--sm-text);
    flex: 1;
  }

  .sm-info-close {
    background: none;
    border: none;
    color: var(--sm-text-dim);
    cursor: pointer;
    font-size: 1rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    transition: all 0.15s ease;
    line-height: 1;
  }

  .sm-info-close:hover {
    color: var(--sm-text);
    background: var(--sm-node-bg);
  }

  .sm-info-desc {
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: var(--sm-text-dim);
    line-height: 1.5;
  }

  .sm-info-desc:empty {
    display: none;
  }

  .sm-info-code {
    margin: 0;
    padding: 0.75rem 1rem;
    background: var(--sl-color-gray-7, #11111b);
    border-top: 1px solid var(--sm-border);
    overflow-x: auto;
  }

  .sm-info-code code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.82rem;
    color: var(--sm-accent);
    line-height: 1.6;
    white-space: pre;
  }

  .sm-info-code:has(code:empty) {
    display: none;
  }

  @media print {
    .sm-info-close { display: none; }
  }
</style>

<script>
document.addEventListener('astro:page-load', initStateMachine);

function initStateMachine() {
  document.querySelectorAll<HTMLElement>('.sm[data-sm-states]').forEach((root) => {
    if ((root as any).__smInit) return;
    (root as any).__smInit = true;

    const states: any[] = JSON.parse(root.dataset.smStates || '[]');
    const transitions: any[] = JSON.parse(root.dataset.smTransitions || '[]');

    const svg = root.querySelector<SVGSVGElement>('.sm-svg');
    if (!svg || states.length === 0) return;

    // Layout constants
    const NODE_W = 140;
    const NODE_H = 48;
    const MARGIN_X = 40;
    const MARGIN_Y = 60;
    const PAD_TOP = 40;
    const PAD_SIDES = 30;

    // Color defaults
    const defaultColors: Record<string, string> = {
      waiting: '#94a3b8',
      loading: '#60a5fa',
      success: '#4ade80',
      failure: '#f87171',
    };

    function getColor(s: any): string {
      if (s.color) return s.color;
      const key = s.id.toLowerCase();
      return defaultColors[key] || '#a78bfa';
    }

    // Position states horizontally — initial state first
    const positions: Record<string, { x: number; y: number }> = {};
    const sorted = [...states].sort((a, b) => {
      if (a.initial) return -1;
      if (b.initial) return 1;
      return 0;
    });

    // Detect forking (a node with 2+ outbound transitions)
    const outCount: Record<string, string[]> = {};
    transitions.forEach((t: any) => {
      if (!outCount[t.from]) outCount[t.from] = [];
      outCount[t.from].push(t.to);
    });
    const forkNode = Object.entries(outCount).find(([_, targets]) => targets.length > 1)?.[0];
    const hasForking = !!forkNode;

    if (hasForking && sorted.length >= 4) {
      // Layout: linear chain left-to-right, fork targets offset vertically
      let x = PAD_SIDES;
      const centerY = PAD_TOP + NODE_H;
      const placed = new Set<string>();

      // Build main chain: initial → fork node
      const mainChain: string[] = [];
      let current = sorted.find(s => s.initial)?.id || sorted[0].id;
      while (current && !placed.has(current)) {
        mainChain.push(current);
        placed.add(current);
        const next = transitions.find(t => t.from === current && !placed.has(t.to));
        current = next?.to || '';
      }

      // Fork targets not in main chain
      const forkTargets = forkNode ? (outCount[forkNode] || []).filter(id => !mainChain.includes(id)) : [];

      // Position main chain
      mainChain.forEach((id) => {
        positions[id] = { x: x + NODE_W / 2, y: centerY };
        x += NODE_W + MARGIN_X;
      });

      // Position fork targets vertically offset
      if (forkNode && forkTargets.length > 0) {
        const forkX = positions[forkNode]?.x || 0;
        const baseX = forkX + NODE_W + MARGIN_X;
        forkTargets.forEach((id, i) => {
          const yOff = i === 0 ? -MARGIN_Y : MARGIN_Y;
          positions[id] = { x: baseX + NODE_W / 2, y: centerY + yOff };
          placed.add(id);
        });
      }

      // Remaining unplaced
      sorted.forEach(s => {
        if (!placed.has(s.id)) {
          positions[s.id] = { x: x + NODE_W / 2, y: centerY };
          x += NODE_W + MARGIN_X;
          placed.add(s.id);
        }
      });
    } else {
      // Simple horizontal layout
      sorted.forEach((s, i) => {
        positions[s.id] = {
          x: PAD_SIDES + i * (NODE_W + MARGIN_X) + NODE_W / 2,
          y: PAD_TOP + NODE_H,
        };
      });
    }

    // Compute SVG dimensions
    const allX = Object.values(positions).map(p => p.x);
    const allY = Object.values(positions).map(p => p.y);
    const svgW = Math.max(...allX) + NODE_W / 2 + PAD_SIDES;
    const svgH = Math.max(...allY) + NODE_H + PAD_TOP + 20;

    svg.setAttribute('viewBox', `0 0 ${svgW} ${svgH}`);
    svg.setAttribute('width', `${Math.min(svgW, 720)}`);
    svg.setAttribute('height', `${Math.min(svgH, 300)}`);

    // SVG helpers
    const ns = 'http://www.w3.org/2000/svg';
    function el(tag: string, attrs: Record<string, string> = {}): SVGElement {
      const e = document.createElementNS(ns, tag);
      Object.entries(attrs).forEach(([k, v]) => e.setAttribute(k, v));
      return e;
    }

    // Defs: arrowhead markers
    const defs = el('defs');
    transitions.forEach((t: any) => {
      const fromState = states.find(s => s.id === t.from);
      const color = fromState ? getColor(fromState) : '#94a3b8';
      const markerId = `sm-arrow-${t.from}-${t.to}`;
      const marker = el('marker', {
        id: markerId,
        viewBox: '0 0 10 7',
        refX: '9',
        refY: '3.5',
        markerWidth: '8',
        markerHeight: '6',
        orient: 'auto-start-reverse',
      });
      const poly = el('polygon', {
        points: '0 0, 10 3.5, 0 7',
        fill: color,
        opacity: '0.7',
      });
      marker.appendChild(poly);
      defs.appendChild(marker);
    });
    svg.appendChild(defs);

    // Draw transition arrows
    const arrowGroup = el('g', { class: 'sm-arrows' });
    const labelGroup = el('g', { class: 'sm-labels' });

    // Track bidirectional pairs for curve offset
    const pairKey = (a: string, b: string) => [a, b].sort().join('|');
    const pairCount: Record<string, number> = {};
    transitions.forEach((t: any) => {
      const key = pairKey(t.from, t.to);
      pairCount[key] = (pairCount[key] || 0) + 1;
    });
    const pairIndex: Record<string, number> = {};

    transitions.forEach((t: any) => {
      const from = positions[t.from];
      const to = positions[t.to];
      if (!from || !to) return;

      const key = pairKey(t.from, t.to);
      const idx = pairIndex[key] || 0;
      pairIndex[key] = idx + 1;
      const isBidi = pairCount[key] > 1;

      const dx = to.x - from.x;
      const dy = to.y - from.y;
      const angle = Math.atan2(dy, dx);

      // Start/end on pill edge
      const startX = from.x + Math.cos(angle) * (NODE_W / 2 + 2);
      const startY = from.y + Math.sin(angle) * (NODE_H / 2 + 2);
      const endX = to.x - Math.cos(angle) * (NODE_W / 2 + 6);
      const endY = to.y - Math.sin(angle) * (NODE_H / 2 + 6);

      // Curve offset for bidirectional edges
      const curveOffset = isBidi ? (idx === 0 ? -25 : 25) : 0;
      const midX = (startX + endX) / 2;
      const midY = (startY + endY) / 2;

      const len = Math.sqrt(dx * dx + dy * dy) || 1;
      const perpX = -dy / len * curveOffset;
      const perpY = dx / len * curveOffset;
      const ctrlX = midX + perpX;
      const ctrlY = midY + perpY;

      const fromState = states.find(s => s.id === t.from);
      const color = fromState ? getColor(fromState) : '#94a3b8';
      const markerId = `sm-arrow-${t.from}-${t.to}`;

      const path = el('path', {
        d: `M ${startX} ${startY} Q ${ctrlX} ${ctrlY} ${endX} ${endY}`,
        stroke: color,
        'stroke-width': '2',
        'stroke-opacity': '0.5',
        fill: 'none',
        'marker-end': `url(#${markerId})`,
        'data-sm-edge': `${t.from}-${t.to}`,
        'data-sm-from': t.from,
      });
      path.style.transition = 'stroke-opacity 0.3s ease, stroke-width 0.3s ease';
      arrowGroup.appendChild(path);

      // Transition label on the arrow
      if (t.label) {
        const labelEl = el('text', {
          x: `${ctrlX}`,
          y: `${ctrlY - 6}`,
          'text-anchor': 'middle',
          'font-size': '10',
          fill: color,
          opacity: '0.6',
          'data-sm-edge-label': `${t.from}-${t.to}`,
          'data-sm-from': t.from,
        });
        labelEl.textContent = t.label;
        labelEl.style.transition = 'opacity 0.3s ease';
        labelGroup.appendChild(labelEl);
      }
    });

    svg.appendChild(arrowGroup);
    svg.appendChild(labelGroup);

    // Draw state nodes
    const nodeGroup = el('g', { class: 'sm-nodes' });

    sorted.forEach((s) => {
      const pos = positions[s.id];
      if (!pos) return;
      const color = getColor(s);

      const g = el('g', {
        'data-sm-node': s.id,
        style: 'cursor: pointer; transition: opacity 0.3s ease;',
      });

      // Glow ring (hidden initially, visible when selected)
      const glow = el('rect', {
        x: `${pos.x - NODE_W / 2 - 3}`,
        y: `${pos.y - NODE_H / 2 - 3}`,
        width: `${NODE_W + 6}`,
        height: `${NODE_H + 6}`,
        rx: `${NODE_H / 2 + 3}`,
        ry: `${NODE_H / 2 + 3}`,
        fill: 'none',
        stroke: color,
        'stroke-width': '3',
        opacity: '0',
        'data-sm-glow': s.id,
      });
      glow.style.transition = 'opacity 0.3s ease';
      g.appendChild(glow);

      // Pill background
      const rect = el('rect', {
        x: `${pos.x - NODE_W / 2}`,
        y: `${pos.y - NODE_H / 2}`,
        width: `${NODE_W}`,
        height: `${NODE_H}`,
        rx: `${NODE_H / 2}`,
        ry: `${NODE_H / 2}`,
        fill: 'var(--sm-node-bg)',
        stroke: color,
        'stroke-width': '2',
      });
      g.appendChild(rect);

      // Label text
      const text = el('text', {
        x: `${pos.x}`,
        y: `${pos.y + 1}`,
        'text-anchor': 'middle',
        'dominant-baseline': 'central',
        'font-size': '13',
        'font-weight': '600',
        fill: color,
      });
      text.textContent = s.label;
      g.appendChild(text);

      // Initial state indicator (dot + short arrow)
      if (s.initial) {
        const dotX = pos.x - NODE_W / 2 - 18;
        const dotY = pos.y;
        g.appendChild(el('circle', {
          cx: `${dotX}`, cy: `${dotY}`, r: '4', fill: color,
        }));
        g.appendChild(el('line', {
          x1: `${dotX + 5}`, y1: `${dotY}`,
          x2: `${pos.x - NODE_W / 2 - 2}`, y2: `${dotY}`,
          stroke: color, 'stroke-width': '2',
        }));
      }

      g.addEventListener('click', () => selectState(s.id));
      nodeGroup.appendChild(g);
    });

    svg.appendChild(nodeGroup);

    // Selection logic
    const infoPanel = root.querySelector<HTMLElement>('.sm-info');
    const infoLabel = root.querySelector<HTMLElement>('.sm-info-label');
    const infoDot = root.querySelector<HTMLElement>('.sm-info-dot');
    const infoDesc = root.querySelector<HTMLElement>('.sm-info-desc');
    const infoCode = root.querySelector<HTMLElement>('.sm-info-code code');
    const infoClose = root.querySelector<HTMLElement>('.sm-info-close');

    let selectedId: string | null = null;

    function selectState(id: string) {
      if (selectedId === id) {
        deselectAll();
        return;
      }
      selectedId = id;
      const state = states.find(s => s.id === id);
      if (!state) return;
      const color = getColor(state);

      // Highlight selected, dim others
      svg!.querySelectorAll<SVGElement>('[data-sm-node]').forEach(n => {
        const nid = n.dataset.smNode;
        if (nid === id) {
          n.style.opacity = '1';
          const gl = n.querySelector<SVGElement>('[data-sm-glow]');
          if (gl) gl.setAttribute('opacity', '0.35');
        } else {
          n.style.opacity = '0.3';
          const gl = n.querySelector<SVGElement>('[data-sm-glow]');
          if (gl) gl.setAttribute('opacity', '0');
        }
      });

      // Highlight outbound edges
      svg!.querySelectorAll<SVGElement>('[data-sm-edge]').forEach(e => {
        if (e.dataset.smFrom === id) {
          e.setAttribute('stroke-opacity', '0.9');
          e.setAttribute('stroke-width', '3');
        } else {
          e.setAttribute('stroke-opacity', '0.15');
          e.setAttribute('stroke-width', '1.5');
        }
      });

      svg!.querySelectorAll<SVGElement>('[data-sm-edge-label]').forEach(e => {
        e.setAttribute('opacity', e.dataset.smFrom === id ? '0.9' : '0.15');
      });

      // Show info panel
      if (infoPanel && infoLabel && infoDot && infoDesc && infoCode) {
        infoPanel.style.display = '';
        infoPanel.style.borderColor = color;
        infoDot.style.background = color;
        infoLabel.textContent = state.label;
        infoDesc.textContent = state.description || '';
        infoCode.textContent = state.typeShape || '';
      }
    }

    function deselectAll() {
      selectedId = null;
      svg!.querySelectorAll<SVGElement>('[data-sm-node]').forEach(n => {
        n.style.opacity = '1';
        const gl = n.querySelector<SVGElement>('[data-sm-glow]');
        if (gl) gl.setAttribute('opacity', '0');
      });
      svg!.querySelectorAll<SVGElement>('[data-sm-edge]').forEach(e => {
        e.setAttribute('stroke-opacity', '0.5');
        e.setAttribute('stroke-width', '2');
      });
      svg!.querySelectorAll<SVGElement>('[data-sm-edge-label]').forEach(e => {
        e.setAttribute('opacity', '0.6');
      });
      if (infoPanel) infoPanel.style.display = 'none';
    }

    infoClose?.addEventListener('click', deselectAll);

    // Auto-select the initial state on load to invite exploration
    const initialState = states.find(s => s.initial);
    if (initialState) {
      selectState(initialState.id);
    }
  });
}
</script>
