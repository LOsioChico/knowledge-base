---
/**
 * StateMachineDiagram.astro — v2
 *
 * Interactive state machine diagram. Rebuilt from scratch.
 *
 * Layout: BFS-layered (states arranged in columns by graph distance
 * from the initial state). Multi-node layers are vertically centered.
 *
 * Arrows: forward edges use direct curves; backward edges arc above
 * or below to avoid overlap. Labels get background pills.
 *
 * SVG is fully pre-rendered at build time. JS handles click only.
 */

interface State {
  id: string;
  label: string;
  description?: string;
  typeShape?: string;
  color?: string;
  initial?: boolean;
}

interface Transition {
  from: string;
  to: string;
  label?: string;
}

interface Props {
  states: State[];
  transitions: Transition[];
  title?: string;
}

const { states, transitions, title } = Astro.props;

/* ═══ Colors ═══ */
const palette: Record<string, string> = {
  waiting: '#94a3b8', loading: '#60a5fa', success: '#4ade80', failure: '#f87171',
};
function clr(s: State): string {
  return s.color || palette[s.id.toLowerCase()] || '#a78bfa';
}

/* ═══ Adjacency ═══ */
const adj: Record<string, string[]> = {};
states.forEach(s => { adj[s.id] = []; });
transitions.forEach(t => { if (adj[t.from]) adj[t.from].push(t.to); });

/* ═══ BFS-layered layout ═══ */
const NODE_W = 148;
const NODE_H = 52;
const GAP_X = 80;
const GAP_Y = 68;
const PAD = 52;
const ARC_CLEARANCE = 44;
const NODE_RX = NODE_H / 2; // full pill shape

type Pos = { x: number; y: number };

const initial = states.find(s => s.initial) || states[0];
const layerOf: Record<string, number> = {};
const queue: string[] = [initial.id];
layerOf[initial.id] = 0;

while (queue.length > 0) {
  const cur = queue.shift()!;
  for (const next of adj[cur] || []) {
    if (!(next in layerOf)) {
      layerOf[next] = layerOf[cur] + 1;
      queue.push(next);
    }
  }
}
// Unreachable nodes go at the end
states.forEach(s => {
  if (!(s.id in layerOf)) layerOf[s.id] = Math.max(0, ...Object.values(layerOf)) + 1;
});

// Group by layer
const groups: Record<number, string[]> = {};
for (const [id, layer] of Object.entries(layerOf)) {
  (groups[layer] ??= []).push(id);
}

const numCols = Math.max(...Object.keys(groups).map(Number)) + 1;
const maxRows = Math.max(...Object.values(groups).map(g => g.length));
const contentH = maxRows * NODE_H + Math.max(0, maxRows - 1) * GAP_Y;

const pos: Record<string, Pos> = {};
for (const [layerStr, ids] of Object.entries(groups)) {
  const col = Number(layerStr);
  const layerH = ids.length * NODE_H + Math.max(0, ids.length - 1) * GAP_Y;
  const offsetY = (contentH - layerH) / 2;
  ids.forEach((id, row) => {
    pos[id] = {
      x: PAD + col * (NODE_W + GAP_X) + NODE_W / 2,
      y: PAD + offsetY + row * (NODE_H + GAP_Y) + NODE_H / 2,
    };
  });
}

/* ═══ Arrow paths ═══ */
const hw = NODE_W / 2;
const hh = NODE_H / 2;

/** Intersection of a ray from (cx,cy) toward (tx,ty) with the node rect. */
function edgeHit(cx: number, cy: number, tx: number, ty: number, pad: number): Pos {
  const dx = tx - cx;
  const dy = ty - cy;
  if (dx === 0 && dy === 0) return { x: cx + hw + pad, y: cy };
  const sx = (hw + pad) / Math.abs(dx);
  const sy = (hh + pad) / Math.abs(dy);
  const s = Math.min(sx, sy);
  return { x: cx + dx * s, y: cy + dy * s };
}

interface Arrow {
  d: string;
  lx: number;
  ly: number;
  label?: string;
  color: string;
  from: string;
  to: string;
}

// Track all Y control points to size the SVG correctly
let minY = PAD;
let maxY = PAD + contentH;

const arrows: Arrow[] = transitions.map(t => {
  const fp = pos[t.from];
  const tp = pos[t.to];
  if (!fp || !tp) return null!;

  const fromL = layerOf[t.from];
  const toL = layerOf[t.to];
  const isBackward = fromL > toL;
  const color = clr(states.find(s => s.id === t.from)!);

  let d: string;
  let lx: number, ly: number;

  if (isBackward) {
    /* ── Backward arrow: arc above or below ── */
    const midCenter = (PAD + contentH / 2);
    const pairMidY = (fp.y + tp.y) / 2;
    const goAbove = pairMidY <= midCenter;

    const srcY = goAbove ? fp.y - hh - 3 : fp.y + hh + 3;
    const tgtY = goAbove ? tp.y - hh - 3 : tp.y + hh + 3;
    const arcY = goAbove
      ? Math.min(srcY, tgtY) - ARC_CLEARANCE
      : Math.max(srcY, tgtY) + ARC_CLEARANCE;

    const midX = (fp.x + tp.x) / 2;
    d = `M ${fp.x} ${srcY} Q ${midX} ${arcY} ${tp.x} ${tgtY}`;

    // Parametric midpoint of quadratic bezier
    lx = 0.25 * fp.x + 0.5 * midX + 0.25 * tp.x;
    ly = 0.25 * srcY + 0.5 * arcY + 0.25 * tgtY + (goAbove ? -8 : 12);

    // Extend SVG bounds
    if (arcY < minY) minY = arcY;
    if (arcY > maxY) maxY = arcY;
  } else {
    /* ── Forward / same-layer arrow: direct curve ── */
    const sp = edgeHit(fp.x, fp.y, tp.x, tp.y, 4);
    const ep = edgeHit(tp.x, tp.y, fp.x, fp.y, 8);

    const dx = ep.x - sp.x;
    const dy = ep.y - sp.y;
    const dist = Math.sqrt(dx * dx + dy * dy) || 1;
    // Gentle perpendicular curve
    const perpX = -dy / dist * 10;
    const perpY =  dx / dist * 10;
    const cx = (sp.x + ep.x) / 2 + perpX;
    const cy = (sp.y + ep.y) / 2 + perpY;

    d = `M ${sp.x} ${sp.y} Q ${cx} ${cy} ${ep.x} ${ep.y}`;
    lx = 0.25 * sp.x + 0.5 * cx + 0.25 * ep.x;
    ly = 0.25 * sp.y + 0.5 * cy + 0.25 * ep.y - 8;
  }

  return { d, lx, ly, label: t.label, color, from: t.from, to: t.to };
}).filter(Boolean);

const svgW = PAD * 2 + numCols * NODE_W + Math.max(0, numCols - 1) * GAP_X;
const svgH = (maxY - minY) + PAD * 2;
const yShift = minY < PAD ? PAD - minY : 0; // shift everything down if arcs go above PAD

/* ═══ Outgoing transitions per state (for info panel) ═══ */
const outgoing: Record<string, { target: string; trigger: string }[]> = {};
states.forEach(s => {
  outgoing[s.id] = transitions
    .filter(t => t.from === s.id)
    .map(t => ({
      target: states.find(st => st.id === t.to)?.label || t.to,
      trigger: t.label || '',
    }));
});

/* ═══ Unique marker IDs ═══ */
const uid = Math.random().toString(36).slice(2, 8);
---

<div class="smd not-content">
  {title && (
    <div class="smd-header">
      <span class="smd-title">{title}</span>
      <span class="smd-hint">Click a state to inspect its type shape and transitions.</span>
    </div>
  )}

  <div class="smd-canvas">
    <svg
      class="smd-svg"
      viewBox={`0 0 ${svgW} ${svgH}`}
      width={Math.min(svgW, 700)}
      aria-label="State machine diagram"
    >
      <defs>
        {arrows.map(a => (
          <marker
            id={`ah-${uid}-${a.from}-${a.to}`}
            viewBox="0 0 10 7"
            refX="9" refY="3.5"
            markerWidth="9" markerHeight="7"
            orient="auto-start-reverse"
          >
            <polygon points="0 0, 10 3.5, 0 7" fill={a.color} opacity="0.9" />
          </marker>
        ))}
        {/* Initial-state entry arrow marker */}
        {states.filter(s => s.initial).map(s => (
          <marker
            id={`ah-${uid}-${s.id}-${s.id}`}
            viewBox="0 0 10 7"
            refX="9" refY="3.5"
            markerWidth="8" markerHeight="6"
            orient="auto-start-reverse"
          >
            <polygon points="0 0, 10 3.5, 0 7" fill={clr(s)} opacity="0.7" />
          </marker>
        ))}
      </defs>

      {/* ── Arrow paths ── */}
      <g class="smd-arrows" transform={`translate(0 ${yShift})`}>
        {arrows.map(a => (
          <g data-smd-arrow={`${a.from}-${a.to}`} data-smd-src={a.from}>
            <path
              d={a.d}
              stroke={a.color}
              stroke-width="2"
              stroke-opacity="0.5"
              fill="none"
              marker-end={`url(#ah-${uid}-${a.from}-${a.to})`}
              class="smd-edge"
            />
            {a.label && (
              <g>
                <rect
                  x={a.lx - a.label.length * 3.4 - 6}
                  y={a.ly - 9}
                  width={a.label.length * 6.8 + 12}
                  height={18}
                  rx="9"
                  fill="var(--smd-bg)"
                  fill-opacity="0.92"
                  stroke={a.color}
                  stroke-width="0.75"
                  stroke-opacity="0.35"
                />
                <text
                  x={a.lx}
                  y={a.ly + 3.5}
                  text-anchor="middle"
                  font-size="10.5"
                  font-family="var(--sl-font-mono, monospace)"
                  font-weight="500"
                  fill={a.color}
                  opacity="0.9"
                  class="smd-edge-label"
                >
                  {a.label}
                </text>
              </g>
            )}
          </g>
        ))}
      </g>

      {/* ── State nodes ── */}
      <g class="smd-nodes" transform={`translate(0 ${yShift})`}>
        {states.map(s => {
          const p = pos[s.id];
          const c = clr(s);
          const outs = outgoing[s.id].map(o => `${o.trigger}>${o.target}`).join('|');
          return (
            <g
              data-smd-node={s.id}
              data-smd-color={c}
              data-smd-desc={s.description || ''}
              data-smd-type={s.typeShape || ''}
              data-smd-outs={outs}
              class="smd-node"
              tabindex="0"
              role="button"
              aria-label={`State: ${s.label}`}
            >
              {/* Invisible hit area — ensures clicks work anywhere inside the pill */}
              <rect
                x={p.x - hw} y={p.y - hh}
                width={NODE_W} height={NODE_H}
                rx={NODE_RX}
                fill="transparent"
                class="smd-hitarea"
              />
              {/* Glow ring (shown on select) */}
              <rect
                x={p.x - hw - 5} y={p.y - hh - 5}
                width={NODE_W + 10} height={NODE_H + 10}
                rx={NODE_RX + 5}
                fill="none" stroke={c} stroke-width="2.5" opacity="0"
                class="smd-glow"
              />
              {/* Tinted fill (color-coded background) */}
              <rect
                x={p.x - hw} y={p.y - hh}
                width={NODE_W} height={NODE_H}
                rx={NODE_RX}
                fill={c}
                fill-opacity="0.08"
                stroke={c}
                stroke-width="1.5"
                stroke-opacity="0.45"
                class="smd-body"
              />
              {/* Label */}
              <text
                x={p.x} y={p.y + 1}
                text-anchor="middle"
                dominant-baseline="central"
                font-size="13.5" font-weight="600"
                fill={c}
                class="smd-label"
              >
                {s.label}
              </text>
              {/* Initial indicator: arrow from void */}
              {s.initial && (
                <g class="smd-initial">
                  <circle cx={p.x - hw - 20} cy={p.y} r="5" fill={c} opacity="0.7" />
                  <line
                    x1={p.x - hw - 14} y1={p.y}
                    x2={p.x - hw - 2}  y2={p.y}
                    stroke={c} stroke-width="2" stroke-opacity="0.7"
                    marker-end={`url(#ah-${uid}-${s.id}-${s.id})`}
                  />
                </g>
              )}
            </g>
          );
        })}
      </g>
    </svg>
  </div>

  {/* ── Info panel ── */}
  <div class="smd-info" data-smd-info style="display:none">
    <div class="smd-info-bar"></div>
    <div class="smd-info-body">
      <div class="smd-info-head">
        <div class="smd-info-dot"></div>
        <div class="smd-info-name"></div>
        <button class="smd-info-close" type="button" aria-label="Close" data-smd-close>✕</button>
      </div>
      <div class="smd-info-desc"></div>
      <div class="smd-info-trans"></div>
      <pre class="smd-info-code"><code></code></pre>
    </div>
  </div>
</div>

<style>
  /* ═══ Container ═══ */
  .smd {
    --smd-bg:      var(--sl-color-bg-nav);
    --smd-surface: var(--sl-color-bg-sidebar);
    --smd-rule:    var(--sl-color-hairline-shade);
    --smd-text:    var(--sl-color-text);
    --smd-dim:     var(--sl-color-gray-3);
    --smd-ghost:   var(--sl-color-gray-4);
    --smd-accent:  var(--sl-color-accent-high);
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    margin: 1.5rem 0;
    background: var(--smd-bg);
    border: 1px solid var(--smd-rule);
    border-radius: 10px;
    overflow: hidden;
  }

  /* ── Header ── */
  .smd-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--smd-rule);
  }

  .smd-title {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--smd-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .smd-hint {
    font-size: var(--sl-text-xs);
    color: var(--smd-ghost);
  }

  /* ── SVG canvas ── */
  .smd-canvas {
    padding: 0.75rem 0.5rem 0.25rem;
    overflow-x: auto;
    display: flex;
    justify-content: center;
  }

  .smd-svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  /* ═══ Nodes ═══ */
  .smd-node {
    cursor: pointer;
    outline: none;
  }

  .smd-body {
    transition: fill-opacity 200ms var(--ease), stroke-opacity 200ms var(--ease), filter 200ms var(--ease);
  }

  .smd-label {
    transition: opacity 200ms var(--ease);
  }

  .smd-glow {
    transition: opacity 250ms var(--ease);
  }

  .smd-node:hover .smd-body {
    fill-opacity: 0.14;
    stroke-opacity: 0.7;
    filter: brightness(1.1);
  }

  .smd-node:focus-visible .smd-glow {
    opacity: 0.2 !important;
  }

  /* JS-applied states */
  .smd-node[data-state="selected"] .smd-glow { opacity: 0.3; }
  .smd-node[data-state="selected"] .smd-body { fill-opacity: 0.16; stroke-opacity: 0.8; filter: brightness(1.15); }
  .smd-node[data-state="selected"] .smd-label { opacity: 1; }
  .smd-node[data-state="dimmed"]   { opacity: 0.18; pointer-events: none; }
  .smd-node[data-state="target"] .smd-body {
    stroke-dasharray: 5 3;
    fill-opacity: 0.12;
    stroke-opacity: 0.6;
  }

  /* ═══ Arrows ═══ */
  .smd-edge {
    transition: stroke-opacity 250ms var(--ease), stroke-width 250ms var(--ease);
  }

  .smd-edge-label {
    transition: opacity 250ms var(--ease);
  }

  [data-smd-arrow][data-arrow-state="highlight"] .smd-edge {
    stroke-opacity: 0.9;
    stroke-width: 2.5;
    stroke-dasharray: 6 4;
    animation: smd-flow 0.6s linear infinite;
  }

  [data-smd-arrow][data-arrow-state="highlight"] .smd-edge-label {
    opacity: 1;
    font-weight: 600;
  }

  [data-smd-arrow][data-arrow-state="dimmed"] .smd-edge {
    stroke-opacity: 0.06;
  }

  [data-smd-arrow][data-arrow-state="dimmed"] .smd-edge-label {
    opacity: 0.06;
  }

  [data-smd-arrow][data-arrow-state="dimmed"] rect {
    opacity: 0.06;
  }

  @keyframes smd-flow {
    to { stroke-dashoffset: -10; }
  }

  /* ═══ Info panel ═══ */
  .smd-info {
    margin: 0 12px 12px;
    border: 1px solid var(--smd-rule);
    border-radius: 8px;
    background: var(--smd-surface);
    overflow: hidden;
    animation: smd-slide 0.2s ease-out;
  }

  @keyframes smd-slide {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .smd-info-bar {
    height: 3px;
    border-radius: 3px 3px 0 0;
  }

  .smd-info-body { padding: 0; }

  .smd-info-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
  }

  .smd-info-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .smd-info-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--smd-text);
    flex: 1;
  }

  .smd-info-close {
    background: none;
    border: none;
    color: var(--smd-ghost);
    cursor: pointer;
    font-size: 1rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    transition: all 0.15s ease;
    line-height: 1;
  }

  .smd-info-close:hover {
    color: var(--smd-text);
    background: var(--smd-bg);
  }

  .smd-info-desc {
    padding: 0 1rem 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--smd-dim);
    line-height: 1.5;
  }

  .smd-info-desc:empty { display: none; }

  .smd-info-trans {
    padding: 0 1rem 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .smd-info-trans:empty { display: none; }

  .smd-info-trans .smd-t {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--smd-bg) 70%, transparent);
    color: var(--smd-dim);
    font-size: 0.75rem;
  }

  .smd-info-trans .smd-t code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.72rem;
    color: var(--smd-accent);
  }

  .smd-info-code {
    margin: 0;
    padding: 0.55rem 1rem;
    background: color-mix(in srgb, var(--smd-bg) 60%, #000);
    border-top: 1px solid var(--smd-rule);
    overflow-x: auto;
  }

  .smd-info-code code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.8rem;
    color: var(--smd-accent);
    line-height: 1.6;
    white-space: pre;
  }

  .smd-info-code:has(code:empty) { display: none; }

  /* ═══ Reduced motion / Print ═══ */
  @media (prefers-reduced-motion: reduce) {
    .smd-edge, .smd-body, .smd-glow { transition-duration: 0.01ms !important; }
  }

  @media print {
    .smd-info-close { display: none; }
    .smd-node { opacity: 1 !important; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', initSMD);
  // Fallback: init immediately if page already loaded
  if (document.readyState !== 'loading') initSMD();

  function initSMD() {
    document.querySelectorAll<HTMLElement>('.smd:not([data-smd-ready])').forEach(root => {
      root.setAttribute('data-smd-ready', '');

      const nodeGs  = root.querySelectorAll<SVGGElement>('[data-smd-node]');
      const arrowGs = root.querySelectorAll<SVGGElement>('[data-smd-arrow]');
      const info      = root.querySelector<HTMLElement>('[data-smd-info]');
      const infoBar   = info?.querySelector<HTMLElement>('.smd-info-bar');
      const infoName  = info?.querySelector<HTMLElement>('.smd-info-name');
      const infoDot   = info?.querySelector<HTMLElement>('.smd-info-dot');
      const infoDesc  = info?.querySelector<HTMLElement>('.smd-info-desc');
      const infoTrans = info?.querySelector<HTMLElement>('.smd-info-trans');
      const infoCodeEl = info?.querySelector<HTMLElement>('.smd-info-code code');
      const closeBtn  = root.querySelector<HTMLElement>('[data-smd-close]');

      if (!info) return;

      let selectedId: string | null = null;

      function select(id: string) {
        if (selectedId === id) { deselect(); return; }
        selectedId = id;

        const g = root.querySelector<SVGGElement>(`[data-smd-node="${id}"]`);
        if (!g) return;

        const color     = g.dataset.smdColor || '#94a3b8';
        const desc      = g.dataset.smdDesc || '';
        const typeShape = g.dataset.smdType || '';
        const outsRaw   = g.dataset.smdOuts || '';
        const outs = outsRaw ? outsRaw.split('|').map(o => {
          const [trigger, target] = o.split('>');
          return { trigger, target };
        }) : [];

        const outTargetIds = outs.map(o =>
          Array.from(nodeGs).find(n => {
            const label = n.querySelector('.smd-label')?.textContent?.trim();
            return label === o.target;
          })?.dataset.smdNode || ''
        ).filter(Boolean);

        // Node states
        nodeGs.forEach(n => {
          const nid = n.dataset.smdNode || '';
          if (nid === id) n.setAttribute('data-state', 'selected');
          else if (outTargetIds.includes(nid)) n.setAttribute('data-state', 'target');
          else n.setAttribute('data-state', 'dimmed');
        });

        // Arrow states
        arrowGs.forEach(a => {
          if (a.dataset.smdSrc === id) a.setAttribute('data-arrow-state', 'highlight');
          else a.setAttribute('data-arrow-state', 'dimmed');
        });

        // Show info panel (each element is optional — show what we can)
        info!.style.display = '';
        if (infoBar)    infoBar.style.background = color;
        if (infoDot)    infoDot.style.background = color;
        if (infoName)   infoName.textContent = g.querySelector('.smd-label')?.textContent?.trim() || '';
        if (infoDesc)   infoDesc.textContent = desc;
        if (infoCodeEl) infoCodeEl.textContent = typeShape;
        if (infoTrans) {
          infoTrans.innerHTML = outs.map(o =>
            `<span class="smd-t">${o.trigger ? `<code>${o.trigger}</code> →` : '→'} ${o.target}</span>`
          ).join('');
        }
      }

      function deselect() {
        selectedId = null;
        nodeGs.forEach(n => n.removeAttribute('data-state'));
        arrowGs.forEach(a => a.removeAttribute('data-arrow-state'));
        info!.style.display = 'none';
      }

      nodeGs.forEach(n => {
        n.addEventListener('click', (e: Event) => {
          e.stopPropagation();
          select(n.dataset.smdNode || '');
        });
        n.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            select(n.dataset.smdNode || '');
          }
        });
      });
      closeBtn?.addEventListener('click', deselect);

      // Auto-select initial state on load
      const initialNode = root.querySelector<SVGGElement>('.smd-initial')?.closest<SVGGElement>('[data-smd-node]');
      if (initialNode) select(initialNode.dataset.smdNode || '');
    });
  }
</script>
