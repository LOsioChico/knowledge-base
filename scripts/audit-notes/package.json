{
  "name": "audit-notes",
  "private": true,
  "type": "module",
  "description": "Cursor SDK audit pipeline for vault notes against AGENTS.md.",
  "scripts": {
    "start": "tsx audit-notes.ts",
    "audit:ci": "tsx audit-notes.ts --profile=ci",
    "audit:triage": "tsx audit-notes.ts --profile=triage",
    "audit:mdx-ci": "tsx pass0-mdx-all.ts",
    "audit:mdx-triage": "tsx mdx-audit-notes.ts --profile=mdx-triage",
    "audit:mdx-full": "tsx mdx-audit-notes.ts --profile=mdx-full",
    "mdx:start": "tsx mdx-audit-notes.ts",
    "autofix": "tsx autofix.ts",
    "autofix:mdx": "tsx autofix.ts --mdx",
    "lint:mdx-content": "tsx pass0-mdx-all.ts",
    "cache:clean": "tsx cache-clean.ts",
    "lint:content": "tsx pass0-all.ts",
    "lint:format": "prettier --check ../../content",
    "format": "prettier --write ../../content",
    "test": "node --import tsx --test extract-json.test.ts deterministic.test.ts mdx-deterministic.test.ts dismissed.test.ts show-dont-tell.test.ts skip-zones.test.ts corpus-silent.test.ts",
    "test:dismissed": "node --import tsx --test dismissed.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
